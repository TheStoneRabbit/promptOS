#!/usr/bin/env python3
"""
promptos-install — installer for promptOS.
Partitions the selected disk, installs Arch + promptOS, sets up bootloader.
Run from the live environment: type 'install promptOS' at the promptOS> prompt,
or run directly: promptos-install
"""

import os
import sys
import subprocess
import json
import shutil
import time
import getpass

sys.path.insert(0, "/usr/local/lib/promptos")

_BARE_TTY = os.environ.get("TERM") == "linux"

try:
    if _BARE_TTY:
        raise ImportError("skip rich on bare TTY")
    from rich.console import Console
    from rich.panel import Panel
    from rich.prompt import Prompt, Confirm
    from rich import box
    console = Console()
    RICH = True
except ImportError:
    RICH = False
    console = None

MOUNTPOINT = "/mnt"


def print_step(title: str, body: str = ""):
    if RICH:
        console.print(Panel(body, title=f"[bold cyan]{title}[/bold cyan]", border_style="cyan", box=box.ROUNDED))
    else:
        print(f"\n=== {title} ===")
        if body:
            print(body)


def ask(prompt: str, default: str = "") -> str:
    if RICH:
        return Prompt.ask(f"[bold green]{prompt}[/bold green]", default=default)
    return input(f"{prompt} [{default}]: ").strip() or default


def confirm(prompt: str, default: bool = True) -> bool:
    if RICH:
        return Confirm.ask(f"[bold yellow]{prompt}[/bold yellow]", default=default)
    ans = input(f"{prompt} [{'Y/n' if default else 'y/N'}]: ").strip().lower()
    if not ans:
        return default
    return ans in ("y", "yes")


def prompt_password(label: str = "Root password") -> str:
    """Prompt for a password twice and require they match. Loops until valid."""
    while True:
        try:
            p1 = getpass.getpass(f"{label}: ")
        except (EOFError, KeyboardInterrupt):
            print()
            raise SystemExit(1)
        if not p1:
            print("Password cannot be empty.")
            continue
        if len(p1) < 4:
            print("Password too short (minimum 4 characters).")
            continue
        try:
            p2 = getpass.getpass(f"{label} (confirm): ")
        except (EOFError, KeyboardInterrupt):
            print()
            raise SystemExit(1)
        if p1 != p2:
            print("Passwords do not match. Try again.")
            continue
        return p1


def run(cmd: str, check: bool = True, ok_codes: tuple[int, ...] = (0,)) -> int:
    if RICH:
        console.print(f"[dim]$ {cmd}[/dim]")
    else:
        print(f"$ {cmd}")
    result = subprocess.run(cmd, shell=True)
    if check and result.returncode not in ok_codes:
        if RICH:
            console.print(f"[red]Command failed (exit {result.returncode})[/red]")
        else:
            print(f"Error: command failed (exit {result.returncode})")
        raise SystemExit(1)
    return result.returncode


def is_online() -> bool:
    """Quick connectivity check using NetworkManager if available, then a direct probe."""
    try:
        if subprocess.run(
            ["nm-online", "-q", "--timeout=2"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode == 0:
            return True
    except FileNotFoundError:
        pass
    try:
        return subprocess.run(
            ["curl", "-sf", "--max-time", "3", "http://detectportal.firefox.com/success.txt"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode == 0
    except FileNotFoundError:
        return False


def get_disks() -> list[dict]:
    try:
        out = subprocess.check_output(
            ["lsblk", "-J", "-o", "NAME,SIZE,TYPE,MODEL,MOUNTPOINT"],
            text=True
        )
        data = json.loads(out)
        disks = []
        for dev in data.get("blockdevices", []):
            if dev.get("type") == "disk":
                disks.append({
                    "name": f"/dev/{dev['name']}",
                    "size": dev.get("size", "?"),
                    "model": dev.get("model", "Unknown"),
                })
        return disks
    except Exception:
        return []


def part_names(disk: str) -> tuple[str, str]:
    """Return (efi_partition, root_partition) names for a given disk."""
    if disk.startswith("/dev/nvme") or disk.startswith("/dev/mmcblk"):
        return f"{disk}p1", f"{disk}p2"
    return f"{disk}1", f"{disk}2"


def partition_disk(disk: str):
    """Wipe and partition: 512MiB EFI + rest as root."""
    run(f"parted -s {disk} mklabel gpt")
    run(f"parted -s {disk} mkpart ESP fat32 1MiB 513MiB")
    run(f"parted -s {disk} set 1 esp on")
    run(f"parted -s {disk} mkpart primary ext4 513MiB 100%")
    # Let kernel re-read partition table
    subprocess.run(f"partprobe {disk}", shell=True)
    time.sleep(1)


def format_partitions(disk: str) -> tuple[str, str]:
    """Format partitions and return (efi, root)."""
    efi, root = part_names(disk)
    run(f"mkfs.fat -F32 -n EFI {efi}")
    run(f"mkfs.ext4 -F -L promptOS {root}")
    return efi, root


def mount_partitions(efi: str, root: str):
    run(f"mount {root} {MOUNTPOINT}")
    run(f"mkdir -p {MOUNTPOINT}/boot")
    run(f"mount {efi} {MOUNTPOINT}/boot")


def install_base():
    """Copy the live filesystem to the target instead of downloading packages."""
    # Stop ollama before rsync — otherwise model files in /var/lib/ollama/models/blobs
    # can be mid-mmap and copy as truncated, causing 500 errors on the installed system.
    run("systemctl stop ollama ollama-warmup", check=False)
    # Wait briefly for the daemon to release file handles.
    time.sleep(1)

    # rsync the live root to the mountpoint, excluding virtual/temp filesystems
    excludes = [
        "/dev/*", "/proc/*", "/sys/*", "/tmp/*", "/run/*",
        "/mnt/*", "/media/*", "/lost+found",
        "/var/cache/pacman/pkg/*",
    ]
    # Also exclude /boot — on the live ISO it's a mount point for the ISO boot area,
    # not the kernel installed by pacstrap. We reinstall the kernel in the chroot instead.
    excludes.append("/boot/*")
    exclude_args = " ".join(f'--exclude="{e}"' for e in excludes)
    # rsync exit 24 = "some source files vanished" (e.g. log rotation during copy) — benign.
    # exit 23 = "some files not transferred" (often perms on /run sockets) — also non-fatal here.
    run(
        f"rsync -aAX --info=progress2 --no-inc-recursive {exclude_args} / {MOUNTPOINT}/",
        ok_codes=(0, 23, 24),
    )

    # Verify wifi connections were carried over (NetworkManager will auto-connect on boot).
    nm_dir = f"{MOUNTPOINT}/etc/NetworkManager/system-connections"
    if os.path.isdir(nm_dir):
        wifi_count = sum(1 for f in os.listdir(nm_dir) if f.endswith(".nmconnection"))
        if wifi_count:
            msg = f"  {wifi_count} saved network(s) carried over to the installed system."
            if RICH:
                console.print(f"[green]{msg}[/green]")
            else:
                print(msg)

    # Ensure excluded dirs exist as empty mountpoints
    for d in ["dev", "proc", "sys", "tmp", "run", "mnt", "media"]:
        os.makedirs(f"{MOUNTPOINT}/{d}", mode=0o755, exist_ok=True)

    # Set up live mirrors on the installed system for future package updates
    live_mirrors = (
        "Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n"
        "Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch\n"
        "Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch\n"
        "Server = https://mirrors.mit.edu/archlinux/$repo/os/$arch\n"
    )
    os.makedirs(f"{MOUNTPOINT}/etc/pacman.d", exist_ok=True)
    with open(f"{MOUNTPOINT}/etc/pacman.d/mirrorlist", "w") as f:
        f.write(live_mirrors)

    # Initialize pacman keyring on the installed system
    run(f"arch-chroot {MOUNTPOINT} pacman-key --init")
    run(f"arch-chroot {MOUNTPOINT} pacman-key --populate archlinux")

    # /boot on the live ISO is overlaid by the ISO boot partition, so rsync misses the kernel.
    # Stage /boot/vmlinuz-linux on the target before mkinitcpio runs in setup_system(),
    # otherwise mkinitcpio errors with "'/boot/vmlinuz-linux' must be readable".
    import glob
    kernel_dst = f"{MOUNTPOINT}/boot/vmlinuz-linux"

    # Priority: archiso bootmnt is the actual booted kernel and is always present
    # on a live system, so check it first.
    search_paths = [
        "/run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux",
        "/run/archiso/airootfs/boot/vmlinuz-linux",
        "/boot/vmlinuz-linux",
        "/boot/vmlinuz",
    ]
    # Plus any kernel that landed in the rsync'd modules dir (modern Arch location)
    search_paths.extend(sorted(glob.glob(f"{MOUNTPOINT}/usr/lib/modules/*/vmlinuz")))

    kernel_src = next((p for p in search_paths if os.path.isfile(p)), None)
    if kernel_src:
        run(f"cp {kernel_src} {kernel_dst}")
        print(f"  Kernel copied from {kernel_src}")
    else:
        print("  ERROR: Could not find a kernel image. Searched:")
        for p in search_paths:
            print(f"    {p}")
        run(f"ls -la {MOUNTPOINT}/usr/lib/modules/ 2>/dev/null", check=False)
        run("ls -la /run/archiso/bootmnt/arch/boot/x86_64/ 2>/dev/null", check=False)
        raise SystemExit(1)


def set_user_password(user: str, password: str):
    """Set a user's password inside the chroot. Uses stdin to avoid shell-quoting."""
    proc = subprocess.run(
        ["arch-chroot", MOUNTPOINT, "chpasswd"],
        input=f"{user}:{password}\n",
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        if RICH:
            console.print(f"[red]chpasswd failed for {user}: {proc.stderr.strip()}[/red]")
        else:
            print(f"chpasswd failed for {user}: {proc.stderr.strip()}")
        raise SystemExit(1)


def create_admin_user(username: str, password: str):
    """Create an admin user in the wheel group. Login shell is bash so that
    graphical session managers (GDM/SDDM) can bootstrap the session correctly;
    /etc/bash.bashrc auto-execs promptsh for interactive terminal sessions."""
    # Create the user. `-m` creates /home/<user> from /etc/skel.
    # `check=False` so a re-run doesn't abort when the user already exists.
    run(
        f"arch-chroot {MOUNTPOINT} useradd -m -G wheel -s /bin/bash {username}",
        check=False,
    )
    set_user_password(username, password)

    # Defensive: if useradd skipped home creation (e.g. user existed from a
    # previous run with -M, or some other edge case), make sure it exists with
    # the right ownership and perms, populated from /etc/skel.
    home_dir = f"{MOUNTPOINT}/home/{username}"
    if not os.path.isdir(home_dir):
        os.makedirs(home_dir, exist_ok=True)
        # Copy /etc/skel contents (cp -aT to merge into the existing dir).
        run(f"arch-chroot {MOUNTPOINT} cp -aT /etc/skel /home/{username}", check=False)
    run(f"arch-chroot {MOUNTPOINT} chown -R {username}:{username} /home/{username}", check=False)
    run(f"arch-chroot {MOUNTPOINT} chmod 700 /home/{username}", check=False)

    # Verify the home directory ended up where we expect.
    if not os.path.isdir(home_dir):
        if RICH:
            console.print(f"[red]ERROR: /home/{username} was not created.[/red]")
        else:
            print(f"ERROR: /home/{username} was not created.")
        raise SystemExit(1)

    # Enable wheel-group sudo (Arch ships sudoers with this commented out).
    sudoers_drop_in = f"{MOUNTPOINT}/etc/sudoers.d/10-wheel"
    os.makedirs(os.path.dirname(sudoers_drop_in), exist_ok=True)
    with open(sudoers_drop_in, "w") as f:
        f.write("%wheel ALL=(ALL:ALL) ALL\n")
    os.chmod(sudoers_drop_in, 0o440)

    # PAM/GDM exclude root from GUI sessions, so the admin user is also the
    # account to use for any future graphical desktop installs.


def setup_system(hostname: str, timezone: str, locale: str,
                 root_password: str,
                 admin_user: str | None = None, admin_password: str | None = None):
    # fstab
    run(f"genfstab -U {MOUNTPOINT} >> {MOUNTPOINT}/etc/fstab")

    # Timezone
    run(f"arch-chroot {MOUNTPOINT} ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime")
    run(f"arch-chroot {MOUNTPOINT} hwclock --systohc", check=False)

    # Locale
    locale_gen = f"{MOUNTPOINT}/etc/locale.gen"
    with open(locale_gen, "a") as f:
        f.write(f"{locale} UTF-8\n")
    run(f"arch-chroot {MOUNTPOINT} locale-gen")
    with open(f"{MOUNTPOINT}/etc/locale.conf", "w") as f:
        f.write(f"LANG={locale}\n")

    # Hostname
    with open(f"{MOUNTPOINT}/etc/hostname", "w") as f:
        f.write(f"{hostname}\n")

    # Hosts
    with open(f"{MOUNTPOINT}/etc/hosts", "w") as f:
        f.write(f"127.0.0.1  localhost\n::1        localhost\n127.0.1.1  {hostname}\n")

    # Enable services
    run(f"arch-chroot {MOUNTPOINT} systemctl enable NetworkManager sshd", check=False)
    run(f"arch-chroot {MOUNTPOINT} systemctl enable ollama ollama-warmup", check=False)

    # Replace the live ISO's mkinitcpio.conf with a standard one for installed systems
    # The live ISO uses archiso hooks which look for the ISO label — that doesn't exist on disk
    # Skip autodetect so the initramfs includes all modules (works on any hardware)
    with open(f"{MOUNTPOINT}/etc/mkinitcpio.conf", "w") as f:
        f.write(
            "# mkinitcpio.conf for installed promptOS\n"
            "MODULES=()\n"
            "BINARIES=()\n"
            "FILES=()\n"
            "HOOKS=(base udev modconf block filesystems keyboard fsck)\n"
        )
    run(f"arch-chroot {MOUNTPOINT} mkinitcpio -P", check=False)

    # Verify the initramfs actually got built — without it, the installed system won't boot.
    initramfs = f"{MOUNTPOINT}/boot/initramfs-linux.img"
    if not os.path.isfile(initramfs):
        if RICH:
            console.print(f"[red]ERROR: mkinitcpio did not produce {initramfs}.[/red]")
        else:
            print(f"ERROR: mkinitcpio did not produce {initramfs}.")
        run(f"ls -la {MOUNTPOINT}/boot/", check=False)
        run(f"ls -la {MOUNTPOINT}/etc/mkinitcpio.d/", check=False)
        raise SystemExit(1)

    # Keep root's login shell as bash so it works for GUI session managers
    # too. /etc/bash.bashrc auto-execs promptsh for interactive shells, so
    # TTY/SSH still drop you into promptsh.
    run(f"arch-chroot {MOUNTPOINT} chsh -s /bin/bash root", check=False)

    # Set root password (overrides the live ISO's empty-password shadow entry)
    set_user_password("root", root_password)

    # Optional admin user (recommended — required for any GUI/desktop session
    # since GDM/SDDM block root login).
    if admin_user and admin_password:
        create_admin_user(admin_user, admin_password)


def install_bootloader():
    run(f"arch-chroot {MOUNTPOINT} bootctl install")

    # loader.conf
    with open(f"{MOUNTPOINT}/boot/loader/loader.conf", "w") as f:
        f.write("default promptos.conf\ntimeout 3\nconsole-mode max\neditor no\n")

    # Get root partition UUID
    root_part = subprocess.check_output(
        f"findmnt -no UUID {MOUNTPOINT}",
        shell=True, text=True
    ).strip()

    with open(f"{MOUNTPOINT}/boot/loader/entries/promptos.conf", "w") as f:
        f.write(
            "title   promptOS\n"
            "linux   /vmlinuz-linux\n"
            "initrd  /initramfs-linux.img\n"
            f"options root=UUID={root_part} rw quiet\n"
        )


def install_promptos():
    """Copy promptOS files into the installed system."""
    copies = [
        ("/usr/local/bin/promptsh",       f"{MOUNTPOINT}/usr/local/bin/promptsh"),
        ("/usr/local/bin/promptos-keys",  f"{MOUNTPOINT}/usr/local/bin/promptos-keys"),
        ("/usr/local/bin/promptos-install", f"{MOUNTPOINT}/usr/local/bin/promptos-install"),
        ("/usr/local/lib/promptos",        f"{MOUNTPOINT}/usr/local/lib/promptos"),
        ("/etc/promptos",                  f"{MOUNTPOINT}/etc/promptos"),
    ]
    for src, dst in copies:
        if os.path.exists(src):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            run(f"cp -a {src} {dst}", check=False)

    # Make scripts executable
    for script in ["promptsh", "promptos-keys", "promptos-install"]:
        path = f"{MOUNTPOINT}/usr/local/bin/{script}"
        if os.path.exists(path):
            os.chmod(path, 0o755)

    # Set promptsh as root's login shell
    run(f"arch-chroot {MOUNTPOINT} chsh -s /usr/local/bin/promptsh root", check=False)

    # Also launch promptsh from bash for any interactive session
    bashrc = (
        "# promptOS — launch promptsh for any interactive shell session\n"
        "if [[ $- == *i* ]] && [[ -z \"$PROMPTSH_ACTIVE\" ]] && [[ -x /usr/local/bin/promptsh ]]; then\n"
        "    export PROMPTSH_ACTIVE=1\n"
        "    exec /usr/local/bin/promptsh\n"
        "fi\n"
    )
    with open(f"{MOUNTPOINT}/etc/bash.bashrc", "w") as f:
        f.write(bashrc)

    # Copy Ollama binary and models
    if os.path.exists("/usr/local/bin/ollama"):
        run(f"cp /usr/local/bin/ollama {MOUNTPOINT}/usr/local/bin/ollama", check=False)
        os.chmod(f"{MOUNTPOINT}/usr/local/bin/ollama", 0o755)

    if os.path.exists("/var/lib/ollama"):
        run(f"mkdir -p {MOUNTPOINT}/var/lib/ollama")
        run(f"cp -a /var/lib/ollama/models {MOUNTPOINT}/var/lib/ollama/", check=False)

    # Copy systemd service files
    for svc in ["ollama.service", "ollama-warmup.service"]:
        src = f"/etc/systemd/system/{svc}"
        if os.path.exists(src):
            run(f"cp {src} {MOUNTPOINT}/etc/systemd/system/{svc}", check=False)

    # Enable ollama services
    run(f"arch-chroot {MOUNTPOINT} systemctl enable ollama ollama-warmup", check=False)

    # Copy warmup script
    if os.path.exists("/usr/local/bin/promptos-warmup"):
        run(f"cp /usr/local/bin/promptos-warmup {MOUNTPOINT}/usr/local/bin/promptos-warmup", check=False)
        os.chmod(f"{MOUNTPOINT}/usr/local/bin/promptos-warmup", 0o755)


def main():
    if os.geteuid() != 0:
        print("promptos-install must be run as root.")
        sys.exit(1)

    # ── Welcome ───────────────────────────────────────────────────────────────
    print_step(
        "Welcome to promptOS Installer",
        "This will install promptOS to your disk.\n"
        "Disk will be partitioned automatically:\n"
        "  • 512 MiB EFI boot partition\n"
        "  • Remaining space → root (/)\n\n"
        "[bold red]WARNING: The selected disk will be completely erased.[/bold red]"
    )

    if not confirm("Ready to begin?", default=True):
        print("Installation cancelled.")
        sys.exit(0)

    # ── Disk selection ────────────────────────────────────────────────────────
    print_step("Select Installation Disk")
    disks = get_disks()

    if not disks:
        if RICH:
            console.print("[red]No disks found. Make sure you're booted from the live ISO.[/red]")
        sys.exit(1)

    if RICH:
        for i, d in enumerate(disks):
            console.print(f"  [bold]{i+1}[/bold]. {d['name']:12} {d['size']:8} {d['model']}")
    else:
        for i, d in enumerate(disks):
            print(f"  {i+1}. {d['name']:12} {d['size']:8} {d['model']}")

    while True:
        choice = ask("Disk number", "1")
        try:
            idx = int(choice) - 1
            if 0 <= idx < len(disks):
                target_disk = disks[idx]["name"]
                break
        except ValueError:
            pass
        print("Invalid choice, try again.")

    if RICH:
        console.print(f"\n[bold yellow]Target: {target_disk}[/bold yellow]")
    if not confirm(f"ALL DATA on {target_disk} will be erased. Continue?", default=False):
        print("Installation cancelled.")
        sys.exit(0)

    # ── WiFi (optional, before partitioning so it persists into install) ─────
    if not is_online():
        print_step(
            "Network",
            "No network detected. WiFi connections set up now will be saved\n"
            "to the installed system, so you'll be online after first boot."
        )
        if confirm("Set up WiFi now?", default=True):
            run("/usr/local/bin/promptos-wifi", check=False)
    else:
        print_step("Network", "Already online — wifi/ethernet settings will carry over to the installed system.")

    # ── Config ────────────────────────────────────────────────────────────────
    print_step("System Configuration")
    hostname = ask("Hostname", "promptos")
    timezone = ask("Timezone", "America/New_York")
    locale   = ask("Locale", "en_US.UTF-8")

    # ── Root password ─────────────────────────────────────────────────────────
    print_step(
        "Root Password",
        "Set a password for the root account. You'll use this for SSH\n"
        "and any sudo-equivalent operations on the installed system."
    )
    root_password = prompt_password("Root password")

    # ── Admin user ────────────────────────────────────────────────────────────
    # GDM/SDDM block root login, so a desktop-capable account is needed for any
    # future GUI work. We always create one and put it in the wheel group.
    print_step(
        "Admin User",
        "Create an admin user (in the wheel group, with sudo access).\n"
        "This account is required to log into a graphical desktop later —\n"
        "GNOME/KDE/etc. refuse to run as root."
    )
    admin_user = ""
    while not admin_user:
        candidate = ask("Admin username", "admin").strip().lower()
        # Basic sanity: lowercase, starts with letter, alnum/underscore/hyphen
        import re
        if re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", candidate) and candidate != "root":
            admin_user = candidate
        else:
            print("Invalid username. Use lowercase letters/digits/_/-, max 32 chars, not 'root'.")
    admin_password = prompt_password(f"Password for {admin_user}")

    # ── Install ───────────────────────────────────────────────────────────────
    print_step(
        "Installing",
        f"Installing promptOS to {target_disk}. This will take several minutes."
    )

    print_step("Partitioning Disk")
    partition_disk(target_disk)
    efi, root = format_partitions(target_disk)

    print_step("Mounting Partitions")
    mount_partitions(efi, root)

    print_step("Copying System (offline)")
    install_base()

    print_step("Configuring System")
    setup_system(hostname, timezone, locale, root_password, admin_user, admin_password)

    print_step("Installing Bootloader")
    install_bootloader()

    # ── Done ──────────────────────────────────────────────────────────────────
    print_step(
        "Installation Complete!",
        f"promptOS has been installed to {target_disk}.\n\n"
        "Remove the USB drive and reboot."
    )

    if confirm("Reboot now?", default=True):
        run("reboot")


if __name__ == "__main__":
    main()
