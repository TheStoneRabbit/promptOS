#!/usr/bin/env bash
# promptos-wifi — interactive WiFi connect via nmcli
# Usage:
#   promptos-wifi              interactive (list networks, pick, prompt for password)
#   promptos-wifi --check      exit 0 if online, 1 if offline (no prompts)
#   promptos-wifi --auto       only prompt if offline; otherwise quietly exit
set -u

GREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[1;31m'
DIM=$'\033[2m'
RESET=$'\033[0m'

is_online() {
    # Prefer NetworkManager's view; fall back to a direct probe.
    if command -v nm-online >/dev/null 2>&1; then
        nm-online -q --timeout=2 && return 0
    fi
    curl -sf --max-time 3 http://detectportal.firefox.com/success.txt >/dev/null 2>&1
}

case "${1:-}" in
    --check)
        is_online && exit 0 || exit 1
        ;;
    --auto)
        if is_online; then
            exit 0
        fi
        echo "${YELLOW}No network detected — launching WiFi setup.${RESET}"
        ;;
esac

# Make sure NetworkManager is running and the radio is on.
if ! systemctl is-active --quiet NetworkManager; then
    echo "${DIM}Starting NetworkManager...${RESET}"
    systemctl start NetworkManager 2>/dev/null || true
    sleep 1
fi
rfkill unblock wifi 2>/dev/null || true
nmcli radio wifi on 2>/dev/null || true

# Find a wifi device.
wifi_dev=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="wifi"{print $1; exit}')
if [ -z "$wifi_dev" ]; then
    echo "${RED}No WiFi device detected.${RESET}"
    echo "${DIM}Try: nmcli device   |   rfkill list${RESET}"
    exit 1
fi

echo "${DIM}Scanning on $wifi_dev...${RESET}"
nmcli device wifi rescan ifname "$wifi_dev" 2>/dev/null || true
sleep 2

# Build the network list (skip empty SSIDs / hidden).
mapfile -t networks < <(
    nmcli -t -e no -f SSID,SIGNAL,SECURITY device wifi list ifname "$wifi_dev" \
        | awk -F: 'length($1)>0 && !seen[$1]++ {print $1"\t"$2"\t"$3}'
)

if [ "${#networks[@]}" -eq 0 ]; then
    echo "${RED}No networks found.${RESET}"
    exit 1
fi

echo
printf "  %3s  %-32s  %-6s  %s\n" "#" "SSID" "Signal" "Security"
printf "  %3s  %-32s  %-6s  %s\n" "---" "--------------------------------" "------" "--------"
i=1
for n in "${networks[@]}"; do
    IFS=$'\t' read -r ssid signal security <<<"$n"
    [ -z "$security" ] && security="--"
    printf "  ${GREEN}%3d${RESET}  %-32s  %-6s  %s\n" "$i" "${ssid:0:32}" "$signal" "$security"
    i=$((i+1))
done
echo

read -rp "Network # (or SSID, blank to cancel): " choice
if [ -z "$choice" ]; then
    echo "${DIM}Cancelled.${RESET}"
    exit 0
fi

# Resolve choice → SSID
ssid=""
if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#networks[@]}" ]; then
    ssid=$(printf '%s' "${networks[$((choice-1))]}" | cut -f1)
else
    ssid="$choice"
fi

# Determine if security looks open.
security=""
for n in "${networks[@]}"; do
    IFS=$'\t' read -r s _ sec <<<"$n"
    if [ "$s" = "$ssid" ]; then
        security="$sec"
        break
    fi
done

if [ -z "$security" ] || [ "$security" = "--" ]; then
    echo "${DIM}Connecting to '$ssid' (open network)...${RESET}"
    nmcli device wifi connect "$ssid" ifname "$wifi_dev"
else
    read -rsp "Password: " pass
    echo
    if [ -z "$pass" ]; then
        echo "${DIM}Cancelled.${RESET}"
        exit 0
    fi
    echo "${DIM}Connecting to '$ssid'...${RESET}"
    nmcli device wifi connect "$ssid" password "$pass" ifname "$wifi_dev"
fi

if is_online; then
    echo "${GREEN}Online.${RESET}"
else
    echo "${YELLOW}Connected, but no internet detected. Try again or run: nmcli device${RESET}"
fi
