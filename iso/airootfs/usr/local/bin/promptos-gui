        self.sessions_list.connect("row-activated", self._on_session_row_activated)
        sessions_scroll = Gtk.ScrolledWindow()
        sessions_scroll.set_vexpand(True)
        sessions_scroll.set_child(self.sessions_list)
        sessions_scroll.set_margin_end(8)
        sidebar.append(sessions_scroll)

        refresh_btn = Gtk.Button(label="Refresh")
        refresh_btn.add_css_class("promptos-btn")
        refresh_btn.connect("clicked", lambda *_: self._refresh_sessions())
        refresh_btn.set_margin_end(8)
        sidebar.append(refresh_btn)

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main.set_hexpand(True)
        main.set_vexpand(True)
        main.set_margin_top(8)
        main.set_margin_bottom(8)
        main.set_margin_end(12)
        root.append(main)

        self.chat_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.chat_list.set_vexpand(True)

        self.chat_scroll = Gtk.ScrolledWindow()
        self.chat_scroll.set_vexpand(True)
        self.chat_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.chat_scroll.set_child(self.chat_list)
        self.chat_scroll.get_vadjustment().connect("value-changed", self._on_chat_scroll_changed)
        main.append(self.chat_scroll)

        cmd_frame = Gtk.Frame()
        cmd_frame.set_margin_top(6)
        cmd_frame.set_margin_bottom(6)
        cmd_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        cmd_box.set_margin_top(8)
        cmd_box.set_margin_bottom(8)
        cmd_box.set_margin_start(8)
        cmd_box.set_margin_end(8)
        cmd_label = Gtk.Label(label="Actions", xalign=0)
        cmd_label.add_css_class("caption")
        self.cmd_cards_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        cmd_box.append(cmd_label)
        cmd_box.append(self.cmd_cards_box)
        cmd_frame.set_child(cmd_box)
        main.append(cmd_frame)

        composer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        composer.set_margin_top(6)
        composer.set_margin_bottom(12)
        composer.set_margin_start(10)
        composer.set_margin_end(10)

        suggest_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        suggest_row.set_margin_bottom(2)
        suggest_title = Gtk.Label(label="Suggested next:", xalign=0)
        suggest_title.add_css_class("caption")
        self.suggest_cards_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        suggest_scroll = Gtk.ScrolledWindow()
        suggest_scroll.set_hexpand(True)
        suggest_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        suggest_scroll.set_min_content_height(44)
        suggest_scroll.set_child(self.suggest_cards_box)
        suggest_row.append(suggest_title)
        suggest_row.append(suggest_scroll)
        composer.append(suggest_row)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.entry = Gtk.TextView()
        self.entry.set_hexpand(True)
        self.entry.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.entry.set_placeholder_text("Interact with promptOS...")
        self.entry.set_top_margin(8)
        self.entry.set_bottom_margin(8)
        self.entry.set_left_margin(8)
        self.entry.set_right_margin(8)
        self.entry_key_controller = Gtk.EventControllerKey.new()
        self.entry_key_controller.connect("key-pressed", self._on_entry_key_pressed)
        self.entry.add_controller(self.entry_key_controller)
        entry_scroll = Gtk.ScrolledWindow()
        entry_scroll.add_css_class("composer-input")
        entry_scroll.set_hexpand(True)
        entry_scroll.set_min_content_height(82)
        entry_scroll.set_max_content_height(160)
        entry_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        entry_scroll.set_child(self.entry)
        self.entry.add_css_class("composer-input-view")

        send = Gtk.Button(label="Send")
        send.add_css_class("suggested-action")
        send.connect("clicked", lambda *_: self._submit())
        send.set_valign(Gtk.Align.START)
        send.set_vexpand(False)
        self.send_btn = send
        self.stop_btn = Gtk.Button(label="Stop")
        self.stop_btn.add_css_class("stop-btn")
        self.stop_btn.connect("clicked", lambda *_: self._stop_generation())
        self.stop_btn.set_valign(Gtk.Align.START)
        self.stop_btn.set_vexpand(False)
        self.stop_btn.set_sensitive(False)

        row.append(entry_scroll)
        row.append(send)
        row.append(self.stop_btn)
        composer.append(row)
        main.append(composer)

    def _load_provider(self):
        override = os.environ.get("PROMPTOS_PROVIDER")
        self.active_provider = get_provider(None if override == "auto" else override)
        self._refresh_provider_badge()

    def _new_chat(self):
        system_prompt = (self._load_gui_agent_prompt() + self._build_runtime_context()).strip()
        self.history = [
            Message(
                "system",
                system_prompt,
            )
        ]
        self.pending_cards.clear()
        self.current_assistant_bubble = None
        self.active_session_name = None
        self._set_suggested_next("Ask about system status, logs, networking, or package updates.")

        child = self.chat_list.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.chat_list.remove(child)
            child = nxt

        child = self.cmd_cards_box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.cmd_cards_box.remove(child)
            child = nxt

        self._add_assistant_message("New chat started. Ask anything about this system.")

    def _clear_chat_view(self):
        child = self.chat_list.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.chat_list.remove(child)
            child = nxt

        child = self.cmd_cards_box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.cmd_cards_box.remove(child)
            child = nxt

    def _use_quick_prompt(self, text: str):
        self.entry.get_buffer().set_text(text)
        self._submit()

    def _add_bubble(self, role: str, text: str) -> ChatBubble:
        bubble = ChatBubble(role, text)
        self.chat_list.append(bubble)
        if self.follow_output:
            GLib.idle_add(self._scroll_to_bottom)
        return bubble

    def _add_user_message(self, text: str):
        self._add_bubble("user", text)

    def _add_assistant_message(self, text: str):
        self._add_bubble("assistant", text)

    def _scroll_to_bottom(self):
        adj = self.chat_scroll.get_vadjustment()
        self._programmatic_scroll = True
        adj.set_value(max(0.0, adj.get_upper() - adj.get_page_size()))
        GLib.idle_add(self._clear_programmatic_scroll_flag)
        return False

    def _clear_programmatic_scroll_flag(self):
        self._programmatic_scroll = False
        return False

    def _on_chat_scroll_changed(self, adj: Gtk.Adjustment):
        if self._programmatic_scroll:
            return
        self.follow_output = self._is_near_bottom(adj)

    def _is_near_bottom(self, adj: Gtk.Adjustment) -> bool:
        # Keep following while user is at/near bottom (pixel tolerance).
        bottom = adj.get_upper() - adj.get_page_size()
        return (bottom - adj.get_value()) <= 36.0

    def _set_input_enabled(self, enabled: bool):
        self.entry.set_sensitive(enabled)
        self.send_btn.set_sensitive(enabled)
        self.stop_btn.set_sensitive(not enabled)
        if enabled:
            if not self.autorun_commands and self.pending_cards:
                self._focus_run_on_next_pending_card()
            else:
                self.entry.grab_focus()

    def _submit(self):
        buf = self.entry.get_buffer()
        text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
        if not text:
            return
        buf.set_text("")
        self.follow_output = True

        if text.startswith("/"):
            self._handle_slash_command(text)
            return

        if not self.active_provider:
            self._add_assistant_message("No AI provider available. Configure keys or run local ollama.")
            return

        self._add_user_message(text)
        self.history.append(Message("user", text))
        self._refresh_system_message()
        self._set_input_enabled(False)
        self._generation_seq += 1
        generation_id = self._generation_seq

        bubble = self._add_bubble("assistant", "")
        self.current_assistant_bubble = bubble

        def _worker():
            chunks: list[str] = []
            try:
                for chunk in self.active_provider.chat(self.history, stream=True):
                    if generation_id in self._cancelled_generations:
                        break
                    chunks.append(chunk)
                    joined = "".join(chunks)
                    GLib.idle_add(self._update_streaming_bubble, generation_id, joined)
                if generation_id in self._cancelled_generations:
                    GLib.idle_add(self._finalize_response, generation_id, "[stopped]")
                    return
                response = "".join(chunks).strip()
                if not response:
                    response = "(no response)"
                self.history.append(Message("assistant", response))
                GLib.idle_add(self._finalize_response, generation_id, response)
            except Exception as e:
                GLib.idle_add(self._finalize_response, generation_id, f"Provider error: {e}")

        threading.Thread(target=_worker, daemon=True).start()

    def _handle_slash_command(self, text: str):
        self._add_user_message(text)
        cmd = text.strip()
        if cmd == "/help":
            self._add_assistant_message(
                "Commands:\n"
                "- /help\n"
                "- /clear\n"
                "- /history\n"
                "- /providers\n"
                "- /switch <provider>\n"
                "- /llm-model show\n"
                "- /llm-model set <provider> <model>\n"
                "- /llm-model set <model> (current provider)\n"
                "- /save [name]\n"
                "- /load <name>\n"
                "- /sessions\n"
                "- /forget <name>\n"
                "- /keys\n"
                "- /keysetup\n"
                "- /wifi\n"
                "- /model [status|pull|ensure]\n"
                "- /autorun [on|off]\n"
                "- /install"
            )
            return
        if cmd == "/clear":
            self._new_chat()
            self._add_assistant_message("Conversation cleared.")
            return
        if cmd == "/history":
            lines = []
            for m in self.history:
                if m.role == "system":
                    continue
                lines.append(f"[{m.role}] {m.content}")
            self._add_assistant_message("\n\n".join(lines) if lines else "No conversation history.")
            return
        if cmd.startswith("/switch"):
            parts = cmd.split(" ", 1)
            if len(parts) < 2 or not parts[1].strip():
                self._add_assistant_message("Usage: /switch <claude|openai|groq|ollama>")
                return
            name = parts[1].strip()
            try:
                p = get_provider(name)
            except Exception as e:
                self._add_assistant_message(f"Switch failed: {e}")
                return
            if not p:
                self._add_assistant_message(f"Provider `{name}` unavailable.")
                return
            self.active_provider = p
            self._refresh_provider_badge()
            self._refresh_system_message()
            self._add_assistant_message(f"Switched provider to `{name}`.")
            return
        if cmd.startswith("/llm-model"):
            self._handle_llm_model_command(cmd)
            return
        if cmd.startswith("/save"):
            parts = cmd.split(" ", 1)
            name = parts[1].strip() if len(parts) > 1 and parts[1].strip() else ""
            self._save_current_session(name)
            return
        if cmd.startswith("/load"):
            parts = cmd.split(" ", 1)
            if len(parts) < 2 or not parts[1].strip():
                self._add_assistant_message("Usage: /load <session-name>")
                return
            self._load_session(parts[1].strip())
            return
        if cmd == "/sessions":
            self._show_sessions()
            return
        if cmd.startswith("/forget"):
            parts = cmd.split(" ", 1)
            if len(parts) < 2 or not parts[1].strip():
                self._add_assistant_message("Usage: /forget <session-name>")
                return
            self._forget_session(parts[1].strip())
            return
        if cmd == "/keys":
            self._run_local_command("promptos-keys show")
            return
        if cmd == "/keysetup":
            self._run_local_command("promptos-keys setup")
            return
        if cmd == "/providers":
            lines = []
            for p in list_providers():
                status = "available" if p["available"] else "unavailable"
                lines.append(f"- {p['name']}: {status}")
            self._add_assistant_message("Providers:\n" + "\n".join(lines))
            return
        if cmd.startswith("/autorun"):
            parts = cmd.split(" ", 1)
            if len(parts) == 1:
                self.autorun_commands = not self.autorun_commands
            else:
                v = parts[1].strip().lower()
                if v in ("on", "true", "1", "yes"):
                    self.autorun_commands = True
                elif v in ("off", "false", "0", "no"):
                    self.autorun_commands = False
                else:
                    self._add_assistant_message("Usage: /autorun [on|off]")
                    return
            self.autorun_switch.set_active(self.autorun_commands)
            self._add_assistant_message(f"Autorun {'ON' if self.autorun_commands else 'OFF'}.")
            return
        if cmd == "/install":
            self._run_local_command("promptos-install")
            return
        if cmd == "/wifi":
            self._run_local_command("promptos-wifi")
            return
        if cmd.startswith("/model"):
            tail = cmd.split(" ", 1)
            model_cmd = "promptos-model status" if len(tail) == 1 else f"promptos-model {tail[1]}"
            self._run_local_command(model_cmd)
            return
        self._add_assistant_message(f"Unknown local command: {cmd}")

    def _run_local_command(self, command: str):
        self._add_assistant_message(f"Running:\n```bash\n{command}\n```")
        self._set_input_enabled(False)

        handled, code, output = self._maybe_handle_cd_command(command)
        if handled:
            message = f"Exit {code}\n```text\n{output}\n```"
            self._finish_local_command(message)
            return

        def _runner():
            code, output = self._run_shell_command(command)
            if not output.strip():
                output = "(no output)"
            message = f"Exit {code}\n```text\n{output}\n```"
            GLib.idle_add(self._finish_local_command, message)

        threading.Thread(target=_runner, daemon=True).start()

    def _finish_local_command(self, message: str):
        self._add_assistant_message(message)
        self._set_input_enabled(True)
        self._request_suggested_next_async()
        return False

    def _update_streaming_bubble(self, generation_id: int, text: str):
        if generation_id in self._cancelled_generations:
            return False
        if self.current_assistant_bubble:
            self.current_assistant_bubble.set_text(text)
        self._scroll_to_bottom()
        return False

    def _finalize_response(self, generation_id: int, response: str):
        if generation_id in self._cancelled_generations:
            self._cancelled_generations.discard(generation_id)
            self.current_assistant_bubble = None
            self._set_input_enabled(True)
            self._refresh_provider_badge()
            return False
        if self.current_assistant_bubble:
            self.current_assistant_bubble.set_text(response)
        self.current_assistant_bubble = None
        self._set_input_enabled(True)
        self._parse_cmd_cards(response)
        self._request_suggested_next_async()
        self._refresh_provider_badge()
        self._refresh_sessions()
        return False

    def _stop_generation(self):
        if self.stop_btn.get_sensitive():
            self._cancelled_generations.add(self._generation_seq)
            self._set_input_enabled(True)

    def _refresh_provider_badge(self):
        name = self.active_provider.name if self.active_provider else "none"
        self.provider_badge.set_text(f"Provider: {name}")

    def _handle_llm_model_command(self, cmd: str):
        parts = cmd.split()
        # /llm-model
        if len(parts) == 1:
            self._show_current_models()
            return
        # /llm-model show
        if len(parts) == 2 and parts[1] == "show":
            self._show_current_models()
            return
        # /llm-model list [provider]
        if len(parts) >= 2 and parts[1] == "list":
            provider = parts[2].lower() if len(parts) >= 3 else None
            self._list_possible_models(provider)
            return
        # /llm-model set ...
        if len(parts) >= 3 and parts[1] == "set":
            # /llm-model set <model>  (for active provider)
            if len(parts) == 3:
                if not self.active_provider:
                    self._add_assistant_message("No active provider to set model for.")
                    return
                provider_name = self.active_provider.name
                model = parts[2]
            else:
                provider_name = parts[2].lower()
                model = " ".join(parts[3:]).strip()
            self._set_provider_model(provider_name, model)
            return
        self._add_assistant_message(
            "Usage:\n"
            "- /llm-model show\n"
            "- /llm-model list [provider]\n"
            "- /llm-model set <provider> <model>\n"
            "- /llm-model set <model>"
        )

    def _show_current_models(self):
        lines = ["Current provider models:"]
        for provider, env_key in MODEL_ENV_BY_PROVIDER.items():
            value = os.environ.get(env_key, "(default)")
            active = " (active)" if self.active_provider and self.active_provider.name == provider else ""
            lines.append(f"- {provider}: {value}{active}")
        self._add_assistant_message("\n".join(lines))

    def _set_provider_model(self, provider_name: str, model: str):
        if provider_name not in MODEL_ENV_BY_PROVIDER:
            self._add_assistant_message(
                "Unknown provider. Use one of: claude, openai, groq, ollama."
            )
            return
        if not model:
            self._add_assistant_message("Model cannot be empty.")
            return
        env_key = MODEL_ENV_BY_PROVIDER[provider_name]
        os.environ[env_key] = model
        persist_msg = self._persist_model_config(env_key, model)
        # Rebind provider if this is active or if no provider yet.
        if (self.active_provider and self.active_provider.name == provider_name) or not self.active_provider:
            p = get_provider(provider_name)
            if p:
                self.active_provider = p
                self._refresh_provider_badge()
                self._refresh_system_message()
                self._add_assistant_message(f"Set `{provider_name}` model to `{model}`. {persist_msg}")
                return
            self._add_assistant_message(
                f"Saved `{provider_name}` model as `{model}`, but provider is currently unavailable. {persist_msg}"
            )
            return
        self._add_assistant_message(f"Set `{provider_name}` model to `{model}`. {persist_msg}")

    def _persist_model_config(self, key: str, value: str) -> str:
        lines: list[str] = []
        found = False
        try:
            if os.path.exists(PROMPTOS_CONFIG_PATH):
                with open(PROMPTOS_CONFIG_PATH) as f:
                    for raw in f:
                        line = raw.rstrip("\n")
                        if line.strip().startswith(f"{key}="):
                            lines.append(f"{key}={value}")
                            found = True
                        else:
                            lines.append(line)
            if not found:
                lines.append(f"{key}={value}")
            os.makedirs(os.path.dirname(PROMPTOS_CONFIG_PATH), exist_ok=True)
            with open(PROMPTOS_CONFIG_PATH, "w") as f:
                f.write("\n".join(lines).rstrip() + "\n")
            return "(persisted to /etc/promptos/config)"
        except PermissionError:
            return "(not persisted: permission denied writing /etc/promptos/config)"
        except Exception as e:
            return f"(not persisted: {e})"

    def _list_possible_models(self, provider: str | None):
        if provider and provider not in MODEL_ENV_BY_PROVIDER:
            self._add_assistant_message("Unknown provider. Use one of: claude, openai, groq, ollama.")
            return

        targets = [provider] if provider else ["openai", "claude", "groq", "ollama"]
        lines = ["Possible models by provider:"]
        for p in targets:
            if p == "ollama":
                lines.append("- ollama:")
                ollama_models = self._list_ollama_models()
                if ollama_models:
                    for m in ollama_models[:12]:
                        lines.append(f"  - {m}")
                else:
                    lines.append("  - (no local models found; run `ollama list` / pull one)")
                continue
            hints = MODEL_CATALOG_HINTS.get(p, [])
            lines.append(f"- {p}:")
            for m in hints:
                lines.append(f"  - {m}")
            lines.append("  - (plus any model your API account has access to)")
        self._add_assistant_message("\n".join(lines))

    def _list_ollama_models(self) -> list[str]:
        try:
            proc = subprocess.run(
                ["ollama", "list"],
                text=True,
                capture_output=True,
                cwd=self.current_cwd,
            )
            if proc.returncode != 0:
                return []
            models = []
            for line in (proc.stdout or "").splitlines()[1:]:
                line = line.strip()
                if not line:
                    continue
                parts = line.split()
                if parts:
                    models.append(parts[0])
            return models
        except Exception:
            return []

    def _on_autorun_toggled(self, switch: Gtk.Switch, _param):
        self.autorun_commands = switch.get_active()

    def _parse_cmd_cards(self, text: str):
        for command in self._extract_suggested_commands(text):
            if not command or command in self.pending_cards:
                continue
            card = CommandCard(command, self._run_command_card, self._skip_command_card)
            self.pending_cards[command] = card
            self.cmd_cards_box.append(card)
            if self.autorun_commands:
                self._run_command_card(command)
        if not self.autorun_commands:
            self._focus_run_on_next_pending_card()

    def _extract_suggested_commands(self, text: str) -> list[str]:
        cmds: list[str] = []
        lines = text.splitlines()
        i = 0
        while i < len(lines):
            stripped = lines[i].strip()
            if not stripped.startswith("CMD:"):
                i += 1
                continue

            payload = stripped[4:].strip()
            if payload.startswith("```"):
                i += 1
                while i < len(lines):
                    body = lines[i]
                    if body.strip().startswith("```"):
                        break
                    candidate = self._normalize_command(body)
                    if candidate:
                        cmds.append(candidate)
                    i += 1
                i += 1
                continue

            candidate = self._normalize_command(payload)
            if candidate:
                cmds.append(candidate)
            i += 1
        return cmds

    def _normalize_command(self, text: str) -> str:
        cmd = text.strip().strip("`").strip()
        # Remove accidental unmatched trailing quote artifacts from model output,
        # while preserving valid balanced quoted commands.
        if cmd.endswith("'") and cmd.count("'") % 2 == 1:
            cmd = cmd[:-1].rstrip()
        if cmd.endswith('"') and cmd.count('"') % 2 == 1:
            cmd = cmd[:-1].rstrip()
        return cmd

    def _run_command_card(self, command: str):
        if command not in self.pending_cards:
            return
        if command not in self.command_queue:
            self.command_queue.append(command)
        card = self.pending_cards.get(command)
        if card:
            card.set_state("Queued" if self.command_running else "Running...")
        if not self.command_running:
            self._start_next_queued_command()

    def _start_next_queued_command(self):
        if self.command_running:
            return
        while self.command_queue and self.command_queue[0] not in self.pending_cards:
            self.command_queue.pop(0)
        if not self.command_queue:
            return
        command = self.command_queue.pop(0)
        card = self.pending_cards.get(command)
        if card:
            card.set_state("Running...")
        self.command_running = True

        handled, code, output = self._maybe_handle_cd_command(command)
        if handled:
            GLib.idle_add(self._on_card_finished, command, code, output)
            return

        def _runner():
            exit_code, output = self._run_shell_command(command)
            GLib.idle_add(self._on_card_finished, command, exit_code, output)

        threading.Thread(target=_runner, daemon=True).start()

    def _skip_command_card(self, command: str):
        card = self.pending_cards.get(command)
        if not card:
            return
        self.command_queue = [c for c in self.command_queue if c != command]
        self.cmd_cards_box.remove(card)
        del self.pending_cards[command]
        if not self.autorun_commands:
            self._focus_run_on_next_pending_card()
            if not self.pending_cards:
                self.entry.grab_focus()

    def _on_card_finished(self, command: str, code: int, output: str):
        self.command_running = False
        card = self.pending_cards.get(command)
        if card:
            self.cmd_cards_box.remove(card)
            del self.pending_cards[command]
        summary = f"Command `{command}` finished with exit {code}."
        if output.strip():
            summary += f"\n\n```text\n{output}\n```"
        self._add_assistant_message(summary)
        self._request_command_followup_async(command, code, output)
        self._request_suggested_next_async()
        self._start_next_queued_command()
        if not self.autorun_commands:
            self._focus_run_on_next_pending_card()
            if not self.pending_cards:
                self.entry.grab_focus()
        return False

    def _focus_run_on_next_pending_card(self):
        if not self.pending_cards:
            self.entry.grab_focus()
            return
        # Focus first pending card not currently queued/running first.
        for command, card in self.pending_cards.items():
            if command not in self.command_queue and command != "":
                card.set_run_as_default(self)
                return
        # Fallback: any pending card.
        for _, card in self.pending_cards.items():
            card.set_run_as_default(self)
            return

    def _request_command_followup_async(self, command: str, code: int, output: str):
        if not self.active_provider:
            return
        trimmed = (output or "").strip()
        if len(trimmed) > 1200:
            trimmed = trimmed[:1200] + "\n...[truncated]..."
        feedback_lines = [
            "[command results]",
            f"$ {command} -> exit {code}",
        ]
        if trimmed:
            feedback_lines.append(f"output:\n{trimmed}")
        self.history.append(Message("user", "\n".join(feedback_lines)))
        self._refresh_system_message()

        def _worker():
            try:
                chunks = []
                for chunk in self.active_provider.chat(self.history, stream=True):
                    chunks.append(chunk)
                response = "".join(chunks).strip()
                if response:
                    GLib.idle_add(self._on_command_followup_ready, response)
            except Exception:
                return

        threading.Thread(target=_worker, daemon=True).start()

    def _on_command_followup_ready(self, response: str):
        self.history.append(Message("assistant", response))
        self._add_assistant_message(response)
        self._parse_cmd_cards(response)
        self._request_suggested_next_async()
        return False

    def _refresh_sessions(self):
        child = self.sessions_list.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.sessions_list.remove(child)
            child = nxt

        sessions_dir = Path.home() / ".promptsh" / "sessions"
        if not sessions_dir.exists():
            self.sessions_list.append(Gtk.Label(label="No saved sessions", xalign=0))
            return

        entries = sorted(sessions_dir.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        if not entries:
            self.sessions_list.append(Gtk.Label(label="No saved sessions", xalign=0))
            return

        entries = entries[:80]
        if self.session_search_text:
            entries = [e for e in entries if self._session_matches_query(e, self.session_search_text)]
        if not entries:
            self.sessions_list.append(Gtk.Label(label="No matching sessions", xalign=0))
            return

        day_counts: dict[str, int] = {}
        for entry in entries:
            dt = datetime.datetime.fromtimestamp(entry.stat().st_mtime)
            day_key = dt.strftime("%Y-%m-%d")
            day_counts[day_key] = day_counts.get(day_key, 0) + 1
            session_idx = day_counts[day_key]
            title = self._session_summary_from_file(entry)
            if not title:
                title = f"{dt.strftime('%B %-d, %Y')} session {session_idx}"
            row = Gtk.ListBoxRow()
            row.set_activatable(True)
            row.set_selectable(True)
            row.set_name(entry.stem)

            frame = Gtk.Frame()
            frame.set_margin_top(4)
            frame.set_margin_bottom(4)
            frame.set_margin_start(2)
            frame.set_margin_end(2)

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.set_margin_top(8)
            box.set_margin_bottom(8)
            box.set_margin_start(8)
            box.set_margin_end(8)

            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            title_lbl = Gtk.Label(label=title, xalign=0)
            title_lbl.add_css_class("heading")
            title_lbl.set_max_width_chars(30)
            title_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            title_lbl.set_wrap(False)
            title_lbl.set_hexpand(True)
            delete_btn = Gtk.Button(label="X")
            delete_btn.add_css_class("flat")
            delete_btn.add_css_class("promptos-btn")
            delete_btn.set_size_request(22, 22)
            delete_btn.set_margin_start(4)
            delete_btn.set_tooltip_text("Delete session")
            delete_btn.set_halign(Gtk.Align.END)
            delete_btn.connect("clicked", lambda _, n=entry.stem: self._delete_session_and_refresh(n))
            header.append(title_lbl)
            header.append(delete_btn)
            name_lbl = Gtk.Label(label=entry.stem, xalign=0)
            name_lbl.add_css_class("caption")
            name_lbl.add_css_class("monospace")

            box.append(header)
            box.append(name_lbl)
            frame.set_child(box)
            row.set_child(frame)
            self.sessions_list.append(row)

    def _on_session_search_changed(self, entry: Gtk.SearchEntry):
        self.session_search_text = entry.get_text().strip().lower()
        self._refresh_sessions()

    def _session_matches_query(self, entry: Path, query: str) -> bool:
        if query in entry.stem.lower():
            return True
        try:
            with open(entry) as f:
                data = json.load(f)
            if isinstance(data, dict):
                meta_title = str(data.get("title", "")).lower()
                if query in meta_title:
                    return True
                data = data.get("messages", [])
            for item in data:
                content = str(item.get("content", "")).lower()
                if query in content:
                    return True
        except Exception:
            return False
        return False

    def _default_session_name(self) -> str:
        summary = self._session_summary_from_history()
        if summary:
            return summary
        return datetime.datetime.now().strftime("session-%Y%m%d-%H%M%S")

    def _safe_session_name(self, name: str) -> str:
        keep = "_-."
        out = "".join(c if (c.isalnum() or c in keep) else "_" for c in name).strip("_")
        return out or self._default_session_name()

    def _session_path(self, name: str) -> Path:
        sessions_dir = Path.home() / ".promptsh" / "sessions"
        sessions_dir.mkdir(parents=True, exist_ok=True)
        return sessions_dir / f"{self._safe_session_name(name)}.json"

    def _save_current_session(self, name: str):
        explicit_name = bool(name and name.strip())
        # If this chat was already saved and user didn't provide a new explicit name,
        # overwrite the same session file.
        if self.active_session_name and not explicit_name:
            target_name = self.active_session_name
        else:
            title = self._generate_session_title()
            target_name = (name.strip() if explicit_name else "") or title or self._default_session_name()

        path = self._session_path(name)
        messages = [{"role": m.role, "content": m.content} for m in self.history]
        data = {
            "title": self._generate_session_title() or target_name,
            "messages": messages,
        }
        try:
            path = self._session_path(target_name)
            with open(path, "w") as f:
                json.dump(data, f, indent=2)
            self.active_session_name = path.stem
            self._add_assistant_message(f"Saved session `{path.stem}` ({len(messages)} messages).")
            self._refresh_sessions()
        except Exception as e:
            self._add_assistant_message(f"Failed to save session `{target_name}`: {e}")

    def _show_sessions(self):
        sessions_dir = Path.home() / ".promptsh" / "sessions"
        if not sessions_dir.exists():
            self._add_assistant_message("No saved sessions.")
            return
        entries = sorted(sessions_dir.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        if not entries:
            self._add_assistant_message("No saved sessions.")
            return
        lines = ["Saved sessions:"]
        for entry in entries[:30]:
            summary = self._session_summary_from_file(entry) or entry.stem
            lines.append(f"- {summary} [{entry.stem}]")
        self._add_assistant_message("\n".join(lines))

    def _session_summary_from_history(self) -> str:
        candidates: list[str] = []
        for m in self.history:
            if m.role != "user":
                continue
            text = " ".join(m.content.split()).strip()
            if not text or text.startswith("/"):
                continue
            candidates.append(text)
        if candidates:
            # Prefer a later message over the first prompt to better reflect the conversation.
            text = candidates[-1]
            if len(text) > 52:
                text = text[:52].rstrip()
            return text
        return ""

    def _session_summary_from_file(self, entry: Path) -> str:
        try:
            with open(entry) as f:
                data = json.load(f)
            if isinstance(data, dict):
                title = " ".join(str(data.get("title", "")).split()).strip()
                if title:
                    return title[:52].rstrip()
                data = data.get("messages", [])
            candidates: list[str] = []
            for item in data:
                if item.get("role") != "user":
                    continue
                text = " ".join(str(item.get("content", "")).split()).strip()
                if not text or text.startswith("/"):
                    continue
                candidates.append(text)
            if candidates:
                text = candidates[-1]
                if len(text) > 52:
                    text = text[:52].rstrip()
                return text
        except Exception:
            return ""
        return ""

    def _generate_session_title(self) -> str:
        # Try model-based summary title first; fallback to heuristic.
        fallback = self._session_summary_from_history()
        if not self.active_provider:
            return fallback
        convo_lines = []
        for m in self.history[-12:]:
            if m.role != "user":
                continue
            content = (m.content or "").strip()
            # Skip synthetic feedback injected by the GUI runtime.
            if content.startswith("[command results]"):
                continue
            convo_lines.append(f"user: {content}")
        if not convo_lines:
            return fallback
        prompt = (
            "Create a concise session title (4-8 words) summarizing this conversation. "
            "No quotes, no punctuation suffix, plain text only.\n\n"
            + "\n".join(convo_lines)
        )
        try:
            resp = "".join(self.active_provider.chat([Message("user", prompt)], stream=False)).strip()
            title = " ".join(resp.split()).strip().strip('"').strip("'")
            if not title:
                return fallback
            if len(title) > 52:
                title = title[:52].rstrip()
            return title
        except Exception:
            return fallback

    def _forget_session(self, name: str):
        path = self._session_path(name)
        if path.exists():
            try:
                path.unlink()
                self._add_assistant_message(f"Deleted session `{path.stem}`.")
                self._refresh_sessions()
                return
            except Exception as e:
                self._add_assistant_message(f"Failed to delete session `{name}`: {e}")
                return
        self._add_assistant_message(f"Session `{name}` not found.")

    def _delete_session_and_refresh(self, name: str):
        # Silent delete from sidebar control (no extra chat message spam).
        path = self._session_path(name)
        if path.exists():
            try:
                path.unlink()
                if self.active_session_name == name:
                    self.active_session_name = None
            except Exception:
                pass
        self._refresh_sessions()

    def _on_session_row_activated(self, _listbox: Gtk.ListBox, row: Gtk.ListBoxRow):
        name = row.get_name()
        if not name:
            return
        self._load_session(name)

    def _load_session(self, name: str):
        path = Path.home() / ".promptsh" / "sessions" / f"{name}.json"
        try:
            with open(path) as f:
                data = json.load(f)
        except Exception as e:
            self._add_assistant_message(f"Failed to load session '{name}': {e}")
            return

        if isinstance(data, dict):
            data = data.get("messages", [])
        if not isinstance(data, list):
            self._add_assistant_message(f"Session '{name}' has invalid format.")
            return

        loaded: list[Message] = []
        for item in data:
            if not isinstance(item, dict):
                continue
            role = item.get("role")
            content = item.get("content", "")
            if role not in ("system", "user", "assistant"):
                continue
            loaded.append(Message(role, content))

        if not loaded:
            self._add_assistant_message(f"Session '{name}' is empty.")
            return

        if loaded[0].role != "system":
            loaded.insert(
                0,
                Message(
                    "system",
                    self._load_gui_agent_prompt(),
                ),
            )

        self.history = loaded
        self.pending_cards.clear()
        self.current_assistant_bubble = None
        self.active_session_name = name
        self._clear_chat_view()

        for msg in self.history:
            if msg.role == "system":
                continue
            if msg.role == "user":
                self._add_user_message(msg.content)
            elif msg.role == "assistant":
                self._add_assistant_message(msg.content)
        self._refresh_system_message()
        self._request_suggested_next_async()

    def _load_gui_agent_prompt(self) -> str:
        try:
            with open(GUI_AGENT_MD) as f:
                text = f.read().strip()
                return text if text else GUI_AGENT_FALLBACK
        except OSError:
            return GUI_AGENT_FALLBACK

    def _build_runtime_context(self) -> str:
        try:
            user = getpass.getuser()
        except Exception:
            user = os.environ.get("USER", "unknown")
        try:
            uid = os.geteuid()
        except Exception:
            uid = -1
        priv = "root/full system access" if uid == 0 else "regular user — sudo for elevated commands"
        provider = self.active_provider.name if self.active_provider else "none"
        now = time.strftime("%Y-%m-%d %H:%M:%S")
        tz = time.strftime("%Z%z")
        host = socket.gethostname()
        home = os.path.expanduser("~")
        return (
            "\n\n## Live GUI Runtime Context\n"
            f"- Hostname: {host}\n"
            f"- User: {user}\n"
            f"- UID: {uid}\n"
            f"- Privileges: {priv}\n"
            f"- Home: {home}\n"
            f"- Current working directory: {self.current_cwd}\n"
            f"- Active provider: {provider}\n"
            f"- Local time: {now} {tz}\n"
            "- Command execution model: GUI executes suggested CMD lines and slash commands locally.\n"
            "- Working directory is persistent and can be changed with `cd`.\n"
            "- Do not claim lack of system context; suggest verification commands when needed.\n"
        )

    def _refresh_system_message(self):
        base = self._load_gui_agent_prompt()
        content = (base + self._build_runtime_context()).strip()
        if self.history and self.history[0].role == "system":
            self.history[0] = Message("system", content)
        else:
            self.history.insert(0, Message("system", content))

    def _update_cwd_label(self):
        self.cwd_label.set_text(f"CWD: {self.current_cwd}")
        self._refresh_system_message()

    def _maybe_handle_cd_command(self, command: str) -> tuple[bool, int, str]:
        cmd = command.strip()
        if not cmd:
            return False, 1, "Empty command"
        # Only handle simple shell built-in cd so cwd persists for future commands.
        if any(op in cmd for op in ("&&", "||", ";", "|")):
            return False, 0, ""
        try:
            parts = shlex.split(cmd)
        except ValueError as e:
            return True, 2, f"Invalid command syntax: {e}"
        if not parts or parts[0] != "cd":
            return False, 0, ""
        if len(parts) > 2:
            return True, 2, "cd takes at most one path argument"
        target = parts[1] if len(parts) == 2 else "~"
        target = os.path.expanduser(target)
        if not os.path.isabs(target):
            target = os.path.abspath(os.path.join(self.current_cwd, target))
        if not os.path.isdir(target):
            return True, 1, f"cd: no such directory: {target}"
        self.current_cwd = target
        self._update_cwd_label()
        return True, 0, f"Changed directory to {self.current_cwd}"

    def _set_suggested_next(self, text: str):
        cleaned = " ".join((text or "").split())
        self._set_suggested_next_items([cleaned] if cleaned else [])

    def _run_shell_command(self, command: str) -> tuple[int, str]:
        # Detach common GUI launch commands so they don't block the queue.
        detached = self._maybe_detach_gui_command(command)
        if detached is not None:
            return 0, detached

        needs_sudo = self._has_explicit_sudo(command)
        has_inline_sudo = self._has_inline_sudo(command)
        askpass_path = None
        env = os.environ.copy()
        run_args: list[str]
        if needs_sudo or has_inline_sudo:
            password = self._prompt_sudo_password()
            if password is None:
                return 1, "sudo cancelled by user"
            askpass_path = self._create_askpass_helper()
            env["SUDO_ASKPASS"] = askpass_path
            env["PROMPTOS_SUDO_PASS"] = password
            if needs_sudo:
                cmd_no_sudo = self._strip_leading_sudo(command)
                run_args = ["sudo", "-A", "bash", "-lc", cmd_no_sudo]
            else:
                rewritten = self._inject_inline_sudo_flags(command)
                run_args = ["bash", "-lc", rewritten]
        else:
            run_args = ["bash", "-lc", command]

        try:
            proc = subprocess.run(
                run_args,
                text=True,
                capture_output=True,
                cwd=self.current_cwd,
                env=env,
            )
        finally:
            if askpass_path:
                try:
                    os.remove(askpass_path)
                except OSError:
                    pass
        output = (proc.stdout or "") + (proc.stderr or "")
        if len(output) > 6000:
            output = output[:6000] + "\n...[truncated]..."
        if (
            proc.returncode != 0
            and not (needs_sudo or has_inline_sudo)
            and os.geteuid() != 0
            and self._should_retry_with_sudo(command, output)
        ):
            password = self._prompt_sudo_password()
            if password is None:
                return proc.returncode, output + "\n\nsudo cancelled by user"
            askpass_path = self._create_askpass_helper()
            env_retry = os.environ.copy()
            env_retry["SUDO_ASKPASS"] = askpass_path
            env_retry["PROMPTOS_SUDO_PASS"] = password
            try:
                retry = subprocess.run(
                    ["sudo", "-A", "bash", "-lc", command],
                    text=True,
                    capture_output=True,
                    cwd=self.current_cwd,
                    env=env_retry,
                )
            finally:
                try:
                    os.remove(askpass_path)
                except OSError:
                    pass
            output = (retry.stdout or "") + (retry.stderr or "")
            if len(output) > 6000:
                output = output[:6000] + "\n...[truncated]..."
            return retry.returncode, output
        return proc.returncode, output

    def _maybe_detach_gui_command(self, command: str) -> str | None:
        cmd = (command or "").strip()
        if not cmd:
            return None
        if self._has_explicit_sudo(cmd) or self._has_inline_sudo(cmd):
            return None
        if any(op in cmd for op in ("&&", "||", ";", "|")):
            return None
        try:
            parts = shlex.split(cmd)
        except ValueError:
            return None
        if not parts:
            return None
        if not self._is_probably_gui_exec(parts[0]):
            return None
        try:
            subprocess.Popen(
                parts,
                cwd=self.current_cwd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
            return f"Launched in background: {' '.join(parts)}"
        except Exception as e:
            return f"Failed to launch in background: {e}"

    def _is_probably_gui_exec(self, exe_name: str) -> bool:
        if exe_name in DETACH_COMMANDS:
            return True
        if self._gui_exec_cache is None:
            self._gui_exec_cache = self._load_gui_exec_cache()
        return exe_name in self._gui_exec_cache

    def _load_gui_exec_cache(self) -> set[str]:
        names: set[str] = set(DETACH_COMMANDS)
        app_dirs = [Path("/usr/share/applications"), Path.home() / ".local/share/applications"]
        for d in app_dirs:
            if not d.exists():
                continue
            for desktop in d.glob("*.desktop"):
                try:
                    exec_line = ""
                    no_display = False
                    terminal = False
                    with open(desktop) as f:
                        for raw in f:
                            line = raw.strip()
                            if line.startswith("NoDisplay=") and line.split("=", 1)[1].strip().lower() == "true":
                                no_display = True
                            elif line.startswith("Terminal=") and line.split("=", 1)[1].strip().lower() == "true":
                                terminal = True
                            elif line.startswith("Exec=") and not exec_line:
                                exec_line = line.split("=", 1)[1].strip()
                    if no_display or terminal or not exec_line:
                        continue
                    parts = shlex.split(exec_line)
                    if not parts:
                        continue
                    cmd = parts[0]
                    # Strip env wrappers like "env FOO=bar app %u".
                    if cmd == "env":
                        for tok in parts[1:]:
                            if "=" in tok:
                                continue
                            cmd = tok
                            break
                    cmd = os.path.basename(cmd)
                    if cmd:
                        names.add(cmd)
                except Exception:
                    continue
        return names

    def _has_explicit_sudo(self, command: str) -> bool:
        return bool(SUDO_PREFIX_RE.match(command or ""))

    def _has_inline_sudo(self, command: str) -> bool:
        if self._has_explicit_sudo(command):
            return False
        return bool(INLINE_SUDO_RE.search(command or ""))

    def _strip_leading_sudo(self, command: str) -> str:
        return SUDO_PREFIX_RE.sub("", command, count=1).strip() or "true"

    def _inject_inline_sudo_flags(self, command: str) -> str:
        # For sudo used inside shell chains, ensure stdin password mode is enabled.
        return INLINE_SUDO_RE.sub(r"\1\2 -A", command)

    def _create_askpass_helper(self) -> str:
        fd, path = tempfile.mkstemp(prefix="promptos-askpass-", text=True)
        try:
            with os.fdopen(fd, "w") as f:
                f.write("#!/usr/bin/env sh\n")
                f.write("printf '%s' \"$PROMPTOS_SUDO_PASS\"\n")
            os.chmod(path, 0o700)
        except Exception:
            try:
                os.remove(path)
            except OSError:
                pass
            raise
        return path

    def _should_retry_with_sudo(self, command: str, output: str) -> bool:
        text = (output or "").lower()
        if (
            "permission denied" in text
            or "must be root" in text
            or "are you root" in text
            or "a terminal is required to read the password" in text
            or "no tty present and no askpass program specified" in text
        ):
            return True
        try:
            parts = shlex.split(command)
        except ValueError:
            return False
        if not parts:
            return False
        privileged = {
            "pacman", "systemctl", "mount", "umount", "modprobe", "passwd",
            "useradd", "usermod", "userdel", "groupadd", "groupdel", "chown",
            "chmod", "tee", "cp", "mv", "rm",
        }
        return parts[0] in privileged and any(p.startswith("/etc/") or p.startswith("/usr/") for p in parts[1:])

    def _prompt_sudo_password(self) -> str | None:
        result: dict[str, str | None] = {"password": None}
        done = threading.Event()

        def _show_dialog():
            dialog = Gtk.Dialog()
            dialog.set_title("sudo authentication")
            dialog.set_transient_for(self)
            dialog.set_modal(True)
            dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
            dialog.add_button("OK", Gtk.ResponseType.OK)
            dialog.set_default_response(Gtk.ResponseType.OK)

            box = dialog.get_content_area()
            box.set_spacing(8)
            box.set_margin_top(10)
            box.set_margin_bottom(10)
            box.set_margin_start(10)
            box.set_margin_end(10)

            label = Gtk.Label(label="Enter your password for sudo:", xalign=0)
            entry = Gtk.Entry()
            entry.set_visibility(False)
            entry.set_invisible_char("*")
            entry.set_activates_default(True)
            box.append(label)
            box.append(entry)

            def _on_response(_dlg, response_id):
                if response_id == Gtk.ResponseType.OK:
                    result["password"] = entry.get_text()
                dialog.close()
                done.set()

            dialog.connect("response", _on_response)
            dialog.present()
            return False

        GLib.idle_add(_show_dialog)
        done.wait()
        return result["password"]

    def _set_suggested_next_items(self, items: list[str]):
        self.suggested_next_items = [i for i in items if i]
        self.suggested_next_text = self.suggested_next_items[0] if self.suggested_next_items else ""

        child = self.suggest_cards_box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.suggest_cards_box.remove(child)
            child = nxt

        if not self.suggested_next_items:
            placeholder = Gtk.Label(label="...", xalign=0)
            placeholder.set_margin_start(8)
            placeholder.set_margin_end(8)
            self.suggest_cards_box.append(placeholder)
            return

        for suggestion in self.suggested_next_items:
            btn = Gtk.Button()
            btn.add_css_class("flat")
            btn.add_css_class("promptos-btn")
            btn.connect("clicked", lambda _, s=suggestion: self._use_specific_suggestion(s))
            lbl = Gtk.Label(xalign=0)
            lbl.set_wrap(True)
            lbl.set_wrap_mode(Gtk.WrapMode.CHAR)
            lbl.set_max_width_chars(42)
            lbl.set_text(suggestion)
            lbl.set_margin_top(6)
            lbl.set_margin_bottom(6)
            lbl.set_margin_start(10)
            lbl.set_margin_end(10)
            btn.set_child(lbl)
            self.suggest_cards_box.append(btn)

    def _use_suggested_next(self):
        if not self.suggested_next_text:
            return
        self.entry.get_buffer().set_text(self.suggested_next_text)
        self.entry.grab_focus()

    def _use_specific_suggestion(self, suggestion: str):
        self.entry.get_buffer().set_text(suggestion)
        self.entry.grab_focus()

    def _on_entry_key_pressed(self, _controller, key, _keycode, state):
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if shift:
                return False  # Insert newline
            if not self.autorun_commands and self.pending_cards:
                self._run_next_pending_card_from_keyboard()
                return True
            self._submit()
            return True
        return False

    def _run_next_pending_card_from_keyboard(self):
        # Prefer a non-queued pending command first.
        for command in self.pending_cards.keys():
            if command not in self.command_queue:
                self._run_command_card(command)
                return
        for command in self.pending_cards.keys():
            self._run_command_card(command)
            return

    def _request_suggested_next_async(self):
        if not self.active_provider or len(self.history) < 2:
            return
        self._refresh_system_message()
        self.suggest_request_seq += 1
        req_id = self.suggest_request_seq
        GLib.idle_add(self._set_suggested_next, "Thinking...")

        snapshot = self.history[-8:]
        prompt = (
            "Suggest one short next user message for this conversation. "
            "Return only the suggested message, no quotes, no markdown, max 14 words."
        )
        messages = snapshot + [Message("user", prompt)]

        def _worker():
            try:
                text = "".join(self.active_provider.chat(messages, stream=False)).strip()
                GLib.idle_add(self._on_suggested_next_ready, req_id, text)
            except Exception:
                GLib.idle_add(self._on_suggested_next_ready, req_id, "")

        threading.Thread(target=_worker, daemon=True).start()

    def _on_suggested_next_ready(self, req_id: int, text: str):
        if req_id != self.suggest_request_seq:
            return False
        cleaned = text.strip().strip("`")
        items: list[str] = []
        for line in cleaned.splitlines():
            line = line.strip().lstrip("-").strip()
            if not line:
                continue
            line = line.strip('"').strip("'").strip()
            if line:
                items.append(line)
            if len(items) >= 4:
                break
        if not items and cleaned:
            single = cleaned.strip().strip('"').strip("'").strip()
            if single:
                items = [single]
        if not items:
            items = ["Ask me to inspect logs, services, or package updates."]
        self._set_suggested_next_items(items)
        return False


class PromptOSApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.promptos.ControlCenter")

    def do_activate(self):
        window = self.props.active_window
        if window is None:
            window = PromptOSWindow(self)
        window.present()


def main():
    app = PromptOSApp()
    app.run()


if __name__ == "__main__":
    main()
