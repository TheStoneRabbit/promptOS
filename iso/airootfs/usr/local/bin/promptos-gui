#!/usr/bin/env python3
"""
promptos-gui — graphical chat interface for promptOS.

Design goals:
- ChatGPT-like window layout (sidebar, chat thread, composer)
- No terminal transcript rendering
- Direct provider chat calls with streaming updates
- Optional CMD cards parsed from assistant responses
"""

from __future__ import annotations

