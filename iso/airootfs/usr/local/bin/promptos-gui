from providers import Message, get_provider, list_providers


CMD_RE = re.compile(r"^\s*CMD:\s*(.+?)\s*$", re.MULTILINE)
FENCED_CODE_RE = re.compile(r"```([a-zA-Z0-9_+-]+)?\n(.*?)```", re.DOTALL)
INLINE_CODE_RE = re.compile(r"`([^`\n]+)`")
STRONG_RE = re.compile(r"\*\*([^*\n]+)\*\*")
EM_RE = re.compile(r"(?<!\*)\*([^*\n]+)\*(?!\*)")
HEADING_RE = re.compile(r"^(#{1,6})\s+(.*)$")

APP_CSS = b"""
textview.code-block-view text {
  color: #d8dee9;
}
textview.output-block text {
  color: #9ad97d;
}
label.inline-code {
  font-family: monospace;
}
label.md-heading {
  font-weight: 700;
}
frame.user-bubble {
  background-image: linear-gradient(135deg, #5b2df8 0%, #8f6bff 55%, #b79bff 100%);
  border-radius: 14px;
}
frame.user-bubble > border {
  border-radius: 14px;
  border: 1px solid rgba(183, 155, 255, 0.55);
}
frame.user-bubble label {
  color: #ffffff;
}
button.promptos-btn {
  background-image: linear-gradient(135deg, #5b2df8 0%, #8f6bff 100%);
  color: #ffffff;
}
button.stop-btn {
  background-color: #c62828;
  color: #ffffff;
}
button.stop-btn:disabled {
  background-color: rgba(120, 120, 120, 0.4);
  color: rgba(240, 240, 240, 0.8);
}
scrolledwindow.composer-input {
  background-color: rgba(75, 85, 99, 0.28);
  border-radius: 12px;
  border: 1px solid rgba(107, 114, 128, 0.75);
}
scrolledwindow.composer-input > viewport {
  background-color: transparent;
  border-radius: 12px;
}
textview.composer-input-view {
  background-color: transparent;
  color: #e5e7eb;
}
"""

