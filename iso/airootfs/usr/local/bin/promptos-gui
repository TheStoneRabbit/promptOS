    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk, Pango, Gdk
except (ValueError, ImportError):
    print("promptos-gui requires gtk4 and libadwaita. Install: sudo pacman -S gtk4 libadwaita")
    raise SystemExit(1)

import sys

