#!/usr/bin/env python3
"""
promptsh — the promptOS AI shell.
Routes natural language through the configured AI provider (Claude, OpenAI, Groq, or Ollama).
Type /help for commands.
"""

import os
import sys
import subprocess
import threading
import time

# Add promptOS library to path
sys.path.insert(0, "/usr/local/lib/promptos")

from providers import get_provider, list_providers, Message
import providers as _providers_module

# ── Rich + prompt_toolkit (with fallback if not installed) ────────────────────
try:
    from rich.console import Console
    from rich.markdown import Markdown
    from rich.panel import Panel
    from rich.text import Text
    from rich import box
    RICH = True
    console = Console()
except ImportError:
    RICH = False

try:
    from prompt_toolkit import PromptSession
    from prompt_toolkit.styles import Style
    from prompt_toolkit.formatted_text import HTML
    from prompt_toolkit.history import FileHistory
    PROMPT_TOOLKIT = True
except ImportError:
    import readline
    PROMPT_TOOLKIT = False

HISTORY_FILE = os.path.expanduser("~/.promptsh_history")
AGENT_MD = "/usr/local/lib/promptos/AGENT.md"
AUTORUN = False  # set True to skip CMD: confirmation prompts

PROVIDER_COLORS = {
    "claude":       "bold magenta",
    "openai":       "bold green",
    "groq":         "bold cyan",
    "pollinations": "bold blue",
    "ollama":       "bold yellow",
}


def _start_spinner(message: str = "Initializing promptOS"):
    stop = threading.Event()
    frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

    def _spin():
        i = 0
        while not stop.is_set():
            print(f"\r{frames[i % len(frames)]}  {message}...", end="", flush=True)
            i += 1
            time.sleep(0.1)
        # Clear the spinner line
        print("\r" + " " * (len(message) + 8) + "\r", end="", flush=True)

    t = threading.Thread(target=_spin, daemon=True)
    t.start()
    return stop


def _load_agent_md() -> str:
    try:
        with open(AGENT_MD) as f:
            return f.read()
    except FileNotFoundError:
        return ""


SYSTEM_PROMPT_SUFFIX = """
---
## Current System Context
- OS: promptOS (Arch Linux based)
- Shell: promptsh
- User: root
- Hostname: {hostname}
- Uptime: {uptime}
- Disk: {disk}
"""


def load_config():
    for path in ("/etc/promptos/config", "/etc/promptos/keys"):
        if os.path.exists(path):
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, _, v = line.partition("=")
                        k, v = k.strip(), v.strip()
                        if v and not os.environ.get(k):
                            os.environ[k] = v


def get_system_prompt() -> str:
    import socket
    try:
        uptime = subprocess.check_output("uptime -p", shell=True, text=True).strip()
    except Exception:
        uptime = "unknown"
    try:
        disk = subprocess.check_output(
            "df -h / | awk 'NR==2{print $3\"/\"$2\" used (\"$5\")\"}'",
            shell=True, text=True).strip()
    except Exception:
        disk = "unknown"
    agent = _load_agent_md()
    suffix = SYSTEM_PROMPT_SUFFIX.format(
        hostname=socket.gethostname(),
        uptime=uptime,
        disk=disk,
    )
    return agent + suffix


def extract_commands(response: str) -> list[str]:
    cmds = []
    lines = response.splitlines()
    in_block = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("CMD:"):
            cmd = stripped[4:].strip().strip("`")
            if cmd:
                cmds.append(cmd)
        elif stripped.startswith("```"):
            in_block = not in_block
        elif in_block and stripped and not stripped.startswith("#"):
            cmds.append(stripped)
    return cmds


def run_commands(cmds: list[str], autorun: bool = False):
    for cmd in cmds:
        if RICH:
            console.print(f"\n[bold yellow]▶ {cmd}[/bold yellow]")
        else:
            print(f"\n\033[33m>> {cmd}\033[0m")

        if autorun:
            confirmed = True
        else:
            try:
                ans = (console.input("[dim]Run? \\[Y/n][/dim] ") if RICH else input("Run? [Y/n] ")).strip().lower()
                confirmed = ans in ("", "y", "yes")
            except EOFError:
                confirmed = False

        if confirmed:
            result = subprocess.run(cmd, shell=True)
            if result.returncode != 0:
                if RICH:
                    console.print(f"[red]Exited with code {result.returncode}[/red]")
                else:
                    print(f"\033[31mExited with code {result.returncode}\033[0m")
        else:
            print("Skipped.")


def print_banner(provider_name: str | None):
    try:
        logo = subprocess.check_output(
            ["figlet", "-f", "standard", "promptOS"], text=True, stderr=subprocess.DEVNULL
        )
    except Exception:
        logo = "promptOS"

    if RICH:
        color = PROVIDER_COLORS.get(provider_name, "bold white") if provider_name else "bold white"
        provider_str = f"[{color}]{provider_name}[/{color}]" if provider_name else "[yellow]no provider[/yellow]"
        console.print(f"[bold cyan]{logo}[/bold cyan]", end="")
        console.print(Panel(
            f"[dim]AI-Native Linux[/dim]  •  provider: {provider_str}\n"
            f"[dim]/help for commands  •  !cmd for bash  •  exit to quit[/dim]",
            border_style="dim",
            box=box.ROUNDED,
        ))
    else:
        print(f"\033[1;36m{logo}\033[0m")
        status = f"\033[1;32m{provider_name}\033[0m" if provider_name else "\033[33mno provider\033[0m"
        print(f"  AI-Native Linux  |  provider: {status}")
        print("  /help for commands  |  !cmd to run bash directly  |  exit to quit\n")


def print_help():
    if RICH:
        console.print(Panel(
            "[bold]promptsh commands[/bold]\n\n"
            "  [cyan]/providers[/cyan]         — list all providers and status\n"
            "  [cyan]/switch \\<name>[/cyan]     — switch provider (claude, openai, groq, pollinations, ollama)\n"
            "  [cyan]/clear[/cyan]             — clear conversation history\n"
            "  [cyan]/history[/cyan]           — show conversation history\n"
            "  [cyan]/autorun[/cyan]           — toggle auto-execute of AI commands (no confirmation)\n"
            "  [cyan]/keys[/cyan]              — manage API keys\n"
            "  [cyan]!\\<cmd>[/cyan]             — run bash command directly\n"
            "  [cyan]!!\\<prompt>[/cyan]          — send to AI and auto-run any commands it suggests\n"
            "  [cyan]exit / quit[/cyan]        — exit promptsh",
            title="Help",
            border_style="cyan",
            box=box.ROUNDED,
        ))
    else:
        print("""
  promptsh commands:
    /providers          — list all providers and their status
    /switch <name>      — switch active provider (claude, openai, groq, ollama)
    /clear              — clear conversation history
    /history            — show conversation history
    /keys               — manage API keys
    !<cmd>              — run a bash command directly, bypassing AI
    exit / quit         — exit promptsh
""")


def get_input(session) -> str:
    if PROMPT_TOOLKIT:
        style = Style.from_dict({"prompt": "bold ansigreen"})
        return session.prompt(HTML("<prompt>promptOS</prompt><ansiwhite>❯</ansiwhite> "), style=style).strip()
    else:
        return input("\001\033[1;32m\002promptOS❯\001\033[0m\002 ").strip()


def render_response(text: str, provider_name: str):
    if RICH:
        color = PROVIDER_COLORS.get(provider_name, "bold white")
        console.print(f"\n[{color}][{provider_name}][/{color}]")
        console.print(Markdown(text))
        console.print()
    else:
        print(f"\n\033[90m[{provider_name}]\033[0m")
        print(text)
        print()


def main():
    spinner = _start_spinner("Initializing promptOS")

    load_config()

    # Set up input session
    if PROMPT_TOOLKIT:
        session = PromptSession(history=FileHistory(HISTORY_FILE))
    else:
        try:
            readline.read_history_file(HISTORY_FILE)
        except FileNotFoundError:
            pass
        readline.set_history_length(1000)
        session = None

    override = os.environ.get("PROMPTOS_PROVIDER")
    provider = get_provider(None if override == "auto" else override)

    spinner.set()  # stop spinner before printing banner

    print_banner(provider.name if provider else None)

    history: list[Message] = [Message("system", get_system_prompt())]
    active_provider = provider
    autorun = AUTORUN

    def save_history():
        if not PROMPT_TOOLKIT:
            try:
                readline.write_history_file(HISTORY_FILE)
            except Exception:
                pass

    try:
        while True:
            try:
                user_input = get_input(session)
            except EOFError:
                print()
                break
            except KeyboardInterrupt:
                print()
                continue

            if not user_input:
                continue

            if user_input.lower() in ("exit", "quit"):
                break

            if user_input.startswith("!!"):
                # Auto-run: send to AI and execute commands without confirmation
                user_input = user_input[2:].strip()
                if not user_input:
                    continue
                _autorun_this = True
            else:
                _autorun_this = autorun

            if user_input.startswith("!"):
                subprocess.run(user_input[1:], shell=True)
                continue

            # Intercept install trigger before AI sees it
            if user_input.lower().strip() in ("install promptos", "install prompts"):
                subprocess.run(["promptos-install"])
                continue

            if user_input == "/help":
                print_help()
                continue

            if user_input == "/providers":
                if RICH:
                    for p in list_providers():
                        avail = "[green]available[/green]" if p["available"] else "[red]unavailable[/red]"
                        active = " [yellow](active)[/yellow]" if active_provider and p["name"] == active_provider.name else ""
                        console.print(f"  [bold]{p['name']:10}[/bold] {avail}{active}")
                    console.print()
                else:
                    for p in list_providers():
                        status = "\033[1;32mavailable\033[0m" if p["available"] else "\033[31munavailable\033[0m"
                        active = " \033[1;33m(active)\033[0m" if active_provider and p["name"] == active_provider.name else ""
                        print(f"  {p['name']:10} {status}{active}")
                    print()
                continue

            if user_input.startswith("/switch"):
                parts = user_input.split(None, 1)
                if len(parts) < 2:
                    # cycle to next available
                    providers = [p for p in list_providers() if p["available"]]
                    names = [p["name"] for p in providers]
                    if active_provider and active_provider.name in names:
                        idx = (names.index(active_provider.name) + 1) % len(names)
                        name = names[idx]
                    elif names:
                        name = names[0]
                    else:
                        print("No providers available.")
                        continue
                else:
                    name = parts[1].strip()
                try:
                    new_p = get_provider(name)
                except ValueError:
                    valid = list(_providers_module._REGISTRY.keys())
                    if RICH:
                        console.print(f"  [red]Unknown provider '{name}'. Choose from: {valid}[/red]\n")
                    else:
                        print(f"  \033[31mUnknown provider '{name}'. Choose from: {valid}\033[0m\n")
                    continue
                if new_p:
                    active_provider = new_p
                    if RICH:
                        console.print(f"  Switched to [bold green]{name}[/bold green]\n")
                    else:
                        print(f"  Switched to \033[1;32m{name}\033[0m\n")
                else:
                    if RICH:
                        console.print(f"  [red]{name} is not available (check API key or service)[/red]\n")
                    else:
                        print(f"  \033[31m{name} is not available\033[0m\n")
                continue

            if user_input == "/clear":
                history = [Message("system", get_system_prompt())]
                print("  Conversation history cleared.\n")
                continue

            if user_input == "/history":
                for m in history[1:]:
                    if RICH:
                        color = "green" if m.role == "user" else "white"
                        console.print(f"  [{color}]{m.role}[/{color}]: {m.content[:120]}{'...' if len(m.content) > 120 else ''}")
                    else:
                        role_color = "\033[1;32m" if m.role == "user" else "\033[1;37m"
                        print(f"  {role_color}{m.role}\033[0m: {m.content[:120]}{'...' if len(m.content) > 120 else ''}")
                print()
                continue

            if user_input in ("/autorun", "/autorun on", "/autorun off"):
                if user_input == "/autorun on" or (user_input == "/autorun" and not autorun):
                    autorun = True
                    if RICH:
                        console.print("  [yellow]Autorun ON[/yellow] — commands will execute without confirmation\n")
                    else:
                        print("  Autorun ON — commands will execute without confirmation\n")
                else:
                    autorun = False
                    if RICH:
                        console.print("  [green]Autorun OFF[/green] — commands will prompt before running\n")
                    else:
                        print("  Autorun OFF — commands will prompt before running\n")
                continue

            if user_input == "/keys":
                subprocess.run(["promptos-keys", "show"])
                print("\nUse: promptos-keys set <claude|openai|groq> <key>")
                continue

            if not active_provider:
                if RICH:
                    console.print("[red]No AI provider available. Set an API key with /keys or start ollama.[/red]")
                else:
                    print("\033[31mNo AI provider available.\033[0m")
                continue

            history.append(Message("user", user_input))

            try:
                # Stream response, collect chunks
                if RICH:
                    color = PROVIDER_COLORS.get(active_provider.name, "bold white")
                    console.print(f"\n[{color}][{active_provider.name}][/{color}] ", end="")
                else:
                    print(f"\n\033[90m[{active_provider.name}]\033[0m ", end="", flush=True)

                response_chunks = []
                for chunk in active_provider.chat(history, stream=True):
                    print(chunk, end="", flush=True)
                    response_chunks.append(chunk)

                response = "".join(response_chunks)
                print("\n")

                # Re-render with rich markdown if available
                if RICH and response_chunks:
                    # Clear the streamed text and re-render as markdown
                    # (move up and reprint — only if terminal supports it)
                    pass  # streaming already printed; markdown re-render on next response

                history.append(Message("assistant", response))

                cmds = extract_commands(response)
                if cmds:
                    run_commands(cmds, autorun=_autorun_this)

            except KeyboardInterrupt:
                if RICH:
                    console.print("\n[yellow][cancelled][/yellow]\n")
                else:
                    print("\n\033[33m[cancelled]\033[0m\n")
                history.pop()
            except Exception as e:
                if RICH:
                    console.print(f"\n[red]Provider error ({active_provider.name}): {e}[/red]")
                else:
                    print(f"\n\033[31mProvider error ({active_provider.name}): {e}\033[0m")
                history.pop()
                # Auto-fallback to next available provider
                all_p = list_providers()
                switched = False
                for p_info in all_p:
                    if p_info["available"] and p_info["name"] != active_provider.name:
                        new_p = get_provider(p_info["name"])
                        if new_p:
                            active_provider = new_p
                            if RICH:
                                color = PROVIDER_COLORS.get(new_p.name, "bold white")
                                console.print(f"[yellow]Auto-switching to [{color}]{new_p.name}[/{color}][/yellow] — resend your message\n")
                            else:
                                print(f"\033[33mAuto-switching to {new_p.name}\033[0m — resend your message\n")
                            switched = True
                            break
                if not switched:
                    if RICH:
                        console.print("[dim]Use /switch to try another provider, or !cmd to run bash directly.[/dim]\n")
                    else:
                        print("Use /switch to try another provider, or !cmd to run bash directly.\n")

    finally:
        save_history()


if __name__ == "__main__":
    main()
