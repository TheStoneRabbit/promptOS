    /model [pull]       — show local model status (or pull if missing)
    /install            — install promptOS to disk
    !<cmd>              — run a bash command directly, bypassing AI
    !!<prompt>          — send to AI and auto-run any commands it suggests
    exit / quit         — exit promptsh
""")


def _short_cwd() -> str:
    """Compact cwd for the prompt: '~' for home, '~/foo' for under home, basename otherwise."""
    cwd = os.getcwd()
    home = os.path.expanduser("~")
    if cwd == home:
        return "~"
    if cwd.startswith(home + "/"):
        return "~/" + cwd[len(home) + 1:]
    return cwd


def get_input(session) -> str:
    cwd = _short_cwd()
    if PROMPT_TOOLKIT:
        style = Style.from_dict({"prompt": "bold ansigreen", "cwd": "ansiblue"})
        return session.prompt(
            HTML(f"<prompt>promptOS</prompt> <cwd>{cwd}</cwd><ansiwhite>></ansiwhite> "),
            style=style,
        ).strip()
    else:
        return input(f"\001\033[1;32m\002promptOS\001\033[0m\002 \001\033[1;34m\002{cwd}\001\033[0m\002> ").strip()


def render_response(text: str, provider_name: str):
    if RICH:
        color = PROVIDER_COLORS.get(provider_name, "bold white")
        console.print(f"\n[{color}][{provider_name}][/{color}]")
        console.print(Markdown(text))
        console.print()
    else:
        print(f"\n\033[90m[{provider_name}]\033[0m")
        print(text)
        print()


def _ollama_model_installed() -> bool:
    """Quick check if the configured ollama model is downloaded locally."""
    try:
        out = subprocess.run(
            ["ollama", "list"],
            capture_output=True, text=True, timeout=3,
        ).stdout
    except Exception:
        return False
    target = os.environ.get("PROMPTOS_OLLAMA_MODEL", "mistral:7b-instruct")
    for line in out.splitlines()[1:]:
        if line.split()[:1] == [target]:
            return True
    return False


def _print_model_missing_notice():
    target = os.environ.get("PROMPTOS_OLLAMA_MODEL", "mistral:7b-instruct")
    if RICH:
        console.print(Panel(
            f"[yellow]Local model [bold]{target}[/bold] is not yet installed.[/yellow]\n\n"
            f"  • Connect to wifi: [cyan]/wifi[/cyan]\n"
            f"  • Then download:   [cyan]/model pull[/cyan]\n\n"
            f"[dim]Or use a cloud provider instead: [cyan]/setup[/cyan][/dim]",
            border_style="yellow",
            box=box.ROUNDED,
        ))
    else:
        print(f"\n\033[33mLocal model {target} is not yet installed.\033[0m")
        print("  Connect to wifi:  /wifi")
        print("  Then download:    /model pull")
        print("  Or use cloud:     /setup\n")


def _handle_shell_invocation():
    """Handle shell-style invocation when promptsh is set as a login shell.
    SSH non-interactive commands (`ssh host "cmd"`), rsync, ssh-copy-id, scripts,
    etc., all invoke the login shell as `<shell> -c "cmd"`. Without this,
    promptsh would just start a REPL and hang or ignore the command.

    Supported:
      promptsh -c "cmd [args...]"   → run cmd via /bin/bash, exit with its rc
      promptsh --version            → print version, exit
      promptsh --help               → print usage, exit
    Unknown flags (-i, -l, --noprofile, etc.) are silently ignored — they're
    standard for interactive shells and don't change anything for us.
    """
    argv = sys.argv[1:]
    if not argv:
        return
    if argv[0] in ("--help", "-h"):
        print("Usage: promptsh [-c CMD] [-i] [-l]\n"
              "  -c CMD    run CMD via bash and exit (shell-style)\n"
              "  -i, -l    interactive / login (default behavior)\n"
              "  --help    show this and exit")
        sys.exit(0)
    if argv[0] == "--version":
        print("promptsh 0.2")
        sys.exit(0)
    if "-c" in argv:
        idx = argv.index("-c")
        if idx + 1 >= len(argv):
            print("promptsh: -c: option requires an argument", file=sys.stderr)
            sys.exit(2)
        cmd = argv[idx + 1]
        # Pass remaining args through as $0, $1, ... like bash does for -c.
        bash_args = ["/bin/bash", "-c", cmd, *argv[idx + 2:]]
        sys.exit(subprocess.run(bash_args).returncode)
    # Anything else (-i, -l, --noprofile, …) → fall through to interactive REPL.


def main():
    _handle_shell_invocation()
    load_config()

    # Set up input session
    if PROMPT_TOOLKIT:
        session = PromptSession(
            history=FileHistory(HISTORY_FILE),
            completer=_BangCompleter() if not _BARE_TTY else None,
            complete_while_typing=False,
        )
    else:
        try:
            readline.read_history_file(HISTORY_FILE)
        except FileNotFoundError:
            pass
        readline.set_history_length(1000)
        # Enable tab completion: only fires when the line starts with `!`.
        readline.set_completer(_readline_completer)
        readline.set_completer_delims(" \t\n;")
        readline.parse_and_bind("tab: complete")
        session = None

    override = os.environ.get("PROMPTOS_PROVIDER")
    provider = get_provider(None if override == "auto" else override)

    print_banner(provider.name if provider else None)

    # If ollama is the active provider but the model isn't downloaded yet,
    # show a clear notice with the path to fix it.
    if provider and provider.name == "ollama" and not _ollama_model_installed():
        _print_model_missing_notice()

    history: list[Message] = [Message("system", get_system_prompt())]
    active_provider = provider
    autorun = AUTORUN
    ollama_warmed = False  # show a one-time "loading model" notice on first ollama prompt

    def save_history():
        if not PROMPT_TOOLKIT:
            try:
                readline.write_history_file(HISTORY_FILE)
            except Exception:
                pass

    try:
        while True:
            try:
                user_input = get_input(session)
            except EOFError:
                print()
                break
            except KeyboardInterrupt:
                print()
                continue

            if not user_input:
                continue

            if user_input.lower() in ("exit", "quit"):
                break

            persist_turn = True
            if user_input.startswith("!!"):
                # Auto-run: send to AI and execute commands without confirmation
                # but keep this bang-prefixed turn out of persistent AI context.
                user_input = user_input[2:].strip()
                if not user_input:
                    continue
                _autorun_this = True
                persist_turn = False
            else:
                _autorun_this = autorun

            if user_input.startswith("!"):
                bash_cmd = user_input[1:]
                # Intercept `cd` so it persists across commands.
                if is_pure_cd(bash_cmd):
                    ok, msg = builtin_cd(bash_cmd)
                    if not ok:
                        print(msg)
                    continue
                try:
                    subprocess.run(bash_cmd, shell=True)
                except KeyboardInterrupt:
                    print()
                continue

            # Intercept install trigger before AI sees it
            if user_input.lower().strip() in ("/install", "install promptos", "install prompts"):
                try:
                    subprocess.run(["promptos-install"])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-install not installed.\n")
                continue

            if user_input == "/help":
                print_help()
                continue

            if user_input == "/providers":
                if RICH:
                    for p in list_providers():
                        avail = "[green]available[/green]" if p["available"] else "[red]unavailable[/red]"
                        active = " [yellow](active)[/yellow]" if active_provider and p["name"] == active_provider.name else ""
                        console.print(f"  [bold]{p['name']:10}[/bold] {avail}{active}")
                    console.print()
                else:
                    for p in list_providers():
                        status = "\033[1;32mavailable\033[0m" if p["available"] else "\033[31munavailable\033[0m"
                        active = " \033[1;33m(active)\033[0m" if active_provider and p["name"] == active_provider.name else ""
                        print(f"  {p['name']:10} {status}{active}")
                    print()
                continue

            if user_input.startswith("/switch"):
                parts = user_input.split(None, 1)
                if len(parts) < 2:
                    # cycle to next available
                    providers = [p for p in list_providers() if p["available"]]
                    names = [p["name"] for p in providers]
                    if active_provider and active_provider.name in names:
                        idx = (names.index(active_provider.name) + 1) % len(names)
                        name = names[idx]
                    elif names:
                        name = names[0]
                    else:
                        print("No providers available.")
                        continue
                else:
                    name = parts[1].strip()
                try:
                    new_p = get_provider(name)
                except ValueError:
                    valid = list(_providers_module._REGISTRY.keys())
                    if RICH:
                        console.print(f"  [red]Unknown provider '{name}'. Choose from: {valid}[/red]\n")
                    else:
                        print(f"  \033[31mUnknown provider '{name}'. Choose from: {valid}\033[0m\n")
                    continue
                if new_p:
                    active_provider = new_p
                    if RICH:
                        console.print(f"  Switched to [bold green]{name}[/bold green]\n")
                    else:
                        print(f"  Switched to \033[1;32m{name}\033[0m\n")
                else:
                    if RICH:
                        console.print(f"  [red]{name} is not available (check API key or service)[/red]\n")
                    else:
                        print(f"  \033[31m{name} is not available\033[0m\n")
                continue

            if user_input == "/clear":
                history = [Message("system", get_system_prompt())]
                print("  Conversation history cleared.\n")
                continue

            if user_input == "/history":
                for m in history[1:]:
                    if RICH:
                        color = "green" if m.role == "user" else "white"
                        console.print(f"  [{color}]{m.role}[/{color}]: {m.content[:120]}{'...' if len(m.content) > 120 else ''}")
                    else:
                        role_color = "\033[1;32m" if m.role == "user" else "\033[1;37m"
                        print(f"  {role_color}{m.role}\033[0m: {m.content[:120]}{'...' if len(m.content) > 120 else ''}")
                print()
                continue

            if user_input.startswith("/save"):
                parts = user_input.split(None, 1)
                # Default name = ISO timestamp like 2026-04-26_17-30-00
                default_name = time.strftime("%Y-%m-%d_%H-%M-%S")
                name = parts[1].strip() if len(parts) > 1 else default_name
                try:
                    path = save_session(name, history)
                    if RICH:
                        console.print(f"  [green]Saved[/green] {len(history)} messages → [bold]{name}[/bold]")
                        console.print(f"  [dim]{path}[/dim]\n")
                    else:
                        print(f"  Saved {len(history)} messages → {name}")
                        print(f"  {path}\n")
                except OSError as e:
                    print(f"  Save failed: {e}\n")
                continue

            if user_input.startswith("/load"):
                parts = user_input.split(None, 1)
                if len(parts) < 2:
                    print("  Usage: /load <name>   (use /sessions to list)\n")
                    continue
                name = parts[1].strip()
                try:
                    history = load_session(name)
                    msg = f"  Loaded session [bold]{name}[/bold] ({len(history)} messages)"
                    if RICH:
                        console.print(f"  [green]{msg}[/green]\n")
                    else:
                        print(f"  Loaded session {name} ({len(history)} messages)\n")
                except FileNotFoundError:
                    print(f"  No saved session named '{name}'. Try /sessions to list.\n")
                except (OSError, _json.JSONDecodeError) as e:
                    print(f"  Load failed: {e}\n")
                continue

            if user_input == "/sessions":
                sessions = list_sessions()
                if not sessions:
                    print("  No saved sessions yet. Use /save [name] to save the current one.\n")
                    continue
                if RICH:
                    console.print("  [bold]Saved sessions[/bold]")
                    for n, count, mtime in sessions:
                        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(mtime))
                        console.print(f"  • [cyan]{n}[/cyan]  [dim]({count} messages, {when})[/dim]")
                    console.print()
                else:
                    print("  Saved sessions:")
                    for n, count, mtime in sessions:
                        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(mtime))
                        print(f"  - {n}  ({count} messages, {when})")
                    print()
                continue

            if user_input.startswith("/forget"):
                parts = user_input.split(None, 1)
                if len(parts) < 2:
                    print("  Usage: /forget <name>   (deletes a saved session)\n")
                    continue
                name = parts[1].strip()
                if forget_session(name):
                    print(f"  Forgot session '{name}'.\n")
                else:
                    print(f"  No saved session named '{name}'.\n")
                continue

            if user_input in ("/autorun", "/autorun on", "/autorun off"):
                if user_input == "/autorun on" or (user_input == "/autorun" and not autorun):
                    autorun = True
                    if RICH:
                        console.print("  [yellow]Autorun ON[/yellow] — commands will execute without confirmation\n")
                    else:
                        print("  Autorun ON — commands will execute without confirmation\n")
                else:
                    autorun = False
                    if RICH:
                        console.print("  [green]Autorun OFF[/green] — commands will prompt before running\n")
                    else:
                        print("  Autorun OFF — commands will prompt before running\n")
                continue

            if user_input == "/keys":
                try:
                    subprocess.run(["promptos-keys", "show"])
                    print("\nUse /setup for an interactive walkthrough,")
                    print("or: promptos-keys set <claude|openai|groq> <key>")
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-keys not installed.\n")
                continue

            if user_input == "/setup":
                try:
                    subprocess.run(["promptos-keys", "setup"])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-keys not installed.\n")
                continue

            if user_input == "/wifi":
                try:
                    subprocess.run(["promptos-wifi"])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-wifi not installed.\n")
                continue

            if user_input.startswith("/model"):
                parts = user_input.split(None, 1)
                sub = parts[1].strip() if len(parts) > 1 else "status"
                try:
                    subprocess.run(["promptos-model", sub])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-model not installed.\n")
                continue

            if not active_provider:
                if RICH:
                    console.print("[red]No AI provider available. Set an API key with /keys or start ollama.[/red]")
                else:
                    print("\033[31mNo AI provider available.\033[0m")
                continue

            turn_history = history if persist_turn else history.copy()
            turn_history.append(Message("user", user_input))

            # First-prompt warning for ollama: the system prompt is large, so the
            # first request pays a significant prompt-processing cost on CPU
            # (10-30s on a 4-core laptop CPU). Subsequent prompts reuse the cache
            # and feel snappy. Tell the user to be patient.
            if active_provider.name == "ollama" and not ollama_warmed:
                if RICH:
                    console.print("[dim]Processing first prompt — please wait, this can take 10-30s on slow CPUs (subsequent prompts will be much faster).[/dim]")
                else:
                    print("\033[2mProcessing first prompt — please wait (10-30s on slow CPUs); subsequent prompts will be much faster.\033[0m")
                ollama_warmed = True

            # Loop: AI may emit commands → we run them → feed results back → ask AI
            # again to interpret/continue. Capped to keep the AI from spinning forever.
            MAX_AGENT_TURNS = 15
            agent_turn = 0
            try:
                while True:
                    # Stream response, collect chunks
                    response_chunks = []
                    if RICH:
                        color = PROVIDER_COLORS.get(active_provider.name, "bold white")
                        console.print(f"\n[{color}][{active_provider.name}][/{color}]")
                        # Live re-renders the accumulating markdown as chunks arrive,
                        # so the user sees rich formatting (bold, code blocks, lists)
                        # instead of raw markdown text.
                        with Live(
                            Markdown(""),
                            console=console,
                            refresh_per_second=8,
                            vertical_overflow="visible",
                        ) as live:
                            for chunk in active_provider.chat(turn_history, stream=True):
                                response_chunks.append(chunk)
                                live.update(Markdown("".join(response_chunks)))
                        response = "".join(response_chunks)
                        console.print()
                    else:
                        print(f"\n\033[90m[{active_provider.name}]\033[0m ", end="", flush=True)
                        for chunk in active_provider.chat(turn_history, stream=True):
                            print(chunk, end="", flush=True)
                            response_chunks.append(chunk)
                        response = "".join(response_chunks)
                        print("\n")

                    turn_history.append(Message("assistant", response))

                    cmds = extract_commands(response)
                    if not cmds:
                        # AI didn't emit any commands — task is finished or it's
                        # just talking. Hand control back to the user.
                        break

                    results = run_commands(cmds, autorun=_autorun_this)
                    # Feed command results back into history so AI knows what happened
                    feedback_lines = ["[command results]"]
                    for r in results:
                        if r["exit_code"] is None:
                            feedback_lines.append(f"  $ {r['cmd']} → skipped by user")
                        elif r["exit_code"] == 0:
                            feedback_lines.append(f"  $ {r['cmd']} → success (exit 0)")
                        else:
                            feedback_lines.append(f"  $ {r['cmd']} → FAILED (exit {r['exit_code']})")
                        if r["output"].strip():
                            feedback_lines.append(f"    output: {r['output'].strip()[:500]}")
                    turn_history.append(Message("user", "\n".join(feedback_lines)))

                    # If the user skipped every command, the AI has nothing new to
                    # work with — break instead of looping forever on stale input.
                    if all(r["exit_code"] is None for r in results):
                        break

                    agent_turn += 1
                    if agent_turn >= MAX_AGENT_TURNS:
                        if RICH:
                            console.print(f"[yellow]Reached {MAX_AGENT_TURNS}-turn auto-loop limit. Type 'continue' to keep going.[/yellow]\n")
                        else:
                            print(f"\033[33mReached {MAX_AGENT_TURNS}-turn auto-loop limit. Type 'continue' to keep going.\033[0m\n")
                        break

            except KeyboardInterrupt:
                if RICH:
                    console.print("\n[yellow][cancelled][/yellow]\n")
                else:
                    print("\n\033[33m[cancelled]\033[0m\n")
                turn_history.pop()
            except Exception as e:
                if RICH:
                    console.print(f"\n[red]Provider error ({active_provider.name}): {e}[/red]")
                else:
                    print(f"\n\033[31mProvider error ({active_provider.name}): {e}\033[0m")
                turn_history.pop()
                # Auto-fallback to next available provider
                all_p = list_providers()
                switched = False
                for p_info in all_p:
                    if p_info["available"] and p_info["name"] != active_provider.name:
                        new_p = get_provider(p_info["name"])
                        if new_p:
                            active_provider = new_p
                            if RICH:
                                color = PROVIDER_COLORS.get(new_p.name, "bold white")
                                console.print(f"[yellow]Auto-switching to [{color}]{new_p.name}[/{color}][/yellow] — resend your message\n")
                            else:
                                print(f"\033[33mAuto-switching to {new_p.name}\033[0m — resend your message\n")
                            switched = True
                            break
                if not switched:
                    if RICH:
                        console.print("[dim]Use /switch to try another provider, or !cmd to run bash directly.[/dim]\n")
                    else:
                        print("Use /switch to try another provider, or !cmd to run bash directly.\n")

    finally:
        save_history()


if __name__ == "__main__":
    main()
