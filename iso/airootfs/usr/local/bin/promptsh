def print_model_verification(active_provider):
    if not active_provider:
        if RICH:
            console.print("  [yellow]No active provider.[/yellow]\n")
        else:
            print("  No active provider.\n")
        return

    active_name = active_provider.name
    active_model = _provider_model(active_provider) or "(unknown)"
    override = os.environ.get("PROMPTOS_PROVIDER", "auto")

    lines = [
        "Model verification:",
        f"  active provider: {active_name}",
        f"  active model:    {active_model}",
        f"  provider config: {override}",
        f"  available:       {'yes' if active_provider.available() else 'no'}",
    ]
    usage_fn = getattr(active_provider, "usage_summary", None)
    if callable(usage_fn) and usage_fn():
        lines.append(f"  tokens:          {usage_fn()}")
    lines += [
        "",
        "Configured models:",
    ]
    for p in list_providers():
        marker = " *" if p["name"] == active_name else "  "
        status = "available" if p["available"] else "unavailable"
        model = p.get("model") or "(unset)"
        lines.append(f"{marker} {p['name']:8} {model} ({status})")

    text = "\n".join(lines)
    if RICH:
        console.print(Panel(text, title="Verify Model", border_style="green", box=box.ROUNDED))
    else:
        print(text + "\n")


def _short_cwd() -> str:
    """Compact cwd for the prompt: '~' for home, '~/foo' for under home, basename otherwise."""
    cwd = os.getcwd()
    home = os.path.expanduser("~")
    if cwd == home:
        return "~"
    if cwd.startswith(home + "/"):
        return "~/" + cwd[len(home) + 1:]
    return cwd


def get_input(session, default: str = "") -> str:
    cwd = _short_cwd()
    if PROMPT_TOOLKIT:
        style = Style.from_dict({"prompt": "bold ansigreen", "cwd": "ansiblue"})
        return session.prompt(
            HTML(f"<prompt>promptOS</prompt> <cwd>{cwd}</cwd><ansiwhite>></ansiwhite> "),
            style=style,
            default=default,
        ).strip()
    else:
        if default:
            readline.set_startup_hook(lambda: readline.insert_text(default))
        try:
            return input(f"\001\033[1;32m\002promptOS\001\033[0m\002 \001\033[1;34m\002{cwd}\001\033[0m\002> ").strip()
        finally:
            if default:
                readline.set_startup_hook(None)


# ── Message queue + type-ahead ────────────────────────────────────────────────
# While the AI is streaming a reply you can already type the next message.
# Keystrokes are captured raw (terminal echo off, so they don't smear into the
# streamed markdown) and rendered on a "› " line under the live response; Enter
# queues the line. Queued messages are sent one by one after the current turn
# finishes, and can be listed/edited/removed with /queue at any time — including
# while the AI is still working, by typing the /queue command on that same line.
#
# Only active in Rich mode on a real TTY (the bare Linux console has no live
# region to draw the input line in). Type-ahead is paused while commands run
# and while "Run this?" prompts are up, so those keep owning stdin.

QUEUE_USAGE = (
    "  /queue                 list queued messages\n"
    "  /queue add <text>      queue a message\n"
    "  /queue edit <n> <text> replace message n\n"
    "  /queue edit <n>        pull message n into the prompt to edit it\n"
    "  /queue rm <n>          remove message n\n"
    "  /queue clear           remove all\n"
    "  Tip: just start typing while the AI is responding — Enter queues it.\n"
)


def _format_queue(queue: list[str]) -> str:
    if not queue:
        return ("  Nothing queued. Start typing while the AI is responding and press Enter,\n"
                "  or use /queue add <text>.\n")
    width = _term_cols() - 8
    lines = [f"  {i}. {_clip(q, width)}" for i, q in enumerate(queue, 1)]
    return "\n".join(lines) + "\n  /queue edit <n> · /queue rm <n> · /queue clear\n"


def handle_queue_command(queue: list[str], line: str):
    """Mutate `queue` per a /queue command. Returns a message to print, or
    ("edit", text) when the caller should put `text` into the prompt for editing."""
    parts = line.strip().split(None, 2)
    sub = parts[1].lower() if len(parts) > 1 else "list"
    arg = parts[2].strip() if len(parts) > 2 else ""
    if sub in ("list", "ls", "show"):
        return _format_queue(queue)
    if sub == "add":
        if not arg:
            return QUEUE_USAGE
        queue.append(arg)
        return f"  Queued #{len(queue)}: {_clip(arg, _term_cols() - 16)}\n"
    if sub == "clear":
        n = len(queue)
        queue.clear()
        return f"  Cleared {n} queued message{'s' if n != 1 else ''}.\n"
    if sub in ("rm", "remove", "del", "delete", "edit"):
        num_str, _, rest = arg.partition(" ")
        try:
            n = int(num_str)
            if not 1 <= n <= len(queue):
                raise ValueError
        except ValueError:
            return (f"  Give a number from 1 to {len(queue)}.\n" if queue else "  Nothing queued.\n") + QUEUE_USAGE
        if sub == "edit":
            rest = rest.strip()
            if rest:
                queue[n - 1] = rest
                return f"  Updated #{n}: {_clip(rest, _term_cols() - 16)}\n"
            return ("edit", queue.pop(n - 1))
        removed = queue.pop(n - 1)
        return f"  Removed #{n}: {_clip(removed, _term_cols() - 16)}\n"
    return QUEUE_USAGE


def _is_queue_command(line: str) -> bool:
    return line in ("/q", "/queue") or line.startswith("/q ") or line.startswith("/queue ")


class TypeAhead:
    """Capture the next message while a response streams. See module notes."""

    def __init__(self, queue: list[str]):
        self.queue = queue
        self.buffer = ""
        self.on_change = lambda: None
        self.enabled = False
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._saved = None
        self._fd = None

    def __enter__(self):
        self._stop.clear()   # reusable across commands in one run_commands call
        if not (RICH and sys.stdin.isatty()):
            return self
        try:
            import termios
            self._fd = sys.stdin.fileno()
            self._saved = termios.tcgetattr(self._fd)
            raw = termios.tcgetattr(self._fd)
            raw[3] &= ~(termios.ECHO | termios.ICANON)   # keep ISIG: Ctrl-C still interrupts
            raw[6][termios.VMIN] = 1
            raw[6][termios.VTIME] = 0
            termios.tcsetattr(self._fd, termios.TCSANOW, raw)
        except Exception:
            self._saved = None
            return self
        self.enabled = True
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()
        return self

    def __exit__(self, *exc):
        self._stop.set()
        if self._thread:
            self._thread.join(timeout=1)
        if self._saved is not None:
            try:
                import termios
                termios.tcsetattr(self._fd, termios.TCSADRAIN, self._saved)
            except Exception:
                pass
        return False

    def _run(self):
        import select as _sel
        while not self._stop.is_set():
            try:
                ready, _, _ = _sel.select([self._fd], [], [], 0.1)
            except Exception:
                return
            if not ready:
                continue
            try:
                data = os.read(self._fd, 256).decode("utf-8", "replace")
            except Exception:
                return
            changed = False
            i = 0
            while i < len(data):
                c = data[i]
                if c == "\x1b":
                    # Skip escape sequences (arrow keys etc.): ESC [ ... <letter|~>
                    j = i + 1
                    while j < len(data) and not (data[j].isalpha() or data[j] == "~"):
                        j += 1
                    i = j + 1
                    continue
                if c in ("\r", "\n"):
                    line = self.buffer.strip()
                    self.buffer = ""
                    if line:
                        self._submit(line)
                    changed = True
                elif c in ("\x7f", "\x08"):
                    self.buffer = self.buffer[:-1]
                    changed = True
                elif c == "\x15":            # Ctrl-U clears the line
                    self.buffer = ""
                    changed = True
                elif c.isprintable():
                    self.buffer += c
                    changed = True
                i += 1
            if changed:
                try:
                    self.on_change()
                except Exception:
                    pass

    def _submit(self, line: str):
        if _is_queue_command(line):
            result = handle_queue_command(self.queue, line)
            if isinstance(result, tuple):      # bare "edit n" mid-stream: put it back
                self.queue.append(result[1])
        else:
            self.queue.append(line)

    def renderables(self) -> list:
        """Rich renderables for the queue + input line, shown under the live reply."""
        if not self.enabled:
            return []
        out = []
        if self.queue:
            width = max(20, _term_cols() - 12)
            t = Text("queued  ", style="dim")
            for i, q in enumerate(self.queue, 1):
                t.append(f"{i}. ", style="dim cyan")
                t.append(_clip(q, max(10, width // max(1, len(self.queue)) - 4)) + "   ", style="dim")
            out.append(t)
        if self.buffer or self.queue:
            t = Text("› ", style="bold cyan")
            t.append(self.buffer)
            t.append("▌", style="dim")
            out.append(t)
        return out


class _TurnStatus:
    """Animated status line under the live reply, so it's obvious the turn is
    still running (typing now has consequences) and what Enter will do."""

    def __init__(self, typeahead: "TypeAhead"):
        self.typeahead = typeahead
        self.started = time.monotonic()
        self.writing = False          # flips once the first token arrives

    def __rich_console__(self, console, options):
        frames = "|/-\\" if _BARE_TTY else "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        elapsed = time.monotonic() - self.started
        frame = frames[int(elapsed * 10) % len(frames)]
        label = "writing…" if self.writing else "thinking…"
        t = Text(f"{frame} {label} {int(elapsed)}s", style="dim cyan")
        if self.typeahead.buffer.strip():
            t.append("   ↵ queues it; this reply's commands will be skipped", style="yellow")
        elif self.typeahead.queue:
            t.append("   message queued; this reply's commands will be skipped", style="yellow")
        yield t


def _compose_live(markdown_text: str, typeahead: "TypeAhead", status: "_TurnStatus | None" = None):
    extras = typeahead.renderables()
    if not extras and status is None:
        return Markdown(markdown_text)
    parts = [Markdown(markdown_text), Text("")] if markdown_text else []
    if status is not None:
        parts.append(status)
    if extras:
        parts += [Text(""), *extras]
    return Group(*parts)


def _print_dequeued(text: str, remaining: int):
    """Echo a queued message as it is sent, so the transcript reads naturally."""
    more = f"  ({remaining} more queued)" if remaining else ""
    if RICH:
        console.print(f"[bold cyan]›[/bold cyan] {rich_escape(text)}[dim]{more}[/dim]")
    else:
        print(f"> {text}{more}")


def render_response(text: str, provider_name: str):
    if RICH:
        color = PROVIDER_COLORS.get(provider_name, "bold white")
        console.print(f"\n[{color}][{provider_name}][/{color}]")
        console.print(Markdown(text))
        console.print()
    else:
        print(f"\n\033[90m[{provider_name}]\033[0m")
        print(text)
        print()


def _ollama_model_installed() -> bool:
    """Quick check if the configured ollama model is downloaded locally."""
    try:
        out = subprocess.run(
            ["ollama", "list"],
            capture_output=True, text=True, timeout=3,
        ).stdout
    except Exception:
        return False
    target = os.environ.get("PROMPTOS_OLLAMA_MODEL", "qwen3:8b")
    for line in out.splitlines()[1:]:
        if line.split()[:1] == [target]:
            return True
    return False


def _print_model_missing_notice():
    target = os.environ.get("PROMPTOS_OLLAMA_MODEL", "qwen3:8b")
    if RICH:
        console.print(Panel(
            f"[yellow]Local model [bold]{target}[/bold] is not yet installed.[/yellow]\n\n"
            f"  • Connect to wifi: [cyan]/wifi[/cyan]\n"
            f"  • Then download:   [cyan]/model pull[/cyan]\n\n"
            f"[dim]Or use a cloud provider instead: [cyan]/setup[/cyan][/dim]",
            border_style="yellow",
            box=box.ROUNDED,
        ))
    else:
        print(f"\n\033[33mLocal model {target} is not yet installed.\033[0m")
        print("  Connect to wifi:  /wifi")
        print("  Then download:    /model pull")
        print("  Or use cloud:     /setup\n")


def _print_provider_unavailable_notice(name: str):
    hint = "no API key set" if name in ("claude", "openai", "groq") else "not running"
    if RICH:
        console.print(Panel(
            f"[yellow]Configured provider [bold]{name}[/bold] is unavailable ({hint}).[/yellow]\n\n"
            f"  • Connect to wifi: [cyan]/wifi[/cyan]\n"
            f"  • Add a key:       [cyan]/setup[/cyan]\n\n"
            f"[dim]Or go offline with the local model: [cyan]/switch ollama[/cyan] then [cyan]/model pull[/cyan][/dim]",
            border_style="yellow",
            box=box.ROUNDED,
        ))
    else:
        print(f"\n\033[33mConfigured provider {name} is unavailable ({hint}).\033[0m")
        print("  Connect to wifi:  /wifi")
        print("  Add a key:        /setup")
        print("  Or go offline:    /switch ollama, then /model pull\n")


def _handle_shell_invocation():
    """Handle shell-style invocation when promptsh is set as a login shell.
    SSH non-interactive commands (`ssh host "cmd"`), rsync, ssh-copy-id, scripts,
    etc., all invoke the login shell as `<shell> -c "cmd"`. Without this,
    promptsh would just start a REPL and hang or ignore the command.

    Supported:
      promptsh -c "cmd [args...]"   → run cmd via /bin/bash, exit with its rc
      promptsh --version            → print version, exit
      promptsh --help               → print usage, exit
    Unknown flags (-i, -l, --noprofile, etc.) are silently ignored — they're
    standard for interactive shells and don't change anything for us.
    """
    argv = sys.argv[1:]
    if not argv:
        return
    if argv[0] in ("--help", "-h"):
        print("Usage: promptsh [-c CMD] [-i] [-l]\n"
              "  -c CMD    run CMD via bash and exit (shell-style)\n"
              "  -i, -l    interactive / login (default behavior)\n"
              "  --help    show this and exit")
        sys.exit(0)
    if argv[0] == "--version":
        print("promptsh 0.2")
        sys.exit(0)
    if "-c" in argv:
        idx = argv.index("-c")
        if idx + 1 >= len(argv):
            print("promptsh: -c: option requires an argument", file=sys.stderr)
            sys.exit(2)
        cmd = argv[idx + 1]
        # Pass remaining args through as $0, $1, ... like bash does for -c.
        bash_args = ["/bin/bash", "-c", cmd, *argv[idx + 2:]]
        sys.exit(subprocess.run(bash_args).returncode)
    # Anything else (-i, -l, --noprofile, …) → fall through to interactive REPL.


def main():
    _handle_shell_invocation()
    load_config()

    # Set up input session
    if PROMPT_TOOLKIT:
        session = PromptSession(
            history=FileHistory(HISTORY_FILE),
            completer=_BangCompleter() if not _BARE_TTY else None,
            complete_while_typing=False,
        )
    else:
        try:
            readline.read_history_file(HISTORY_FILE)
        except FileNotFoundError:
            pass
        readline.set_history_length(1000)
        # Enable tab completion: only fires when the line starts with `!`.
        readline.set_completer(_readline_completer)
        readline.set_completer_delims(" \t\n;")
        readline.parse_and_bind("tab: complete")
        session = None

    override = os.environ.get("PROMPTOS_PROVIDER")
    provider = get_provider(None if override == "auto" else override)

    print_banner(provider)

    # If ollama is the active provider but the model isn't downloaded yet,
    # show a clear notice with the path to fix it.
    if provider and provider.name == "ollama" and not _ollama_model_installed():
        _print_model_missing_notice()

    # Default provider is claude, which needs an API key. On a fresh boot with no
    # key the override resolves to None — point the user at /setup instead of
    # silently showing "no provider".
    if provider is None and override not in (None, "", "auto"):
        _print_provider_unavailable_notice(override)

    history: list[Message] = [Message("system", get_system_prompt())]
    active_provider = provider
    autorun = _load_autorun_default()
    _set_output_mode(_load_output_mode())
    ollama_warmed = False  # show a one-time "loading model" notice on first ollama prompt

    def save_history():
        if not PROMPT_TOOLKIT:
            try:
                readline.write_history_file(HISTORY_FILE)
            except Exception:
                pass

    message_queue: list[str] = []   # next messages, sent one per turn
    pending_input = ""              # text to prefill the prompt with

    try:
        while True:
            try:
                if message_queue and not pending_input:
                    user_input = message_queue.pop(0)
                    _print_dequeued(user_input, len(message_queue))
                else:
                    user_input = get_input(session, default=pending_input)
                    pending_input = ""
            except EOFError:
                print()
                break
            except KeyboardInterrupt:
                print()
                continue

            if not user_input:
                continue

            if user_input.lower() in ("exit", "quit"):
                break

            if _is_queue_command(user_input):
                result = handle_queue_command(message_queue, user_input)
                if isinstance(result, tuple):   # ("edit", text): hand it to the prompt
                    pending_input = result[1]
                else:
                    print(result)
                continue

            persist_turn = True
            if user_input.startswith("!!"):
                # Auto-run: send to AI and execute commands without confirmation
                # but keep this bang-prefixed turn out of persistent AI context.
                user_input = user_input[2:].strip()
                if not user_input:
                    continue
                _autorun_this = True
                persist_turn = False
            else:
                _autorun_this = autorun

            if user_input.startswith("!"):
                bash_cmd = user_input[1:]
                # Intercept `cd` so it persists across commands.
                if is_pure_cd(bash_cmd):
                    ok, msg = builtin_cd(bash_cmd)
                    if not ok:
                        print(msg)
                    continue
                try:
                    subprocess.run(bash_cmd, shell=True)
                except KeyboardInterrupt:
                    print()
                continue

            # Intercept install trigger before AI sees it
            if user_input.lower().strip() in ("/install", "install promptos", "install prompts"):
                try:
                    subprocess.run(["promptos-install"])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-install not installed.\n")
                continue

            if user_input == "/help":
                print_help()
                continue

            if user_input == "/providers":
                reload_config()
                if RICH:
                    for p in list_providers():
                        avail = "[green]available[/green]" if p["available"] else "[red]unavailable[/red]"
                        model = f" [dim]{p['model']}[/dim]" if p.get("model") else ""
                        active = " [yellow](active)[/yellow]" if active_provider and p["name"] == active_provider.name else ""
                        console.print(f"  [bold]{p['name']:10}[/bold] {avail}{model}{active}")
                    console.print()
                else:
                    for p in list_providers():
                        status = "\033[1;32mavailable\033[0m" if p["available"] else "\033[31munavailable\033[0m"
                        model = f" {p['model']}" if p.get("model") else ""
                        active = " \033[1;33m(active)\033[0m" if active_provider and p["name"] == active_provider.name else ""
                        print(f"  {p['name']:10} {status}{model}{active}")
                    print()
                continue

            if user_input == "/verify-model":
                reload_config()
                prev = active_provider
                active_provider = get_provider(None if os.environ.get("PROMPTOS_PROVIDER") == "auto" else os.environ.get("PROMPTOS_PROVIDER"))
                # get_provider() builds a fresh instance with empty last_usage;
                # carry over the previous request's usage so the tokens line shows.
                if (prev is not None and active_provider is not None
                        and prev.name == active_provider.name
                        and getattr(prev, "last_usage", None)):
                    active_provider.last_usage = prev.last_usage
                print_model_verification(active_provider)
                continue

            if user_input.startswith("/llm-model"):
                active_provider = handle_llm_model_command(user_input, active_provider)
                continue

            if user_input.startswith("/switch"):
                reload_config()
                parts = user_input.split(None, 1)
                if len(parts) < 2:
                    # cycle to next available
                    providers = [p for p in list_providers() if p["available"]]
                    names = [p["name"] for p in providers]
                    if active_provider and active_provider.name in names:
                        idx = (names.index(active_provider.name) + 1) % len(names)
                        name = names[idx]
                    elif names:
                        name = names[0]
                    else:
                        print("No providers available.")
                        continue
                else:
                    name = parts[1].strip()
                try:
                    new_p = get_provider(name)
                except ValueError:
                    valid = list(_providers_module._REGISTRY.keys())
                    if RICH:
                        console.print(f"  [red]Unknown provider '{name}'. Choose from: {valid}[/red]\n")
                    else:
                        print(f"  \033[31mUnknown provider '{name}'. Choose from: {valid}\033[0m\n")
                    continue
                if new_p:
                    active_provider = new_p
                    model = _provider_model(active_provider)
                    model_suffix = f" ({model})" if model else ""
                    if RICH:
                        console.print(f"  Switched to [bold green]{name}[/bold green]{model_suffix}\n")
                    else:
                        print(f"  Switched to \033[1;32m{name}\033[0m{model_suffix}\n")
                else:
                    if RICH:
                        console.print(f"  [red]{name} is not available (check API key or service)[/red]\n")
                    else:
                        print(f"  \033[31m{name} is not available\033[0m\n")
                continue

            if user_input == "/clear":
                history = [Message("system", get_system_prompt())]
                print("  Conversation history cleared.\n")
                continue

            if user_input == "/history":
                for m in history[1:]:
                    if RICH:
                        color = "green" if m.role == "user" else "white"
                        console.print(f"  [{color}]{m.role}[/{color}]: {m.content[:120]}{'...' if len(m.content) > 120 else ''}")
                    else:
                        role_color = "\033[1;32m" if m.role == "user" else "\033[1;37m"
                        print(f"  {role_color}{m.role}\033[0m: {m.content[:120]}{'...' if len(m.content) > 120 else ''}")
                print()
                continue

            if user_input.startswith("/save"):
                parts = user_input.split(None, 1)
                # Default name = ISO timestamp like 2026-04-26_17-30-00
                default_name = time.strftime("%Y-%m-%d_%H-%M-%S")
                name = parts[1].strip() if len(parts) > 1 else default_name
                try:
                    path = save_session(name, history)
                    if RICH:
                        console.print(f"  [green]Saved[/green] {len(history)} messages → [bold]{name}[/bold]")
                        console.print(f"  [dim]{path}[/dim]\n")
                    else:
                        print(f"  Saved {len(history)} messages → {name}")
                        print(f"  {path}\n")
                except OSError as e:
                    print(f"  Save failed: {e}\n")
                continue

            if user_input.startswith("/load"):
                parts = user_input.split(None, 1)
                if len(parts) < 2:
                    print("  Usage: /load <name>   (use /sessions to list)\n")
                    continue
                name = parts[1].strip()
                try:
                    history = load_session(name)
                    msg = f"  Loaded session [bold]{name}[/bold] ({len(history)} messages)"
                    if RICH:
                        console.print(f"  [green]{msg}[/green]\n")
                    else:
                        print(f"  Loaded session {name} ({len(history)} messages)\n")
                except FileNotFoundError:
                    print(f"  No saved session named '{name}'. Try /sessions to list.\n")
                except (OSError, _json.JSONDecodeError) as e:
                    print(f"  Load failed: {e}\n")
                continue

            if user_input == "/sessions":
                sessions = list_sessions()
                if not sessions:
                    print("  No saved sessions yet. Use /save [name] to save the current one.\n")
                    continue
                if RICH:
                    console.print("  [bold]Saved sessions[/bold]")
                    for n, count, mtime in sessions:
                        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(mtime))
                        console.print(f"  • [cyan]{n}[/cyan]  [dim]({count} messages, {when})[/dim]")
                    console.print()
                else:
                    print("  Saved sessions:")
                    for n, count, mtime in sessions:
                        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(mtime))
                        print(f"  - {n}  ({count} messages, {when})")
                    print()
                continue

            if user_input.startswith("/forget"):
                parts = user_input.split(None, 1)
                if len(parts) < 2:
                    print("  Usage: /forget <name>   (deletes a saved session)\n")
                    continue
                name = parts[1].strip()
                if forget_session(name):
                    print(f"  Forgot session '{name}'.\n")
                else:
                    print(f"  No saved session named '{name}'.\n")
                continue

            if user_input in ("/autorun", "/autorun on", "/autorun off"):
                if user_input == "/autorun on" or (user_input == "/autorun" and not autorun):
                    autorun = True
                    _save_autorun_default(autorun)
                    if RICH:
                        console.print("  [yellow]Autorun ON[/yellow] — commands will execute without confirmation (saved)\n")
                    else:
                        print("  Autorun ON — commands will execute without confirmation (saved)\n")
                else:
                    autorun = False
                    _save_autorun_default(autorun)
                    if RICH:
                        console.print("  [green]Autorun OFF[/green] — commands will prompt before running (saved)\n")
                    else:
                        print("  Autorun OFF — commands will prompt before running (saved)\n")
                continue

            if user_input == "/out" or user_input.startswith("/out "):
                show_output_log(user_input[4:])
                continue

            if user_input in ("/quiet", "/compact", "/verbose", "/verbose on", "/verbose off", "/output") or user_input.startswith("/output "):
                if user_input == "/output":
                    new_mode = ""
                elif user_input.startswith("/output "):
                    new_mode = user_input.split(None, 1)[1].strip().lower()
                elif user_input == "/verbose off":
                    new_mode = "compact"
                elif user_input == "/verbose" and OUTPUT_MODE == "verbose":
                    new_mode = "compact"
                else:
                    new_mode = user_input.lstrip("/").split()[0]
                if new_mode and new_mode not in OUTPUT_MODES:
                    msg = f"Unknown output mode '{new_mode}' — use quiet, compact or verbose"
                elif not new_mode:
                    msg = f"Output mode: {OUTPUT_MODE} (change with /quiet, /compact or /verbose)"
                else:
                    _set_output_mode(new_mode)
                    _save_output_mode(new_mode)
                    msg = {"quiet": "Quiet output ON — one line per command (saved)", "compact": "Compact output ON — long output is collapsed; /out shows it all (saved)", "verbose": "Verbose output ON — every line of command output is shown live (saved)"}[new_mode]
                if RICH:
                    console.print(f"  [green]{msg}[/green]\n")
                else:
                    print(f"  {msg}\n")
                continue

            if user_input == "/keys":
                try:
                    subprocess.run(["promptos-keys", "show"])
                    print("\nUse /setup for an interactive walkthrough,")
                    print("or: promptos-keys set <claude|openai|groq> <key>")
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-keys not installed.\n")
                continue

            if user_input == "/setup":
                try:
                    subprocess.run(["promptos-keys", "setup"])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-keys not installed.\n")
                continue

            if user_input == "/wifi":
                try:
                    subprocess.run(["promptos-wifi"])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-wifi not installed.\n")
                continue

            if user_input.startswith("/model"):
                parts = user_input.split(None, 1)
                sub = parts[1].strip() if len(parts) > 1 else "status"
                try:
                    subprocess.run(["promptos-model", sub])
                except KeyboardInterrupt:
                    print()
                except FileNotFoundError:
                    print("  promptos-model not installed.\n")
                continue

            if user_input == "/gui":
                try:
                    subprocess.Popen(
                        ["promptos-gui"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        stdin=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                    print("  Launched promptos-gui.\n")
                except FileNotFoundError:
                    print("  promptos-gui not installed.\n")
                continue

            if not active_provider:
                if RICH:
                    console.print("[red]No AI provider available. Set an API key with /keys or start ollama.[/red]")
                else:
                    print("\033[31mNo AI provider available.\033[0m")
                continue

            active_provider = route_openai_model_for_turn(active_provider, user_input)

            turn_history = history if persist_turn else history.copy()
            turn_history.append(Message("user", user_input))

            # First-prompt warning for ollama: the system prompt is large, so the
            # first request pays a significant prompt-processing cost on CPU
            # (10-30s on a 4-core laptop CPU). Subsequent prompts reuse the cache
            # and feel snappy. Tell the user to be patient.
            if active_provider.name == "ollama" and not ollama_warmed:
                if RICH:
                    console.print("[dim]Processing first prompt — please wait, this can take 10-30s on slow CPUs (subsequent prompts will be much faster).[/dim]")
                else:
                    print("\033[2mProcessing first prompt — please wait (10-30s on slow CPUs); subsequent prompts will be much faster.\033[0m")
                ollama_warmed = True

            # Loop: AI may emit commands → we run them → feed results back → ask AI
            # again to interpret/continue. Capped to keep the AI from spinning forever.
            MAX_AGENT_TURNS = 15
            agent_turn = 0
            empty_retries = 0
            try:
                while True:
                    compact_history(turn_history)  # batch-trim + shrink old output so the cached prefix stays stable
                    # Stream response, collect chunks
                    response_chunks = []
                    _turn_t0 = time.time()
                    if RICH:
                        color = PROVIDER_COLORS.get(active_provider.name, "bold white")
                        console.print(f"\n[{color}][{active_provider.name}][/{color}]")
                        # Live re-renders the accumulating markdown as chunks arrive,
                        # so the user sees rich formatting (bold, code blocks, lists)
                        # instead of raw markdown text.
                        typeahead = TypeAhead(message_queue)
                        status = _TurnStatus(typeahead)
                        with typeahead, Live(
                            _compose_live("", typeahead, status),
                            console=console,
                            refresh_per_second=8,
                            vertical_overflow="visible",
                        ) as live:
                            typeahead.on_change = lambda: live.update(
                                _compose_live("".join(response_chunks), typeahead, status))
                            for chunk in active_provider.chat(bound_history(turn_history), stream=True):
                                response_chunks.append(chunk)
                                status.writing = True
                                live.update(_compose_live("".join(response_chunks), typeahead, status))
                            # Final frame: just the reply, so the transcript stays clean.
                            live.update(Markdown("".join(response_chunks)))
                        response = "".join(response_chunks)
                        if typeahead.buffer.strip():
                            # Typed but not submitted — don't lose it; prefill the next prompt.
                            pending_input = typeahead.buffer
                        if message_queue:
                            n = len(message_queue)
                            console.print(f"[dim]{n} message{'s' if n != 1 else ''} queued — sent when this turn finishes. /queue to manage.[/dim]")
                        console.print()
                    else:
                        print(f"\n\033[90m[{active_provider.name}]\033[0m ", end="", flush=True)
                        for chunk in active_provider.chat(bound_history(turn_history), stream=True):
                            print(chunk, end="", flush=True)
                            response_chunks.append(chunk)
                        response = "".join(response_chunks)
                        print("\n")

                    _log_turn(active_provider, len(turn_history), sum(len(m.content) for m in bound_history(turn_history)), len(response_chunks), time.time() - _turn_t0)
                    if not response.strip():
                        stop = getattr(active_provider, "last_stop_reason", "") or "unknown"
                        retry = empty_retries < 1
                        empty_retries += 1
                        warn = f"Empty reply from {active_provider.name} (stop_reason={stop}); " + ("retrying once." if retry else "giving up. Send your message again, or /clear if this repeats.")
                        if RICH:
                            console.print(f"[yellow]{warn}[/yellow]\n")
                        else:
                            print(f"\033[33m{warn}\033[0m\n")
                        if retry:
                            continue
                        break
                    empty_retries = 0
                    turn_history.append(Message("assistant", response))

                    cmds = extract_commands(response)
                    if not cmds:
                        # AI didn't emit any commands — task is finished or it's
                        # just talking. Hand control back to the user.
                        break

                    if message_queue:
                        # A message was queued while this reply streamed, so the user has moved on.
                        # Skip this reply's commands and end the agent loop; the queued message is
                        # sent next. Note it in history so the AI knows nothing ran.
                        n = len(cmds)
                        turn_history[-1] = Message("assistant", response + "\n\n[promptsh: the CMD: lines above were NOT run; the user sent a new message first]")
                        skip_msg = f"Skipped {n} command{'s' if n != 1 else ''} from this reply; sending your queued message."
                        if RICH:
                            console.print(f"[yellow]{skip_msg}[/yellow]\n")
                        else:
                            print(f"\033[33m{skip_msg}\033[0m\n")
                        break

                    cmd_typeahead = TypeAhead(message_queue)
                    results = run_commands(cmds, autorun=_autorun_this, typeahead=cmd_typeahead)
                    if cmd_typeahead.buffer.strip():
                        # Typed during the command but not submitted; prefill the next prompt.
                        pending_input = cmd_typeahead.buffer
                    # Feed command results back into history so AI knows what happened
                    feedback_lines = ["[command results]"]
                    for r in results:
                        if r["exit_code"] is None:
                            feedback_lines.append(f"  $ {r['cmd']} → skipped by user")
                        elif r["exit_code"] == 0:
                            feedback_lines.append(f"  $ {r['cmd']} → success (exit 0)")
                        else:
                            feedback_lines.append(f"  $ {r['cmd']} → FAILED (exit {r['exit_code']})")
                        if r["output"].strip():
                            feedback_lines.append("    output: " + _ai_excerpt(r["output"]).replace("\n", "\n            "))
                    turn_history.append(Message("user", "\n".join(feedback_lines)))

                    # If the user skipped every command, the AI has nothing new to
                    # work with — break instead of looping forever on stale input.
                    if all(r["exit_code"] is None for r in results):
                        break

                    agent_turn += 1
                    if agent_turn >= MAX_AGENT_TURNS:
                        if RICH:
                            console.print(f"[yellow]Reached {MAX_AGENT_TURNS}-turn auto-loop limit. Type 'continue' to keep going.[/yellow]\n")
                        else:
                            print(f"\033[33mReached {MAX_AGENT_TURNS}-turn auto-loop limit. Type 'continue' to keep going.\033[0m\n")
                        break

            except KeyboardInterrupt:
                if RICH:
                    console.print("\n[yellow][cancelled][/yellow]\n")
                else:
                    print("\n\033[33m[cancelled]\033[0m\n")
                turn_history.pop()
            except Exception as e:
                _log_turn(active_provider, len(turn_history), 0, len(locals().get("response_chunks", [])), time.time() - locals().get("_turn_t0", time.time()), err=str(e))
                if RICH:
                    console.print(f"\n[red]Provider error ({active_provider.name}): {e}[/red]")
                else:
                    print(f"\n\033[31mProvider error ({active_provider.name}): {e}\033[0m")
                turn_history.pop()
                # Auto-fallback to next available provider
                all_p = list_providers()
                switched = False
                for p_info in all_p:
                    if p_info["available"] and p_info["name"] != active_provider.name:
                        new_p = get_provider(p_info["name"])
                        if new_p:
                            active_provider = new_p
                            if RICH:
                                color = PROVIDER_COLORS.get(new_p.name, "bold white")
                                console.print(f"[yellow]Auto-switching to [{color}]{new_p.name}[/{color}][/yellow] — resend your message\n")
                            else:
                                print(f"\033[33mAuto-switching to {new_p.name}\033[0m — resend your message\n")
                            switched = True
                            break
                if not switched:
                    if RICH:
                        console.print("[dim]Use /switch to try another provider, or !cmd to run bash directly.[/dim]\n")
                    else:
                        print("Use /switch to try another provider, or !cmd to run bash directly.\n")

    finally:
        save_history()


if __name__ == "__main__":
    main()
