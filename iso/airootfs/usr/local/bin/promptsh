#!/usr/bin/env python3
"""
promptsh — the promptOS AI shell.
Routes natural language through the configured AI provider (Claude, OpenAI, Groq, or Ollama).
Type /help for commands.
"""

import os
import sys
import subprocess
import time
import getpass

# Add promptOS library to path
sys.path.insert(0, "/usr/local/lib/promptos")

from providers import get_provider, list_providers, Message
import providers as _providers_module

# ── Rich + prompt_toolkit (with fallback if not installed) ────────────────────
# Bare Linux TTY ($TERM=linux) has limited capabilities — rich panels and
# prompt_toolkit cursor tracking cause screen glitches when scrolling.
_BARE_TTY = os.environ.get("TERM") == "linux"

try:
    from rich.console import Console
    from rich.markdown import Markdown
    from rich.panel import Panel
    from rich.text import Text
    from rich.live import Live
    from rich import box
    RICH = not _BARE_TTY
    console = Console() if RICH else None
except ImportError:
    RICH = False
    console = None

try:
    if _BARE_TTY:
        raise ImportError("skip prompt_toolkit on bare TTY")
    from prompt_toolkit import PromptSession
    from prompt_toolkit.styles import Style
    from prompt_toolkit.formatted_text import HTML
    from prompt_toolkit.history import FileHistory
    from prompt_toolkit.completion import Completer, Completion
    PROMPT_TOOLKIT = True
except ImportError:
    import readline
    PROMPT_TOOLKIT = False

HISTORY_FILE  = os.path.expanduser("~/.promptsh_history")
SESSIONS_DIR  = os.path.expanduser("~/.promptsh/sessions")
AGENT_MD      = "/usr/local/lib/promptos/AGENT.md"
AUTORUN       = False  # set True to skip CMD: confirmation prompts

PROVIDER_COLORS = {
    "claude":       "bold magenta",
    "openai":       "bold green",
    "groq":         "bold cyan",
    "ollama":       "bold yellow",
}


def _load_agent_md() -> str:
    try:
        with open(AGENT_MD) as f:
            return f.read()
    except FileNotFoundError:
        return ""


# ── Session memory ────────────────────────────────────────────────────────────
# Saved conversations live as JSON files under ~/.promptsh/sessions/.
# Each file is a list of {role, content} message dicts.
import json as _json


def _safe_session_name(name: str) -> str:
    """Make a name filesystem-safe (allow letters/digits/_/-, replace others)."""
    keep = "_-."
    out = "".join(c if (c.isalnum() or c in keep) else "_" for c in name).strip("_")
    return out or "session"


def _session_path(name: str) -> str:
    return os.path.join(SESSIONS_DIR, _safe_session_name(name) + ".json")


def save_session(name: str, history: list) -> str:
    """Serialize history to JSON. Returns the saved path."""
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    path = _session_path(name)
    data = [{"role": m.role, "content": m.content} for m in history]
    with open(path, "w") as f:
        _json.dump(data, f, indent=2)
    return path


def load_session(name: str) -> list:
    """Load a saved session and return a list of Message objects."""
    path = _session_path(name)
    with open(path) as f:
        data = _json.load(f)
    return [Message(d["role"], d["content"]) for d in data]


def list_sessions() -> list[tuple[str, int, int]]:
    """Return [(name, message_count, mtime_epoch), ...] sorted newest first."""
    if not os.path.isdir(SESSIONS_DIR):
        return []
    out = []
    for f in os.listdir(SESSIONS_DIR):
        if not f.endswith(".json"):
            continue
        path = os.path.join(SESSIONS_DIR, f)
        try:
            with open(path) as fh:
                count = len(_json.load(fh))
            mtime = int(os.path.getmtime(path))
        except (OSError, _json.JSONDecodeError):
            count, mtime = 0, 0
        out.append((f[:-5], count, mtime))
    out.sort(key=lambda t: t[2], reverse=True)
    return out


def forget_session(name: str) -> bool:
    """Delete a saved session. Returns True if deleted, False if didn't exist."""
    path = _session_path(name)
    if os.path.isfile(path):
        os.remove(path)
        return True
    return False


# ── Tab completion ────────────────────────────────────────────────────────────
# When the line starts with `!`, complete bash command names (first token) or
# filesystem paths (subsequent tokens). Otherwise no completion.

_PATH_CMD_CACHE: list[str] = []


def _path_commands() -> list[str]:
    global _PATH_CMD_CACHE
    if _PATH_CMD_CACHE:
        return _PATH_CMD_CACHE
    seen = set()
    for d in os.environ.get("PATH", "").split(":"):
        if not d:
            continue
        try:
            for f in os.listdir(d):
                seen.add(f)
        except OSError:
            pass
    _PATH_CMD_CACHE = sorted(seen)
    return _PATH_CMD_CACHE


def _complete_path(prefix: str) -> list[str]:
    """Return filesystem completions for `prefix`."""
    expanded = os.path.expanduser(prefix) if prefix else ""
    if not expanded:
        dirname, base = ".", ""
    elif expanded.endswith("/"):
        dirname, base = expanded, ""
    else:
        dirname = os.path.dirname(expanded) or "."
        base = os.path.basename(expanded)
    try:
        names = sorted(os.listdir(dirname))
    except OSError:
        return []
    out = []
    for n in names:
        if not n.startswith(base):
            continue
        full = os.path.join(dirname, n) if dirname != "." else n
        if os.path.isdir(os.path.join(dirname, n)):
            full += "/"
        out.append(full)
    return out


def _readline_completer(text: str, state: int):
    """readline completer: only fires when the line starts with `!`."""
    line = readline.get_line_buffer()
    if not line.startswith("!"):
        return None
    cmd_line = line[1:]
    # First token = command name; later tokens = paths.
    if " " not in cmd_line.lstrip():
        matches = [c for c in _path_commands() if c.startswith(text)]
    else:
        matches = _complete_path(text)
    if state < len(matches):
        return matches[state]
    return None


if PROMPT_TOOLKIT:
    class _BangCompleter(Completer):
        """prompt_toolkit completer: only fires when the line starts with `!`.
        First token completes against $PATH binaries; later tokens against
        the filesystem."""
        def get_completions(self, document, complete_event):
            text = document.text_before_cursor
            if not text.startswith("!"):
                return
            cmd_line = text[1:]
            # Word being completed (everything after the last whitespace)
            tail = cmd_line.split()[-1] if cmd_line and not cmd_line.endswith(" ") else ""
            if " " not in cmd_line.lstrip():
                pool = [c for c in _path_commands() if c.startswith(tail)]
            else:
                pool = _complete_path(tail)
            for match in pool:
                yield Completion(match, start_position=-len(tail))


SYSTEM_PROMPT_SUFFIX = """
---
## Current System Context (snapshot at session start)
- OS: promptOS (Arch Linux based)
- Shell: promptsh
- User: {user} (uid {uid}, {priv})
- Home: {home}
- CWD: {cwd}
- Hostname: {hostname}
- Uptime: {uptime}
- Disk: {disk}
- Date/time at session start: {now} ({tz})

NOTE: The values above are a one-time snapshot. For anything that changes
during the session (current time, uptime, disk usage, network status, etc.),
run a command (`date`, `uptime`, `df -h`, `ip a`) instead of trusting the
snapshot. The user's CWD also changes when they run `cd`.
"""


def load_config():
    for path in ("/etc/promptos/config", "/etc/promptos/keys"):
        if os.path.exists(path):
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, _, v = line.partition("=")
                        k, v = k.strip(), v.strip()
                        if v and not os.environ.get(k):
                            os.environ[k] = v


def get_system_prompt() -> str:
    import socket
    try:
        uptime = subprocess.check_output("uptime -p", shell=True, text=True).strip()
    except Exception:
        uptime = "unknown"
    try:
        disk = subprocess.check_output(
            "df -h / | awk 'NR==2{print $3\"/\"$2\" used (\"$5\")\"}'",
            shell=True, text=True).strip()
    except Exception:
        disk = "unknown"
    try:
        uid = os.geteuid()
    except Exception:
        uid = -1
    try:
        user = getpass.getuser()
    except Exception:
        user = os.environ.get("USER", "unknown")
    priv = "root/full system access" if uid == 0 else "regular user — sudo for elevated commands"
    home = os.path.expanduser("~")
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = "?"
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    tz = time.strftime("%Z%z")
    agent = _load_agent_md()
    suffix = SYSTEM_PROMPT_SUFFIX.format(
        user=user,
        uid=uid,
        priv=priv,
        home=home,
        cwd=cwd,
        hostname=socket.gethostname(),
        uptime=uptime,
        disk=disk,
        now=now,
        tz=tz,
    )
    return agent + suffix


import re as _re

# Heredoc detection: matches the closing tag in `<<EOF`, `<<-EOF`, `<<'EOF'`,
# `<<"EOF"`. Captures the tag name so we know what line ends the body.
_HEREDOC_RE = _re.compile(r"<<-?\s*['\"]?(\w+)['\"]?")


def extract_commands(response: str) -> list[str]:
    r"""Extract executable commands from an AI response.
    Only commands explicitly marked with `CMD:` are run. Standalone code blocks
    are never executed — they're for the AI to show examples / sample output.

    Handles four formats the AI tends to emit:
      1. `CMD: ls -la`              — simple inline form (canonical)
      2. `CMD: \`ls -la\``           — wrapped in backticks
      3. `CMD: cat > f <<EOF`       — heredoc: collect body until the closing
                                      tag and pass the whole multi-line command
                                      to bash as one unit
      4. `CMD: \`\`\`bash`             — code-fence after CMD:, command(s) follow
                                      on subsequent lines until the closing fence
    """
    cmds: list[str] = []
    lines = response.splitlines()
    i = 0
    while i < len(lines):
        stripped = lines[i].strip()
        if not stripped.startswith("CMD:"):
            i += 1
            continue

        payload = stripped[4:].strip()

        # Form 1/2/3: inline command on the same line as CMD:.
        if payload and not payload.startswith("```"):
            cmd = payload.strip("`").strip()
            # Form 3: heredoc — collect body lines until closing tag.
            heredoc = _HEREDOC_RE.search(cmd)
            if heredoc:
                tag = heredoc.group(1)
                body: list[str] = []
                i += 1
                while i < len(lines) and lines[i].rstrip() != tag:
                    body.append(lines[i])
                    i += 1
                full = cmd + "\n" + "\n".join(body) + "\n" + tag + "\n"
                cmds.append(full)
                i += 1  # consume the closing tag
                continue
            if cmd:
                cmds.append(cmd)
            i += 1
            continue

        # Form 4: AI used a fenced code block. Skip past the opening fence
        # (which is either on the CMD: line itself or shortly after) and
        # collect non-empty, non-comment lines until the closing fence.
        i += 1
        if not payload.startswith("```"):
            while i < len(lines) and not lines[i].strip().startswith("```"):
                i += 1
            i += 1  # skip the opening ``` fence
        while i < len(lines):
            line = lines[i].strip()
            if line.startswith("```"):
                i += 1
                break
            if line and not line.startswith("#"):
                cmds.append(line)
            i += 1
    return cmds


def builtin_cd(cmd: str) -> tuple[bool, str]:
    """Handle the `cd` shell builtin in-process so the cwd actually changes.
    Returns (ok, message). Supports: `cd`, `cd ~`, `cd ~user`, `cd -`, `cd path`.
    Does NOT handle compound commands (cd foo && bar) — those still run via shell."""
    parts = cmd.strip().split(None, 1)
    target = parts[1].strip() if len(parts) > 1 else "~"
    if target == "-":
        target = os.environ.get("OLDPWD", os.getcwd())
        print(target)  # bash echoes the new dir for `cd -`
    target = os.path.expanduser(os.path.expandvars(target))
    try:
        prev = os.getcwd()
        os.chdir(target)
        os.environ["OLDPWD"] = prev
        os.environ["PWD"] = os.getcwd()
        return True, os.getcwd()
    except OSError as e:
        return False, f"cd: {e}"


def is_pure_cd(cmd: str) -> bool:
    """True if cmd is just `cd ...` with no compound shell operators."""
    s = cmd.strip()
    if not (s == "cd" or s.startswith("cd ")):
        return False
    # If there's any shell operator, fall back to subprocess (which won't persist
    # the cwd, but will at least run the rest of the command correctly).
    return not any(op in s for op in ("&&", "||", ";", "|", ">", "<", "&"))


def run_commands(cmds: list[str], autorun: bool = False) -> list[dict]:
    """Run commands, return results for injection into AI history.

    Output is visually distinct from AI responses: each line is prefixed with
    a dim │ bar so it reads like an indented quote/code block, with the cmd
    header in yellow on top and a trailing └─ exit N in green/red below."""
    results = []
    for cmd in cmds:
        # Header — yellow with a leading marker so it's obviously a command.
        if RICH:
            console.print(f"\n[bold yellow]▶[/bold yellow] [yellow]{cmd}[/yellow]")
        else:
            print(f"\n\033[1;33m▶\033[0m \033[33m{cmd}\033[0m")

        if autorun:
            confirmed = True
        else:
            try:
                ans = (console.input("[dim]Run? \\[Y/n][/dim] ") if RICH else input("Run? [Y/n] ")).strip().lower()
                confirmed = ans in ("", "y", "yes")
            except EOFError:
                confirmed = False

        if confirmed:
            # Intercept `cd` so it actually changes the shell's cwd instead of
            # running in a child process that exits immediately.
            if is_pure_cd(cmd):
                ok, msg = builtin_cd(cmd)
                if not ok:
                    print(msg)
                results.append({
                    "cmd": cmd,
                    "exit_code": 0 if ok else 1,
                    "output": msg,
                })
                continue

            # Stream output live so the user sees progress as the command runs,
            # while also capturing it to feed back into the AI conversation.
            proc = subprocess.Popen(
                cmd, shell=True, text=True,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                bufsize=1,  # line-buffered
            )
            # Each output line gets a dim ┃ prefix on every visual row so
            # command output is clearly distinct from the AI's markdown above.
            # We wrap at terminal width ourselves (instead of letting the
            # terminal soft-wrap) so long lines don't lose the prefix on
            # continuation rows. Also re-emit the prefix after every \r so
            # progress-bar style updates don't overwrite it.
            import shutil as _shutil
            LINE_PREFIX = "\033[2m┃\033[0m "
            PREFIX_VIS  = 2  # visible width of "┃ "

            def _emit(line: str):
                cols = max(40, _shutil.get_terminal_size((80, 24)).columns)
                inner = cols - PREFIX_VIS
                has_nl = line.endswith("\n")
                body = line.rstrip("\n")
                parts = body.split("\r")
                out = []
                for pi, chunk in enumerate(parts):
                    if not chunk:
                        out.append(LINE_PREFIX)
                    else:
                        j, first = 0, True
                        while j < len(chunk):
                            if not first:
                                out.append("\n")
                            out.append(LINE_PREFIX + chunk[j:j + inner])
                            j += inner
                            first = False
                    if pi < len(parts) - 1:
                        out.append("\r")
                if has_nl:
                    out.append("\n")
                sys.stdout.write("".join(out))
                sys.stdout.flush()

            output_chunks: list[str] = []
            interrupted = False
            try:
                assert proc.stdout is not None
                for line in proc.stdout:
                    _emit(line)
                    output_chunks.append(line)
            except KeyboardInterrupt:
                proc.terminate()
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                print()
                interrupted = True
            proc.wait()
            output = "".join(output_chunks)
            # Trailer — └─ followed by green/red exit code; makes the boundary
            # between command output and the next AI response obvious.
            if not interrupted:
                if proc.returncode == 0:
                    print("\033[2m└─\033[0m \033[32mexit 0\033[0m")
                else:
                    print(f"\033[2m└─\033[0m \033[31mexit {proc.returncode}\033[0m")
            results.append({
                "cmd": cmd,
                "exit_code": proc.returncode,
                "output": output[:2000],
            })
            # Re-raise so the agent loop bails out of the whole multi-step task
            # instead of marching on to the next command and re-querying the AI.
            if interrupted:
                raise KeyboardInterrupt
        else:
            results.append({"cmd": cmd, "exit_code": None, "output": ""})
    return results


def _local_ip() -> str | None:
    """Best-effort: return the LAN IP used to reach the public internet, or None
    if offline. Doesn't actually send a packet — just resolves the source address
    of the route to 1.1.1.1."""
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(0.5)
    try:
        s.connect(("1.1.1.1", 80))
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


def print_banner(provider_name: str | None):
    try:
        logo = subprocess.check_output(
            ["figlet", "-f", "standard", "promptOS"], text=True, stderr=subprocess.DEVNULL
        )
    except Exception:
        logo = "promptOS"

    ip = _local_ip()

    if RICH:
        color = PROVIDER_COLORS.get(provider_name, "bold white") if provider_name else "bold white"
        provider_str = f"[{color}]{provider_name}[/{color}]" if provider_name else "[yellow]no provider[/yellow]"
        net_str = f"[bold green]{ip}[/bold green]" if ip else "[yellow]offline[/yellow]"
        console.print(f"[bold cyan]{logo}[/bold cyan]", end="")
        console.print(Panel(
            f"[dim]AI-Native Linux[/dim]  •  provider: {provider_str}  •  ip: {net_str}\n"
            f"[dim]/help for commands  •  !cmd for bash  •  exit to quit[/dim]",
            border_style="dim",
            box=box.ROUNDED,
        ))
    else:
        print(f"\033[1;36m{logo}\033[0m")
        status = f"\033[1;32m{provider_name}\033[0m" if provider_name else "\033[33mno provider\033[0m"
        net = f"\033[1;32m{ip}\033[0m" if ip else "\033[33moffline\033[0m"
        print(f"  AI-Native Linux  |  provider: {status}  |  ip: {net}")
        print("  /help for commands  |  !cmd to run bash directly  |  exit to quit\n")


