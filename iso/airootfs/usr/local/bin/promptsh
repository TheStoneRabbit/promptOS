HISTORY_FILE  = os.path.expanduser("~/.promptsh_history")
SESSIONS_DIR  = os.path.expanduser("~/.promptsh/sessions")
STATE_FILE    = os.path.expanduser("~/.promptsh/state.json")
AGENT_MD      = "/usr/local/lib/promptos/AGENT.md"
AUTORUN       = False  # set True to skip CMD: confirmation prompts

PROVIDER_COLORS = {
    "claude":       "bold magenta",
    "openai":       "bold green",
    "groq":         "bold cyan",
    "ollama":       "bold yellow",
}


def _load_agent_md() -> str:
    try:
        with open(AGENT_MD) as f:
            return f.read()
    except FileNotFoundError:
        return ""


# ── Session memory ────────────────────────────────────────────────────────────
# Saved conversations live as JSON files under ~/.promptsh/sessions/.
# Each file is a list of {role, content} message dicts.
import json as _json


def _safe_session_name(name: str) -> str:
    """Make a name filesystem-safe (allow letters/digits/_/-, replace others)."""
    keep = "_-."
    out = "".join(c if (c.isalnum() or c in keep) else "_" for c in name).strip("_")
    return out or "session"


def _session_path(name: str) -> str:
    return os.path.join(SESSIONS_DIR, _safe_session_name(name) + ".json")


def save_session(name: str, history: list) -> str:
    """Serialize history to JSON. Returns the saved path."""
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    path = _session_path(name)
    data = [{"role": m.role, "content": m.content} for m in history]
    with open(path, "w") as f:
        _json.dump(data, f, indent=2)
    return path


def load_session(name: str) -> list:
    """Load a saved session and return a list of Message objects."""
    path = _session_path(name)
    with open(path) as f:
        data = _json.load(f)
    return [Message(d["role"], d["content"]) for d in data]


def list_sessions() -> list[tuple[str, int, int]]:
    """Return [(name, message_count, mtime_epoch), ...] sorted newest first."""
    if not os.path.isdir(SESSIONS_DIR):
        return []
    out = []
    for f in os.listdir(SESSIONS_DIR):
        if not f.endswith(".json"):
            continue
        path = os.path.join(SESSIONS_DIR, f)
        try:
            with open(path) as fh:
                count = len(_json.load(fh))
            mtime = int(os.path.getmtime(path))
        except (OSError, _json.JSONDecodeError):
            count, mtime = 0, 0
        out.append((f[:-5], count, mtime))
    out.sort(key=lambda t: t[2], reverse=True)
    return out


def forget_session(name: str) -> bool:
    """Delete a saved session. Returns True if deleted, False if didn't exist."""
    path = _session_path(name)
    if os.path.isfile(path):
        os.remove(path)
        return True
    return False


def _load_state() -> dict:
    """Load persistent promptsh state (best effort)."""
    try:
        with open(STATE_FILE) as f:
            data = _json.load(f)
            return data if isinstance(data, dict) else {}
    except (FileNotFoundError, OSError, _json.JSONDecodeError):
        return {}


def _save_state(data: dict):
    """Persist promptsh state to disk (best effort)."""
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            _json.dump(data, f, indent=2)
    except OSError:
        pass


def _load_autorun_default() -> bool:
    """Resolve autorun default from env/config + persisted state."""
    env = os.environ.get("PROMPTOS_AUTORUN", "").strip().lower()
    if env in ("1", "true", "yes", "on"):
        return True
    if env in ("0", "false", "no", "off"):
        return False
    state = _load_state()
    value = state.get("autorun")
    if isinstance(value, bool):
        return value
    return AUTORUN


def _save_autorun_default(enabled: bool):
    state = _load_state()
    state["autorun"] = bool(enabled)
    _save_state(state)


# ── Command output display ────────────────────────────────────────────────────
# Compact mode (default) keeps the screen readable: long command output is
# collapsed to head + tail, with the full text kept for `/out` and for the AI.
OUTPUT_MODES       = ("quiet", "compact", "verbose")
OUTPUT_MODE        = "quiet"  # quiet | compact | verbose (set via /quiet /compact /verbose /output)
VERBOSE_OUTPUT     = False    # derived: OUTPUT_MODE == "verbose" (stream everything live)
COMPACT_MAX_LINES  = 12      # output up to this many lines is shown in full
COMPACT_HEAD       = 4       # lines kept from the start of long output
COMPACT_TAIL       = 4       # lines kept from the end of long output
AI_FEEDBACK_CHARS  = 2500    # how much of each command's output the AI sees
OUTPUT_LOG_MAX     = 20      # how many command outputs /out can recall
OUTPUT_LOG: list[dict] = []


def _load_output_mode() -> str:
    env = os.environ.get("PROMPTOS_OUTPUT_MODE", "").strip().lower()
    if env in OUTPUT_MODES:
        return env
    env = os.environ.get("PROMPTOS_VERBOSE_OUTPUT", "").strip().lower()
    if env in ("1", "true", "yes", "on"):
        return "verbose"
    if env in ("0", "false", "no", "off"):
        return "compact"
    state = _load_state()
    mode = state.get("output_mode")
    if mode in OUTPUT_MODES:
        return mode
    legacy = state.get("verbose_output")
    if isinstance(legacy, bool):
        return "verbose" if legacy else "compact"
    return OUTPUT_MODE


def _save_output_mode(mode: str):
    state = _load_state()
    state["output_mode"] = mode
    state.pop("verbose_output", None)
    _save_state(state)


def _term_cols() -> int:
    import shutil as _sh
    return max(40, _sh.get_terminal_size((80, 24)).columns)


def _clip(s: str, width: int) -> str:
    """Single-line truncation with an ellipsis."""
    s = s.replace("\t", "    ")
    return s if len(s) <= width else s[:max(1, width - 1)] + "…"


def _fmt_elapsed(seconds: float) -> str:
    if seconds < 1:
        return "<1s"
    if seconds < 60:
        return f"{int(seconds)}s"
    m, s = divmod(int(seconds), 60)
    if m < 60:
        return f"{m}m {s:02d}s"
    h, m = divmod(m, 60)
    return f"{h}h {m:02d}m"


def _log_turn(provider, n_msgs, chars, chunks, elapsed, err=""):
    """Best-effort one-line record of each request, for diagnosing blank replies. Never raises."""
    try:
        d = os.path.expanduser("~/.local/state/promptos")
        os.makedirs(d, exist_ok=True)
        u = getattr(provider, "last_usage", {}) or {}
        line = (f"{time.strftime('%Y-%m-%d %H:%M:%S')} provider={provider.name} "
                f"model={getattr(provider, 'model', '?')} msgs={n_msgs} chars_sent={chars} "
                f"stop_reason={getattr(provider, 'last_stop_reason', '') or '-'} "
                f"usage={_json.dumps(u, separators=(',', ':'))} chunks={chunks} "
                f"secs={elapsed:.1f} blocks={','.join(getattr(provider, 'last_blocks', []) or []) or '-'} err={err!r}\n")
        with open(os.path.join(d, "promptsh-turns.log"), "a") as f:
            f.write(line)
    except Exception:
        pass


def _remember_output(cmd: str, exit_code, output: str):
    OUTPUT_LOG.append({"cmd": cmd, "exit_code": exit_code, "output": output, "at": time.time()})
    del OUTPUT_LOG[:-OUTPUT_LOG_MAX]


def _collapse_repeats(text: str) -> str:
    """Collapse runs of identical consecutive lines into one line plus a
    repeat marker, and runs of blank lines into a single blank line.
    Scraped pages and retry loops repeat a lot; this keeps them in budget."""
    from itertools import groupby
    out: list[str] = []
    for line, group in groupby(text.split("\n"), key=lambda l: l if l.strip() else ""):
        n = sum(1 for _ in group)
        out.append(line)
        if n > 1 and line:
            out.append(f"[previous line repeated {n - 1}×]")
    return "\n".join(out)


def _ai_excerpt(output: str, limit: int = AI_FEEDBACK_CHARS) -> str:
    """What the AI gets to read: the whole thing if short, else head + tail so
    both the setup and the final result/error survive the cut."""
    output = output.strip()
    if len(output) <= limit:
        return output
    output = _collapse_repeats(output)   # only applied when over the limit
    if len(output) <= limit:
        return output
    half = limit // 2
    omitted = len(output) - 2 * half
    return f"{output[:half]}\n…[{omitted} chars omitted; the user can see them with /out]…\n{output[-half:]}"


def _print_output_line(line: str):
    cols = _term_cols()
    print(f"\033[2m┃\033[0m {_clip(line, cols - 2)}")


def _print_compact_output(lines: list[str]) -> int:
    """Print output collapsed to head+tail when long. Returns hidden line count."""
    if not lines:
        return 0
    if len(lines) <= COMPACT_MAX_LINES:
        for ln in lines:
            _print_output_line(ln)
        return 0
    hidden = len(lines) - COMPACT_HEAD - COMPACT_TAIL
    for ln in lines[:COMPACT_HEAD]:
        _print_output_line(ln)
    print(f"\033[2m┃ … {hidden} more line{'s' if hidden != 1 else ''} hidden …\033[0m")
    for ln in lines[-COMPACT_TAIL:]:
        _print_output_line(ln)
    return hidden


def show_output_log(arg: str = ""):
    """/out [n|all]: print the full output of a recent command."""
    if not OUTPUT_LOG:
        print("  No command output yet.\n")
        return
    arg = arg.strip()
    if arg in ("all", "list"):
        for i, e in enumerate(reversed(OUTPUT_LOG), 1):
            n = len(e["output"].rstrip("\n").split("\n")) if e["output"].strip() else 0
            code = "skipped" if e["exit_code"] is None else f"exit {e['exit_code']}"
            print(f"  {i:>2}  {_clip(e['cmd'], _term_cols() - 30):<{_term_cols() - 28}} {code}, {n} line{'s' if n != 1 else ''}")
        print("\n  /out <n> shows one of them in full.\n")
        return
    try:
        n = int(arg) if arg else 1
    except ValueError:
        print("  Usage: /out            full output of the last command\n"
              "         /out <n>        the n-th most recent command\n"
              "         /out all        list recent commands\n")
        return
    if not 1 <= n <= len(OUTPUT_LOG):
        print(f"  Only {len(OUTPUT_LOG)} command output{'s' if len(OUTPUT_LOG) != 1 else ''} remembered.\n")
        return
    e = OUTPUT_LOG[-n]
    print(f"\n\033[1;33m▶\033[0m \033[33m{e['cmd']}\033[0m")
    text = e["output"].rstrip("\n")
    if text.strip():
        for ln in text.split("\n"):
            print(f"\033[2m┃\033[0m {ln}")
    else:
        print("\033[2m┃ (no output)\033[0m")
    code = e["exit_code"]
    if code is None:
        print("\033[2m└─ skipped\033[0m\n")
    elif code == 0:
        print("\033[2m└─\033[0m \033[32mexit 0\033[0m\n")
    else:
        print(f"\033[2m└─\033[0m \033[31mexit {code}\033[0m\n")


def _set_output_mode(mode: str):
    global OUTPUT_MODE, VERBOSE_OUTPUT
    OUTPUT_MODE = mode if mode in OUTPUT_MODES else "quiet"
    VERBOSE_OUTPUT = OUTPUT_MODE == "verbose"


def _script_uses_sudo(cmd: str) -> bool:
    """True if `cmd` runs a local script file that itself calls sudo."""
    import re, shlex
    try:
        tokens = shlex.split(cmd)
    except ValueError:
        return False
    for tok in tokens[:8]:
        path = os.path.expanduser(tok)
        try:
            if os.path.isfile(path) and os.path.getsize(path) < 200_000:
                with open(path, "r", errors="ignore") as f:
                    if re.search(r"\bsudo\b", f.read()):
                        return True
        except OSError:
            continue
    return False


def _needs_sudo_password(cmd: str) -> bool:
    """True if `cmd` invokes sudo and sudo would have to ask for a password now."""
    try:
        if os.geteuid() == 0:
            return False
    except AttributeError:
        return False
    import re
    if not re.search(r"(?:^|[;&|(])\s*sudo(?:\s|$)", cmd) and not _script_uses_sudo(cmd):
        return False
    try:
        return subprocess.run(["sudo", "-n", "true"], capture_output=True, timeout=5).returncode != 0
    except Exception:
        return True


def _preauth_sudo() -> bool:
    """Ask for the sudo password up front on the real terminal, where the user
    can see the prompt, instead of letting sudo prompt inside the output pipe
    where the compact status line would hide it."""
    msg = "This command needs your password (sudo)."
    if RICH:
        console.print(f"[bold yellow]{msg}[/bold yellow]")
    else:
        print(f"\033[1;33m{msg}\033[0m")
    try:
        return subprocess.run(["sudo", "-v"]).returncode == 0
    except KeyboardInterrupt:
        print()
        return False


_SUDO_SHIM_DIR = None


def _child_env() -> dict:
    """Environment for commands run by promptsh. A sudo shim goes first in PATH so
    sudo can never prompt for a password inside a running command (the prompt would
    be hidden by the output pipe and the queue would swallow the user's keystrokes).
    The shim uses sudo -n and fails with a hint instead; the password is asked for
    separately by _preauth_sudo / a standalone sudo -v step."""
    global _SUDO_SHIM_DIR
    env = os.environ.copy()
    try:
        if os.geteuid() == 0:
            return env
        import shutil, tempfile, atexit
        if _SUDO_SHIM_DIR is None:
            real = shutil.which("sudo")
            if not real:
                return env
            d = tempfile.mkdtemp(prefix="promptsh-shim-")
            shim = "\n".join([
                "#!/bin/sh",
                "# promptsh: sudo must never prompt inside a running command.",
                f"if ! {real} -n true 2>/dev/null; then",
                '    echo "promptsh: sudo needs your password. Run sudo -v as its own step first." >&2',
                "    exit 1",
                "fi",
                f'exec {real} -n "$@"',
                "",
            ])
            path = os.path.join(d, "sudo")
            with open(path, "w") as f:
                f.write(shim)
            os.chmod(path, 0o755)
            atexit.register(shutil.rmtree, d, True)
            _SUDO_SHIM_DIR = d
        env["PATH"] = _SUDO_SHIM_DIR + os.pathsep + env.get("PATH", "")
    except Exception:
        pass
    return env


def _looks_like_prompt(text: str) -> bool:
    """Heuristic: an unterminated output line that is waiting for the user."""
    import re
    t = text.strip().lower()
    if not t:
        return False
    return bool(re.search(
        r"password|passphrase|\[y/n\]|\(y/n\)|\[yes/no\]|\(yes/no\)|\[y/n/\?\]|"
        r"proceed\?|continue\?|press (enter|any key|return)|enter a number|are you sure",
        t))



# ── Tab completion ────────────────────────────────────────────────────────────
# When the line starts with `!`, complete bash command names (first token) or
# filesystem paths (subsequent tokens). Otherwise no completion.

_PATH_CMD_CACHE: list[str] = []


def _path_commands() -> list[str]:
    global _PATH_CMD_CACHE
    if _PATH_CMD_CACHE:
        return _PATH_CMD_CACHE
    seen = set()
    for d in os.environ.get("PATH", "").split(":"):
        if not d:
            continue
        try:
            for f in os.listdir(d):
                seen.add(f)
        except OSError:
            pass
    _PATH_CMD_CACHE = sorted(seen)
    return _PATH_CMD_CACHE


def _complete_path(prefix: str) -> list[str]:
    """Return filesystem completions for `prefix`."""
    expanded = os.path.expanduser(prefix) if prefix else ""
    if not expanded:
        dirname, base = ".", ""
    elif expanded.endswith("/"):
        dirname, base = expanded, ""
    else:
        dirname = os.path.dirname(expanded) or "."
        base = os.path.basename(expanded)
    try:
        names = sorted(os.listdir(dirname))
    except OSError:
        return []
    out = []
    for n in names:
        if not n.startswith(base):
            continue
        full = os.path.join(dirname, n) if dirname != "." else n
        if os.path.isdir(os.path.join(dirname, n)):
            full += "/"
        out.append(full)
    return out


def _readline_completer(text: str, state: int):
    """readline completer: only fires when the line starts with `!`."""
    line = readline.get_line_buffer()
    if not line.startswith("!"):
        return None
    cmd_line = line[1:]
    # First token = command name; later tokens = paths.
    if " " not in cmd_line.lstrip():
        matches = [c for c in _path_commands() if c.startswith(text)]
    else:
        matches = _complete_path(text)
    if state < len(matches):
        return matches[state]
    return None


if PROMPT_TOOLKIT:
    class _BangCompleter(Completer):
        """prompt_toolkit completer: only fires when the line starts with `!`.
        First token completes against $PATH binaries; later tokens against
        the filesystem."""
        def get_completions(self, document, complete_event):
            text = document.text_before_cursor
            if not text.startswith("!"):
                return
            cmd_line = text[1:]
            # Word being completed (everything after the last whitespace)
            tail = cmd_line.split()[-1] if cmd_line and not cmd_line.endswith(" ") else ""
            if " " not in cmd_line.lstrip():
                pool = [c for c in _path_commands() if c.startswith(tail)]
            else:
                pool = _complete_path(tail)
            for match in pool:
                yield Completion(match, start_position=-len(tail))


SYSTEM_PROMPT_SUFFIX = """
---
## Current System Context (snapshot at session start)
- OS: promptOS (Arch Linux based)
- Shell: promptsh
- User: {user} (uid {uid}, {priv})
- Home: {home}
- CWD: {cwd}
- Hostname: {hostname}
- Uptime: {uptime}
- Disk: {disk}
- Date/time at session start: {now} ({tz})

NOTE: The values above are a one-time snapshot. For anything that changes
during the session (current time, uptime, disk usage, network status, etc.),
run a command (`date`, `uptime`, `df -h`, `ip a`) instead of trusting the
snapshot. The user's CWD also changes when they run `cd`.
"""


def load_config():
    for path in ("/etc/promptos/config", "/etc/promptos/keys"):
        if os.path.exists(path):
            with open(path) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, _, v = line.partition("=")
                        k, v = k.strip(), v.strip()
                        if v and not os.environ.get(k):
                            os.environ[k] = v


def reload_config():
    """Reload promptOS runtime config so shell commands see config edits immediately."""
    for key in (
        "PROMPTOS_PROVIDER",
        "PROMPTOS_CLAUDE_MODEL",
        "PROMPTOS_OPENAI_MODEL",
        "PROMPTOS_GROQ_MODEL",
        "PROMPTOS_OLLAMA_MODEL",
        "PROMPTOS_CONVERSATION_MODEL",
        "PROMPTOS_EDIT_MODEL",
    ):
        os.environ.pop(key, None)
    load_config()


def get_system_prompt() -> str:
    import socket
    try:
        uptime = subprocess.check_output("uptime -p", shell=True, text=True).strip()
    except Exception:
        uptime = "unknown"
    try:
        disk = subprocess.check_output(
            "df -h / | awk 'NR==2{print $3\"/\"$2\" used (\"$5\")\"}'",
            shell=True, text=True).strip()
    except Exception:
        disk = "unknown"
    try:
        uid = os.geteuid()
    except Exception:
        uid = -1
    try:
        user = getpass.getuser()
    except Exception:
        user = os.environ.get("USER", "unknown")
    priv = "root/full system access" if uid == 0 else "regular user — sudo for elevated commands"
    home = os.path.expanduser("~")
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = "?"
    now = time.strftime("%Y-%m-%d %H:%M:%S")
    tz = time.strftime("%Z%z")
    agent = _load_agent_md()
    suffix = SYSTEM_PROMPT_SUFFIX.format(
        user=user,
        uid=uid,
        priv=priv,
        home=home,
        cwd=cwd,
        hostname=socket.gethostname(),
        uptime=uptime,
        disk=disk,
        now=now,
        tz=tz,
    )
    return agent + suffix


import re as _re

# Heredoc detection: matches the closing tag in `<<EOF`, `<<-EOF`, `<<'EOF'`,
# `<<"EOF"`. Captures the tag name so we know what line ends the body.
_HEREDOC_RE = _re.compile(r"<<-?\s*['\"]?(\w+)['\"]?")


def extract_commands(response: str) -> list[str]:
    r"""Extract executable commands from an AI response.
    Only commands explicitly marked with `CMD:` are run. Standalone code blocks
    are never executed — they're for the AI to show examples / sample output.

    Handles four formats the AI tends to emit:
      1. `CMD: ls -la`              — simple inline form (canonical)
      2. `CMD: \`ls -la\``           — wrapped in backticks
      3. `CMD: cat > f <<EOF`       — heredoc: collect body until the closing
                                      tag and pass the whole multi-line command
                                      to bash as one unit
      4. `CMD: \`\`\`bash`             — code-fence after CMD:, command(s) follow
                                      on subsequent lines until the closing fence
    """
    cmds: list[str] = []
    lines = response.splitlines()
    i = 0
    while i < len(lines):
        stripped = lines[i].strip()
        if not stripped.startswith("CMD:"):
            i += 1
            continue

        payload = stripped[4:].strip()

        # Form 1/2/3: inline command on the same line as CMD:.
        if payload and not payload.startswith("```"):
            cmd = payload.strip("`").strip()
            # Form 3: heredoc — collect body lines until closing tag.
            heredoc = _HEREDOC_RE.search(cmd)
            if heredoc:
                tag = heredoc.group(1)
                body: list[str] = []
                i += 1
                while i < len(lines) and lines[i].rstrip() != tag:
                    body.append(lines[i])
                    i += 1
                full = cmd + "\n" + "\n".join(body) + "\n" + tag + "\n"
                cmds.append(full)
                i += 1  # consume the closing tag
                continue
            if cmd:
                cmds.append(cmd)
            i += 1
            continue

        # Form 4: AI used a fenced code block. Skip past the opening fence
        # (which is either on the CMD: line itself or shortly after) and
        # collect non-empty, non-comment lines until the closing fence.
        i += 1
        if not payload.startswith("```"):
            while i < len(lines) and not lines[i].strip().startswith("```"):
                i += 1
            i += 1  # skip the opening ``` fence
        while i < len(lines):
            line = lines[i].strip()
            if line.startswith("```"):
                i += 1
                break
            if line and not line.startswith("#"):
                cmds.append(line)
            i += 1
    return cmds


def builtin_cd(cmd: str) -> tuple[bool, str]:
    """Handle the `cd` shell builtin in-process so the cwd actually changes.
    Returns (ok, message). Supports: `cd`, `cd ~`, `cd ~user`, `cd -`, `cd path`.
    Does NOT handle compound commands (cd foo && bar) — those still run via shell."""
    parts = cmd.strip().split(None, 1)
    target = parts[1].strip() if len(parts) > 1 else "~"
    if target == "-":
        target = os.environ.get("OLDPWD", os.getcwd())
        print(target)  # bash echoes the new dir for `cd -`
    target = os.path.expanduser(os.path.expandvars(target))
    try:
        prev = os.getcwd()
        os.chdir(target)
        os.environ["OLDPWD"] = prev
        os.environ["PWD"] = os.getcwd()
        return True, os.getcwd()
    except OSError as e:
        return False, f"cd: {e}"


def is_pure_cd(cmd: str) -> bool:
    """True if cmd is just `cd ...` with no compound shell operators."""
    s = cmd.strip()
    if not (s == "cd" or s.startswith("cd ")):
        return False
    # If there's any shell operator, fall back to subprocess (which won't persist
    # the cwd, but will at least run the rest of the command correctly).
    return not any(op in s for op in ("&&", "||", ";", "|", ">", "<", "&"))


_NO_SUCH_PATH_MARKERS = (
    "no such file or directory",
    "cannot access",
    "failed to open",
    "not found",
)
_GUI_APPS = {
    "xdg-open", "firefox", "chromium", "google-chrome", "brave-browser",
    "nautilus", "thunar", "pcmanfm", "dolphin", "gedit", "kate",
    "evince", "eog", "gimp", "vlc", "mpv", "code",
}


def _has_shell_operators(cmd: str) -> bool:
    return any(op in cmd for op in ("&&", "||", ";", "|", ">", "<", "$(", "`"))


def _command_tokens(cmd: str) -> list[str]:
    try:
        return shlex.split(cmd)
    except ValueError:
        return cmd.strip().split()


def _normalize_pacman_noninteractive(cmd: str) -> str:
    """Add --noconfirm to non-destructive pacman sync/install commands."""
    if _has_shell_operators(cmd):
        return cmd
    tokens = _command_tokens(cmd)
    if not tokens or os.path.basename(tokens[0]) != "pacman":
        return cmd
    args = tokens[1:]
    if any(arg.startswith("-R") for arg in args):
        return cmd
    if not any(arg.startswith("-S") for arg in args):
        return cmd
    if "--noconfirm" in args:
        return cmd
    tokens.insert(1, "--noconfirm")
    return shlex.join(tokens)


def _is_safe_noninteractive(cmd: str) -> bool:
    """Best-effort safety check for auto-running commands without prompt."""
    if _has_shell_operators(cmd):
        return False
    tokens = _command_tokens(cmd)
    if not tokens:
        return False
    name = os.path.basename(tokens[0])
    args = tokens[1:]

    read_only = {
        "ls", "cat", "pwd", "whoami", "id", "date", "uptime", "df", "du",
        "free", "ps", "pgrep", "grep", "find", "which", "whereis", "head",
        "tail", "uname", "env", "printenv", "journalctl", "ip", "ss",
        "ollama", "promptos-web",
    }
    if name in read_only:
        if name == "ollama" and args and args[0] not in ("list", "show", "ps"):
            return False
        if name == "promptos-web" and args and args[0] not in ("search", "fetch"):
            return False
        return True

    if name == "systemctl":
        return bool(args and args[0] in ("status", "is-active", "is-enabled", "list-units", "list-unit-files"))

    if name == "nmcli":
        dangerous = {"connect", "disconnect", "up", "down", "add", "delete", "modify"}
        return not any(a in dangerous for a in args)

    if name == "pacman":
        return any(a.startswith("-S") for a in args) and not any(a.startswith("-R") for a in args)

    return False


def _should_detach_gui(cmd: str) -> bool:
    """Detach known GUI launch commands so promptsh stays responsive."""
    if "&" in cmd or "nohup " in cmd or " disown" in cmd or _has_shell_operators(cmd):
        return False
    tokens = _command_tokens(cmd)
    if not tokens:
        return False
    return os.path.basename(tokens[0]) in _GUI_APPS


def _detach_gui_command(cmd: str) -> str:
    return f"nohup {cmd} >/tmp/promptsh-gui.log 2>&1 < /dev/null &"


def _extract_possible_paths(cmd: str) -> list[str]:
    out: list[str] = []
    for token in _command_tokens(cmd):
        if token.startswith("-"):
            continue
        expanded = os.path.expanduser(os.path.expandvars(token))
        if expanded.startswith(("/", "./", "../", "~")) or "/" in expanded:
            out.append(expanded)
    return out


def _suggest_path_matches(path: str, max_results: int = 5) -> list[str]:
    if os.path.exists(path):
        return []
    target = os.path.basename(path.rstrip("/"))
    if not target:
        return []

    cwd = os.getcwd()
    if os.path.isabs(path):
        search_root = "/"
    else:
        search_root = cwd

    results: list[str] = []
    root_depth = search_root.rstrip(os.sep).count(os.sep)
    pruned = {".git", ".cache", "node_modules", "proc", "sys", "dev", "run", "tmp"}

    for root, dirs, files in os.walk(search_root, topdown=True):
        # Keep search reasonably bounded on large trees.
        if root.rstrip(os.sep).count(os.sep) - root_depth > 6:
            dirs[:] = []
            continue
        dirs[:] = [d for d in dirs if d not in pruned]
        for name in dirs + files:
            lower = name.lower()
            needle = target.lower()
            if lower == needle or lower.startswith(needle) or needle in lower:
                candidate = os.path.join(root, name)
                display = candidate
                if candidate.startswith(cwd + "/"):
                    display = "./" + os.path.relpath(candidate, cwd)
                results.append(display)
                if len(results) >= max_results:
                    return results
    return results


def _missing_path_hint(cmd: str, output: str) -> str:
    lower = output.lower()
    if not any(marker in lower for marker in _NO_SUCH_PATH_MARKERS):
        return ""
    suggestions: list[str] = []
    for path in _extract_possible_paths(cmd):
        if os.path.exists(path):
            continue
        matches = _suggest_path_matches(path, max_results=3)
        for match in matches:
            if match not in suggestions:
                suggestions.append(match)
            if len(suggestions) >= 5:
                break
        if len(suggestions) >= 5:
            break
    if not suggestions:
        return ""
    lines = ["Likely path issue. Did you mean one of these?"]
    lines.extend(f"  - {m}" for m in suggestions)
    return "\n".join(lines)


def run_commands(cmds: list[str], autorun: bool = False, typeahead: "TypeAhead | None" = None) -> list[dict]:
    """Run commands, return results for injection into AI history.

    Two display modes:
      compact (default) — while a command runs, a single status line shows a
        spinner, elapsed time and the most recent output line. When it finishes,
        short output is printed in full; long output is collapsed to its first
        and last few lines with a count of what was hidden. `/out` shows the
        whole thing. This keeps the screen readable for people who don't want
        to parse 300 lines of pacman.
      verbose (/verbose on) — stream every line live, as a traditional shell
        would. Power-user mode.

    In both modes the full output is captured for the AI and for `/out`."""
    import re as _re2
    import select as _select
    import shutil as _shutil

    results = []
    for original_cmd in cmds:
        cmd = _normalize_pacman_noninteractive(original_cmd)
        notes: list[str] = []
        if cmd != original_cmd:
            notes.append("added --noconfirm for pacman")
        if _should_detach_gui(cmd):
            cmd = _detach_gui_command(cmd)
            notes.append("detached GUI app launch")

        # Header — yellow with a leading marker so it's obviously a command.
        if RICH:
            console.print(f"\n[bold yellow]▶[/bold yellow] [yellow]{rich_escape(cmd)}[/yellow]")
            if notes:
                console.print(f"[dim]{rich_escape('; '.join(notes))}[/dim]")
        else:
            print(f"\n\033[1;33m▶\033[0m \033[33m{cmd}\033[0m")
            if notes:
                print(f"\033[2m{'; '.join(notes)}\033[0m")

        if autorun:
            confirmed = True
        elif _is_safe_noninteractive(cmd):
            confirmed = True
            if RICH:
                console.print("[dim]Auto-run (safe command).[/dim]")
            else:
                print("\033[2mAuto-run (safe command).\033[0m")
        else:
            try:
                if RICH:
                    ans = console.input("[dim]Run this? \\[Enter = yes, n = skip][/dim] ")
                else:
                    ans = input("Run this? [Enter = yes, n = skip] ")
                confirmed = ans.strip().lower() in ("", "y", "yes")
            except EOFError:
                confirmed = False

        if not confirmed:
            if RICH:
                console.print("[dim]└─ skipped[/dim]")
            else:
                print("\033[2m└─ skipped\033[0m")
            results.append({"cmd": cmd, "exit_code": None, "output": ""})
            continue

        # Intercept `cd` so it actually changes the shell's cwd instead of
        # running in a child process that exits immediately.
        if is_pure_cd(cmd):
            ok, msg = builtin_cd(cmd)
            hint = _missing_path_hint(cmd, msg) if not ok else ""
            if hint:
                print(hint)
                msg = f"{msg}\n{hint}"
            if not ok:
                print(msg)
            _remember_output(cmd, 0 if ok else 1, msg)
            results.append({"cmd": cmd, "exit_code": 0 if ok else 1, "output": msg})
            continue

        # sudo would prompt inside the pipe, where the compact status line hides
        # it and the user only finds out when their keystrokes go to the wrong
        # place. Authenticate first, visibly, on the real TTY.
        if _needs_sudo_password(cmd):
            if not _preauth_sudo():
                print("\033[2m└─\033[0m \033[31msudo authentication failed — command not run\033[0m")
                _remember_output(cmd, 1, "sudo authentication failed")
                results.append({"cmd": cmd, "exit_code": 1,
                                "output": "sudo authentication failed (password not accepted); command not run"})
                continue

        proc = subprocess.Popen(
            cmd, shell=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            env=_child_env(),
        )
        assert proc.stdout is not None
        # Type-ahead: while the command runs, capture keystrokes (echo off) so the
        # status-line redraw can't erase them. Released if the command prompts.
        capturing = False
        if typeahead is not None and not VERBOSE_OUTPUT:
            typeahead.enabled = False
            typeahead.__enter__()
            capturing = typeahead.enabled
        fd = proc.stdout.fileno()

        LINE_PREFIX = "\033[2m┃\033[0m "
        PREFIX_VIS = 2  # visible width of "┃ "

        v_at_start = True   # verbose writer: are we at the start of a visual row?
        v_col = 0           # verbose writer: visible column within the row

        def _vwrite(text: str):
            """Verbose mode: write raw output as it arrives (partial lines
            included, so prompts show up), prefixing every visual row with ┃,
            wrapping at terminal width ourselves so continuation rows keep the
            prefix, and re-emitting it after \r so progress bars stay inside."""
            nonlocal v_at_start, v_col
            inner = _term_cols() - PREFIX_VIS
            out = []
            for piece in _re2.split(r"(\r\n|\n|\r)", text):
                if piece in ("\r\n", "\n"):
                    out.append("\n"); v_at_start = True; v_col = 0
                elif piece == "\r":
                    out.append("\r"); v_at_start = True; v_col = 0
                elif piece:
                    i = 0
                    while i < len(piece):
                        if v_at_start:
                            out.append(LINE_PREFIX); v_at_start = False; v_col = 0
                        room = inner - v_col
                        if room <= 0:
                            out.append("\n"); v_at_start = True; v_col = 0
                            continue
                        seg = piece[i:i + room]
                        out.append(seg); i += len(seg); v_col += len(seg)
            sys.stdout.write("".join(out))
            sys.stdout.flush()

        spinner = "|/-\\" if _BARE_TTY else "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
        started = time.monotonic()
        raw = bytearray()
        pending = b""        # bytes after the last \n or \r (an unfinished line)
        prompt_open = False  # compact mode: we've printed a waiting prompt on its own row
        last_line = ""       # most recent completed segment, for the status line
        tick = 0
        status_shown = False
        interrupted = False

        def _status():
            nonlocal tick, status_shown
            elapsed = _fmt_elapsed(time.monotonic() - started)
            cols = _term_cols()
            head = f"{spinner[tick % len(spinner)]} {elapsed}"
            # Prefer the unfinished line (what the program is saying right now)
            # over the last completed one.
            live = pending.decode("utf-8", "replace").strip() or last_line.strip()
            typed = ""
            if capturing:
                typed = "› " + typeahead.buffer[-max(10, cols - len(head) - 24):] + ("_" if _BARE_TTY else "▏")
            tail = _clip(live, max(10, cols - len(head) - len(typed) - 6))
            line = f"\033[2m{head}\033[0m  {tail}" if tail else f"\033[2m{head}\033[0m"
            if typed:
                line += f"  \033[1;36m{typed}\033[0m"
            sys.stdout.write("\r\033[2K" + line)
            sys.stdout.flush()
            tick += 1
            status_shown = True

        try:
            while True:
                ready, _, _ = _select.select([fd], [], [], 0.15)
                if ready:
                    data = os.read(fd, 65536)
                    if not data:
                        break
                    raw += data
                    pending += data
                    if prompt_open:
                        # The program moved on (user answered) — close the prompt row.
                        sys.stdout.write("\n")
                        sys.stdout.flush()
                        prompt_open = False
                    # Split on \n or \r; the final piece is still in progress.
                    segs = _re2.split(rb"\r\n|\n|\r", pending)
                    pending = segs.pop()
                    if segs:
                        last_line = segs[-1].decode("utf-8", "replace")
                    if VERBOSE_OUTPUT:
                        _vwrite(data.decode("utf-8", "replace"))
                    else:
                        ptxt = pending.decode("utf-8", "replace")
                        if _looks_like_prompt(ptxt):
                            # Something is waiting for input: put the prompt on
                            # its own row, bold, and park the cursor after it.
                            # Hand the terminal back so the answer goes to the command.
                            if capturing:
                                typeahead.__exit__(None, None, None)
                                capturing = False
                            if status_shown:
                                sys.stdout.write("\r\033[2K")
                                status_shown = False
                            sys.stdout.write(f"\033[2m┃\033[0m \033[1m{ptxt.strip()}\033[0m ")
                            sys.stdout.flush()
                            prompt_open = True
                if not VERBOSE_OUTPUT and not prompt_open:
                    _status()
        except KeyboardInterrupt:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
            interrupted = True
        proc.wait()
        if capturing:
            typeahead.__exit__(None, None, None)
            capturing = False
        if VERBOSE_OUTPUT and not v_at_start:
            sys.stdout.write("\n")
            sys.stdout.flush()
        if prompt_open:
            sys.stdout.write("\n")
            sys.stdout.flush()
        if status_shown:
            sys.stdout.write("\r\033[2K")
            sys.stdout.flush()
        if interrupted:
            print()

        # Normalise captured output: a \r-driven progress bar collapses to its
        # final state so the AI and /out see one line per update, not 400.
        output = raw.decode("utf-8", "replace")
        output = _re2.sub(r"[^\r\n]*\r(?!\n)", "", output).replace("\r\n", "\n")
        hint = _missing_path_hint(cmd, output)
        if hint:
            output = f"{output}\n{hint}"

        out_lines = output.rstrip("\n").split("\n") if output.strip() else []
        if not VERBOSE_OUTPUT:
            hidden = _print_compact_output(out_lines)
        else:
            hidden = 0
            if hint:
                for ln in hint.strip("\n").split("\n"):
                    _print_output_line(ln)

        # Trailer — └─ with green/red exit code, line count and duration so the
        # boundary before the next AI response is obvious at a glance.
        elapsed = _fmt_elapsed(time.monotonic() - started)
        meta = []
        if out_lines:
            meta.append(f"{len(out_lines)} line{'s' if len(out_lines) != 1 else ''}")
        meta.append(elapsed)
        if hidden:
            meta.append("/out shows everything")
        meta_str = "\033[2m · " + " · ".join(meta) + "\033[0m"
        if interrupted:
            print(f"\033[2m└─\033[0m \033[33mcancelled\033[0m{meta_str}")
        elif proc.returncode == 0:
            print(f"\033[2m└─\033[0m \033[32mexit 0\033[0m{meta_str}")
        else:
            print(f"\033[2m└─\033[0m \033[31mexit {proc.returncode}\033[0m{meta_str}")

        _remember_output(cmd, proc.returncode, output)
        results.append({
            "cmd": cmd,
            "exit_code": proc.returncode,
            "output": output[:20000],
        })
        # Re-raise so the agent loop bails out of the whole multi-step task
        # instead of marching on to the next command and re-querying the AI.
        if interrupted:
            raise KeyboardInterrupt
    return results


def _local_ip() -> str | None:
    """Best-effort: return the LAN IP used to reach the public internet, or None
    if offline. Doesn't actually send a packet — just resolves the source address
    of the route to 1.1.1.1."""
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(0.5)
    try:
        s.connect(("1.1.1.1", 80))
        return s.getsockname()[0]
    except OSError:
        return None
    finally:
        s.close()


def _provider_model(provider) -> str:
    return getattr(provider, "model", "") if provider else ""


def _looks_like_file_edit_request(text: str) -> bool:
    s = (text or "").lower()
    edit_terms = (
        "edit", "change", "modify", "update", "patch", "write", "create",
        "add", "implement", "fix", "refactor", "rename", "remove", "delete",
    )
    target_terms = (
        "file", "code", "repo", "script", "source", "config", "readme",
        "agent", "prompt", ".py", ".sh", ".md", ".json", ".toml", ".yaml",
        ".yml", ".css", ".html", ".js", ".ts", ".tsx", ".jsx",
    )
    if any(term in s for term in edit_terms) and any(term in s for term in target_terms):
        return True
    if any(term in s for term in ("apply_patch", "promptos-patch", "unified diff")):
        return True
    return False


def route_openai_model_for_turn(active_provider, user_input: str):
    if not active_provider or active_provider.name != "openai":
        return active_provider
    conversation_model = os.environ.get("PROMPTOS_CONVERSATION_MODEL", PROMPTOS_CONVERSATION_MODEL)
    edit_model = os.environ.get("PROMPTOS_EDIT_MODEL", PROMPTOS_EDIT_MODEL)
    target = edit_model if _looks_like_file_edit_request(user_input) else conversation_model
    if _provider_model(active_provider) == target:
        return active_provider
    os.environ["PROMPTOS_OPENAI_MODEL"] = target
    return get_provider("openai") or active_provider


def _write_model_config(path: str, key: str, value: str):
    lines = []
    found = False
    if os.path.exists(path):
        with open(path) as f:
            for raw in f:
                line = raw.rstrip("\n")
                stripped = line.strip()
                if stripped and not stripped.startswith("#") and "=" in stripped:
                    existing_key = stripped.split("=", 1)[0].strip()
                    if existing_key == key:
                        lines.append(f"{key}={value}")
                        found = True
                        continue
                lines.append(line)
    if not found:
        lines.append(f"{key}={value}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp_path = f"{path}.tmp"
    with open(tmp_path, "w") as f:
        f.write("\n".join(lines).rstrip() + "\n")
    os.chmod(tmp_path, 0o644)
    os.replace(tmp_path, path)


def persist_model_config(key: str, value: str) -> str:
    try:
        _write_model_config(PROMPTOS_CONFIG_PATH, key, value)
        return "(persisted to /etc/promptos/config)"
    except PermissionError:
        if os.geteuid() == 0:
            return "(not persisted: permission denied writing /etc/promptos/config)"
        script = r'''
import os
import sys

path, key, value = sys.argv[1:4]
lines = []
found = False
if os.path.exists(path):
    with open(path) as f:
        for raw in f:
            line = raw.rstrip("\n")
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and "=" in stripped:
                existing_key = stripped.split("=", 1)[0].strip()
                if existing_key == key:
                    lines.append(f"{key}={value}")
                    found = True
                    continue
            lines.append(line)
if not found:
    lines.append(f"{key}={value}")
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp_path = f"{path}.tmp"
with open(tmp_path, "w") as f:
    f.write("\n".join(lines).rstrip() + "\n")
os.chmod(tmp_path, 0o644)
os.replace(tmp_path, path)
'''
        result = subprocess.run(["sudo", sys.executable, "-c", script, PROMPTOS_CONFIG_PATH, key, value])
        if result.returncode == 0:
            return "(persisted to /etc/promptos/config with sudo)"
        return f"(not persisted: sudo exited {result.returncode})"
    except Exception as e:
        return f"(not persisted: {e})"


def print_llm_model_help():
    text = (
        "Usage:\n"
        "  /llm-model show\n"
        "  /llm-model list [provider]\n"
        "  /llm-model set <provider> <model>\n"
        "  /llm-model set <model>"
    )
    if RICH:
        console.print(Panel(text, title="LLM Model", border_style="cyan", box=box.ROUNDED))
    else:
        print(text + "\n")


def show_current_models(active_provider):
    reload_config()
    lines = ["Current provider models:"]
    for provider, env_key in MODEL_ENV_BY_PROVIDER.items():
        value = os.environ.get(env_key, "(default)")
        active = " (active)" if active_provider and active_provider.name == provider else ""
        lines.append(f"  {provider}: {value}{active}")
    text = "\n".join(lines)
    if RICH:
        console.print(Panel(text, title="LLM Model", border_style="cyan", box=box.ROUNDED))
    else:
        print(text + "\n")


def handle_llm_model_command(cmd: str, active_provider):
    parts = cmd.split()
    if len(parts) == 1 or (len(parts) == 2 and parts[1] == "show"):
        show_current_models(active_provider)
        return active_provider
    if len(parts) >= 2 and parts[1] == "list":
        show_current_models(active_provider)
        return active_provider
    if len(parts) < 3 or parts[1] != "set":
        print_llm_model_help()
        return active_provider

    if len(parts) == 3:
        if not active_provider:
            print("No active provider to set model for.\n")
            return active_provider
        provider_name = active_provider.name
        model = parts[2]
    else:
        provider_name = parts[2].lower()
        model = " ".join(parts[3:]).strip()

    if provider_name not in MODEL_ENV_BY_PROVIDER:
        print("Unknown provider. Use one of: claude, openai, groq, ollama.\n")
        return active_provider
    if not model:
        print("Model cannot be empty.\n")
        return active_provider

    env_key = MODEL_ENV_BY_PROVIDER[provider_name]
    os.environ[env_key] = model
    persist_msg = persist_model_config(env_key, model)
    reload_config()

    if active_provider and active_provider.name == provider_name:
        active_provider = get_provider(provider_name)
    active = active_provider.name if active_provider else "none"
    if active == provider_name:
        print(f"Set {provider_name} model to {model}. {persist_msg}\n")
    else:
        print(
            f"Set {provider_name} model to {model}. Active provider is still {active}; "
            f"switch to {provider_name} to use it. {persist_msg}\n"
        )
    return active_provider


def print_banner(provider):
    provider_name = provider.name if provider else None
    model = _provider_model(provider)
    try:
        logo = subprocess.check_output(
            ["figlet", "-f", "standard", "promptOS"], text=True, stderr=subprocess.DEVNULL
        )
    except Exception:
        logo = "promptOS"
    if not logo.endswith("\n"):
        logo += "\n"

    ip = _local_ip()

    if RICH:
        color = PROVIDER_COLORS.get(provider_name, "bold white") if provider_name else "bold white"
        provider_str = f"[{color}]{provider_name}[/{color}]" if provider_name else "[yellow]no provider[/yellow]"
        model_str = f" [dim]· {model}[/dim]" if model else ""
        net_str = f"[dim]ip[/dim] [bold green]{ip}[/bold green]" if ip else "[yellow]offline — try /wifi[/yellow]"
        console.print(f"[bold cyan]{logo}[/bold cyan]", end="")
        console.print(Panel(
            "[bold]Tell me what you want to do, in plain English.[/bold]\n"
            "[dim]For example:[/dim]  [cyan]connect to my wifi[/cyan]   [cyan]free up disk space[/cyan]   [cyan]install firefox[/cyan]\n"
            "[dim]I'll suggest the commands and ask before running anything that changes your system.[/dim]\n\n"
            f"{provider_str}{model_str}  •  {net_str}\n"
            f"[dim]/help  all commands  •  !cmd  run bash yourself  •  exit  quit[/dim]",
            border_style="dim",
            box=box.ROUNDED,
        ))
    else:
        print(f"\033[1;36m{logo}\033[0m")
        status = f"\033[1;32m{provider_name}\033[0m" if provider_name else "\033[33mno provider\033[0m"
        model_str = f" - {model}" if model else ""
        net = f"ip \033[1;32m{ip}\033[0m" if ip else "\033[33moffline - try /wifi\033[0m"
        print("  Tell me what you want to do, in plain English.")
        print("  For example:  connect to my wifi  |  free up disk space  |  install firefox")
        print("  I'll suggest the commands and ask before running anything that changes your system.\n")
        print(f"  {status}{model_str}  |  {net}")
        print("  /help  all commands  |  !cmd  run bash yourself  |  exit  quit\n")


