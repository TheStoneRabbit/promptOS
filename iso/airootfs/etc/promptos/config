# promptOS configuration
# Lines starting with # are comments.
# Values here are overridden by environment variables of the same name.

# Default AI provider: auto | claude | openai | groq | ollama
# "auto" picks the best available: claude > openai > groq > ollama
PROMPTOS_PROVIDER=ollama

# Ollama model to use when provider=ollama
PROMPTOS_OLLAMA_MODEL=mistral:7b-instruct

# Ollama server URL — change to http://10.0.2.2:11434 to use Ollama running on the host Mac
PROMPTOS_OLLAMA_BASE_URL=http://localhost:11434

# Claude model (provider=claude)
PROMPTOS_CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI model (provider=openai)
PROMPTOS_OPENAI_MODEL=gpt-5-mini

# OpenAI automatic model routing
# Normal conversation/planning uses the GPT-4 class conversation model.
# File editing, patches, and code changes use the edit model.
PROMPTOS_CONVERSATION_MODEL=gpt-4.1
PROMPTOS_EDIT_MODEL=gpt-5-mini

# Groq model (provider=groq) — free tier available at https://console.groq.com
PROMPTOS_GROQ_MODEL=llama-3.1-8b-instant

# API keys — leave blank and set via `promptos-keys set <provider> <key>` instead
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
