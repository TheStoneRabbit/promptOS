# promptOS configuration
# Lines starting with # are comments.
# Values here are overridden by environment variables of the same name.

# Default AI provider: auto | claude | openai | ollama
PROMPTOS_PROVIDER=ollama

# Ollama model to use when provider=ollama
PROMPTOS_OLLAMA_MODEL=llama3.2:1b

# Ollama server URL — change to http://10.0.2.2:11434 to use Ollama running on the host Mac
PROMPTOS_OLLAMA_BASE_URL=http://localhost:11434

# Claude model (provider=claude)
PROMPTOS_CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI model (provider=openai) — covers Codex functionality
PROMPTOS_OPENAI_MODEL=gpt-4o

# API keys — leave blank and set via `promptos-keys set <provider> <key>` instead
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
