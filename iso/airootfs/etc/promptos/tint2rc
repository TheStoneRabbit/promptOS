# promptOS tint2 panel — minimal dark bottom bar (taskbar, systray, clock).

#-------------------------------------
# Panel
panel_items = TSC
panel_size = 100% 38
panel_margin = 0 0
panel_padding = 6 0 6
panel_position = bottom center horizontal
panel_background_id = 1
panel_layer = bottom
wm_menu = 1
font_shadow = 0

# Background 1: the panel itself
rounded = 0
border_width = 0
background_color = #0b0b12 100
border_color = #0b0b12 100

# Background 2: active task
rounded = 6
border_width = 0
background_color = #2a2f45 100
border_color = #2a2f45 100

# Background 3: normal/hover task
rounded = 6
border_width = 0
background_color = #171a28 100
border_color = #171a28 100

#-------------------------------------
# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 4 2 6
taskbar_background_id = 0

# Tasks
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 220 24
task_padding = 8 3 8
task_font = DejaVu Sans 10
task_font_color = #c7ccda 100
task_active_background_id = 2
task_normal_background_id = 3
task_active_font_color = #ffffff 100

#-------------------------------------
# System tray
systray_padding = 4 2 4
systray_icon_size = 18

#-------------------------------------
# Clock
time1_format = %H:%M
time2_format = %a %d %b
time1_font = DejaVu Sans Bold 11
time2_font = DejaVu Sans 8
clock_font_color = #c7ccda 100
clock_padding = 8 0
clock_background_id = 0
