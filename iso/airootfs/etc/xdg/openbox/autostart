# promptOS openbox autostart.
# Runs once when the X session starts.

# Launch detached (setsid) so these survive when openbox's autostart script
# exits — otherwise the backgrounded jobs get SIGHUP and die (this was killing
# the panel).

# Compositor: real rounded corners + soft shadow for the overlay (xrender
# backend so it works under emulation). Start first so windows are composited.
setsid picom --config /etc/promptos/picom.conf >/dev/null 2>&1 < /dev/null &

# Branded desktop background (falls back to a solid color if cairo/feh missing).
setsid promptos-wallpaper >/dev/null 2>&1 < /dev/null &

# Dock (macOS-style): shows running apps; click an icon to restore/raise its
# window, including minimized ones. Replaces tint2, which crashed on some
# hardware. Needs the compositor (picom, started above) for transparency.
setsid sh -c 'sleep 1; exec plank' >/dev/null 2>&1 < /dev/null &

# NetworkManager agent: provides the graphical password dialogs when joining a
# network. (Plank is a dock, not a system tray, so there's no tray icon — use
# nm-connection-editor for the WiFi UI; the agent opens it on request.)
setsid sh -c 'sleep 2; exec nm-applet' >/dev/null 2>&1 < /dev/null &

# Launch the promptOS search-bar overlay. It registers as the single primary
# GtkApplication instance, so the Ctrl+Space hotkey (see rc.xml) re-summons it
# via `promptos-gui --overlay --toggle` instead of spawning new windows.
setsid promptos-gui --overlay >/dev/null 2>&1 < /dev/null &
